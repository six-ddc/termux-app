<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/termuxplus_control_pressed" />
            <stroke android:width="1dp" android:color="@color/termuxplus_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/termuxplus_control" />
            <stroke android:width="1dp" android:color="@color/termuxplus_outline_subtle" />
        </shape>
    </item>
</selector>
