<?xml version="1.0" encoding="utf-8"?>
<!-- HUD dialog window background: flat dark sheet with a hairline border and
     low corner radius — matches the bottom sheets / cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/termuxplus_sheet_bg" />
    <corners android:radius="@dimen/termuxplus_sheet_radius" />
    <stroke android:width="1dp" android:color="@color/termuxplus_sheet_border" />
</shape>
