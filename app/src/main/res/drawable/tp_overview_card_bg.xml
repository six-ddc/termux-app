<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/termuxplus_card_radius" />
            <solid android:color="@color/termuxplus_card_bg" />
            <stroke android:width="1.5dp" android:color="@color/termuxplus_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/termuxplus_card_radius" />
            <solid android:color="@color/termuxplus_card_bg_pressed" />
            <stroke android:width="1dp" android:color="@color/termuxplus_card_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/termuxplus_card_radius" />
            <solid android:color="@color/termuxplus_card_bg" />
            <stroke android:width="1dp" android:color="@color/termuxplus_card_border" />
        </shape>
    </item>
</selector>
