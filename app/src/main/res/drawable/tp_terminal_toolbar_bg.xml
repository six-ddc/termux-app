<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Keys toolbar: frosted near-black with a faint phosphor-green hairline
     along the top edge, matching the header bar's HUD chrome. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/termuxplus_glass_bg" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/termuxplus_hairline_accent" />
        </shape>
    </item>
</layer-list>
