<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- HEADER: logo + title + Armed switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/app_name"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/status_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_gray_light"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    tools:text="Ready for local Termux control" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/armed_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textOff=""
                android:textOn=""
                android:thumbTint="@color/autotermux_primary_light"
                android:trackTint="@color/background_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/armed_state_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/autotermux_primary_light"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            tools:text="ARMED" />

        <!-- PERMISSIONS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/autotermux_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AutoTermux_SectionTitle"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Permissions" />

                <TextView
                    android:id="@+id/permissions_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_gray_light"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    tools:text="6/8 granted" />
            </LinearLayout>

            <!-- Row: Accessibility -->
            <include
                android:id="@+id/perm_accessibility"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Row: Overlay -->
            <include
                android:id="@+id/perm_overlay"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Row: Notification listener -->
            <include
                android:id="@+id/perm_notif_listener"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Row: All files (MANAGE_EXTERNAL_STORAGE) -->
            <include
                android:id="@+id/perm_storage"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Row: Keyboard IME enable -->
            <include
                android:id="@+id/perm_keyboard_enable"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Row: Keyboard IME select -->
            <include
                android:id="@+id/perm_keyboard_select"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Row: Runtime perms aggregate (SMS / contacts / camera / etc) -->
            <include
                android:id="@+id/perm_runtime"
                layout="@layout/autotermux_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- BRIDGE info — the only transport tp-android actually uses. -->
        <LinearLayout
            android:id="@+id/bridge_status_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/autotermux_panel_bg"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/bridge_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/bridge_status_label"
                android:src="@drawable/ic_autotermux_bridge_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Bridge"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/bridge_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/text_gray_light"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACTIVITY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/autotermux_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AutoTermux_SectionTitle"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Activity" />

                <TextView
                    android:id="@+id/activity_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_gray_light"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />

                <Button
                    android:id="@+id/activity_clear"
                    style="@style/AutoTermux_Button_Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Clear"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activity_log_list"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/autotermux_code_bg"
                android:padding="6dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/activity_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="No activity yet"
                android:textColor="@color/text_gray_light"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
