<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_gray_light"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/autotermux_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/AutoTermux_SectionTitle"
                android:text="Runtime" />

            <LinearLayout
                android:id="@+id/armed_status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/autotermux_permission_ready_bg"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/armed_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Control status"
                    android:src="@drawable/ic_autotermux_accessibility_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AutoTermux_StatusRow"
                        android:layout_marginTop="0dp"
                        android:text="Control" />

                    <TextView
                        android:id="@+id/armed_status"
                        style="@style/AutoTermux_StatusValue"
                        android:maxLines="1" />
                </LinearLayout>

                <Button
                    android:id="@+id/armed_action"
                    style="@style/AutoTermux_Button_Secondary"
                    android:layout_width="94dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/accessibility_status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/autotermux_permission_required_bg"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/accessibility_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/accessibility_status_label"
                    android:src="@drawable/ic_autotermux_accessibility_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AutoTermux_StatusRow"
                        android:layout_marginTop="0dp"
                        android:text="Accessibility" />

                    <TextView
                        android:id="@+id/accessibility_status"
                        style="@style/AutoTermux_StatusValue"
                        android:maxLines="2" />
                </LinearLayout>

                <Button
                    android:id="@+id/open_accessibility_settings"
                    style="@style/AutoTermux_Button_Secondary"
                    android:layout_width="94dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Grant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keyboard_status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/autotermux_status_row_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/keyboard_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/keyboard_status_label"
                    android:src="@drawable/ic_autotermux_keyboard_24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AutoTermux_StatusRow"
                        android:layout_marginTop="0dp"
                        android:text="Keyboard" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Input method"
                                android:textColor="@color/text_gray_light"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/keyboard_enable_status"
                                style="@style/AutoTermux_StatusValue" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/keyboard_enable_action"
                            style="@style/AutoTermux_Button_Secondary"
                            android:layout_width="88dp"
                            android:layout_height="38dp"
                            android:minWidth="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Current keyboard"
                                android:textColor="@color/text_gray_light"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/keyboard_select_status"
                                style="@style/AutoTermux_StatusValue" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/keyboard_select_action"
                            style="@style/AutoTermux_Button_Secondary"
                            android:layout_width="88dp"
                            android:layout_height="38dp"
                            android:minWidth="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/local_api_status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/autotermux_status_row_bg"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/local_api_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/local_api_status_label"
                    android:src="@drawable/ic_autotermux_server_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AutoTermux_StatusRow"
                        android:layout_marginTop="0dp"
                        android:text="HTTP API" />

                    <TextView
                        android:id="@+id/http_status"
                        style="@style/AutoTermux_StatusValue"
                        android:fontFamily="monospace"
                        android:maxLines="2" />
                </LinearLayout>

                <Button
                    android:id="@+id/toggle_http_server"
                    style="@style/AutoTermux_Button_Primary"
                    android:layout_width="94dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bridge_status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/autotermux_status_row_bg"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/bridge_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/bridge_status_label"
                    android:src="@drawable/ic_autotermux_bridge_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AutoTermux_StatusRow"
                        android:layout_marginTop="0dp"
                        android:text="Bridge" />

                    <TextView
                        android:id="@+id/bridge_status"
                        style="@style/AutoTermux_StatusValue"
                        android:fontFamily="monospace"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/autotermux_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AutoTermux_SectionTitle"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Activity" />

                <TextView
                    android:id="@+id/activity_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/text_gray_light"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/activity_clear"
                    style="@style/AutoTermux_Button_Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Clear"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activity_log_list"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/autotermux_code_bg"
                android:padding="6dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/activity_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="No activity yet"
                android:textColor="@color/text_gray_light"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
