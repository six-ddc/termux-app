<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/autotermux_status_row_bg"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_autotermux_accessibility_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            tools:text="Accessibility" />

        <TextView
            android:id="@+id/row_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray_light"
            android:textSize="11sp"
            tools:text="Ready" />
    </LinearLayout>

    <Button
        android:id="@+id/row_action"
        style="@style/AutoTermux_Button_Secondary"
        android:layout_width="84dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textSize="12sp"
        tools:text="Grant" />
</LinearLayout>
