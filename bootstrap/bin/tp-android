def normalize_termux_api_argv(argv: list[str] | None) -> list[str] | None:
    if argv is None:
        argv = sys.argv[1:]
    normalized = list(argv)
    try:
        termux_api_index = next(i for i, value in enumerate(normalized) if value in ("termux-api", "ta"))
    except StopIteration:
        return normalized
    command_index = termux_api_index + 1
    if command_index >= len(normalized):
        return normalized
    command = normalized[command_index]
    if command in TERMUX_API_COMMANDS and (command_index + 1 >= len(normalized) or normalized[command_index + 1] != "--"):
        normalized.insert(command_index + 1, "--")
    return normalized


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    argv = normalize_termux_api_argv(argv)
    args = parser.parse_args(argv)
    configure_runtime(args)
    if not hasattr(args, "output_format"):
        args.output_format = "json"
    if not hasattr(args, "timeout"):
        args.timeout = 10.0
    try:
        return args.func(args)
    except CliError as exc:
        emit_error(str(exc), args)
        return 1
    except KeyboardInterrupt:
        emit_error("interrupted", args, code="INTERRUPTED")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
