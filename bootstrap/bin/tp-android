class CliError(Exception):
    """Structured CLI error.

    `code` is a stable identifier from ERROR_CODES; agents/scripts branch on it.
    `hint` overrides the default hint registered for that code (optional).
    `recoverable` overrides the default recoverable flag (optional).
    `details` carries arbitrary structured context (e.g. selector that failed).
    """

    def __init__(
        self,
        message: str,
        *,
        code: str = "CLI_ERROR",
        hint: str | None = None,
        recoverable: bool | None = None,
        details: dict[str, Any] | None = None,
    ) -> None:
        super().__init__(message)
        self.code = code
        self.hint = hint
        self.recoverable = recoverable
        self.details = details


def load_config() -> dict[str, Any]:
    if not CONFIG_PATH.exists():
        return {}
    try:
        config = json.loads(CONFIG_PATH.read_text())
    except Exception as exc:
        raise CliError(f"Invalid config file {CONFIG_PATH}: {exc}") from exc
    if config.get("authority") == "com.termux.automation":
        config["authority"] = DEFAULT_AUTHORITY
    return config


def save_config(config: dict[str, Any]) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    try:
        CONFIG_PATH.chmod(0o600)
    except OSError:
        pass


def config_base_url(config: dict[str, Any]) -> str:
    return (
        config.get("_base_url_override")
        or os.environ.get("AUTOTERMUX_BASE_URL")
        or os.environ.get("TP_ANDROID_BASE_URL")
        or os.environ.get("TERMUXPLUS_ANDROID_BASE_URL")
        or config.get("base_url")
        or DEFAULT_BASE_URL
    ).rstrip("/")


def config_authority(config: dict[str, Any]) -> str:
    return (
        config.get("_authority_override")
        or os.environ.get("AUTOTERMUX_AUTHORITY")
        or os.environ.get("TP_ANDROID_AUTHORITY")
        or os.environ.get("TERMUXPLUS_ANDROID_AUTHORITY")
        or config.get("authority")
        or DEFAULT_AUTHORITY
    )


def config_android_user(config: dict[str, Any]) -> str:
    return str(
        config.get("_user_override")
        or os.environ.get("AUTOTERMUX_USER")
        or os.environ.get("TP_ANDROID_USER")
        or os.environ.get("TERMUXPLUS_ANDROID_USER")
        or config.get("user")
        or "0"
    )


def config_transport(config: dict[str, Any]) -> str:
    transport = (
        config.get("_transport_override")
        or os.environ.get("AUTOTERMUX_TRANSPORT")
        or os.environ.get("TP_ANDROID_TRANSPORT")
        or os.environ.get("TERMUXPLUS_ANDROID_TRANSPORT")
        or config.get("transport")
        or "bridge"
    )
    transport = str(transport).strip().lower()
    if transport == "http":
        # HTTP is no longer a supported CLI transport; the AutoTermux app keeps
        # the server internally but tp-android always uses bridge to keep things
        # consistent. Silently fall back instead of breaking stale configs.
        transport = "bridge"
    if transport not in {"bridge", "provider"}:
        raise CliError("transport must be 'bridge' or 'provider'")
    return transport


def configured_token(config: dict[str, Any]) -> str | None:
    return (
        config.get("_token_override")
        or os.environ.get("AUTOTERMUX_TOKEN")
        or os.environ.get("TP_ANDROID_TOKEN")
        or os.environ.get("TERMUXPLUS_ANDROID_TOKEN")
        or config.get("token")
    )


def run_system_content(args: list[str]) -> str:
    content_bin = "/system/bin/content"
    if not os.path.exists(content_bin):
        raise CliError("/system/bin/content not found; install and start AutoTermux manually")
    try:
        completed = subprocess.run(
            [content_bin, *args],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as exc:
        raise CliError(f"Could not execute {content_bin}: {exc}") from exc
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        raise CliError(detail or f"content command failed with exit {completed.returncode}")
    return completed.stdout.strip()


def run_system_am(args: list[str]) -> str:
    am_bin = "/system/bin/am"
    if not os.path.exists(am_bin):
        raise CliError("/system/bin/am not found; install and start AutoTermux manually")
    try:
        completed = subprocess.run(
            [am_bin, *args],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as exc:
        raise CliError(f"Could not execute {am_bin}: {exc}") from exc
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        raise CliError(detail or f"am command failed with exit {completed.returncode}")
    return completed.stdout.strip()


def termux_apk_path() -> str | None:
    configured = os.environ.get("TERMUX_APP__APK_PATH")
    if configured and os.path.exists(configured):
        return configured

    pm_bin = "/system/bin/pm"
    if not os.path.exists(pm_bin):
        return None
    completed = subprocess.run(
        [pm_bin, "path", "com.termux"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if completed.returncode != 0:
        return None
    for line in completed.stdout.splitlines():
        line = line.strip()
        if line.startswith("package:"):
            path = line.removeprefix("package:")
            if os.path.exists(path):
                return path
    return None


def embedded_autotermux_asset_available() -> bool:
    apk_path = termux_apk_path()
    if not apk_path:
        return False
    try:
        with zipfile.ZipFile(apk_path) as apk_zip:
            return AUTOTERMUX_ASSET_PATH in apk_zip.namelist()
    except (OSError, zipfile.BadZipFile):
        return False


def bridge_component(config: dict[str, Any]) -> str:
    return f"{config_authority(config)}/{BRIDGE_RECEIVER_CLASS}"


def parse_bridge_broadcast(output: str) -> Any:
    match = re.search(r'data="([^"]+)"', output) or re.search(r"data=([^\s,]+)", output)
    if not match:
        # `result=0` with no `data=` payload typically means the receiver was
        # killed (OEM battery manager) before it could reply.
        if "result=0" in output:
            raise CliError(
                f"Bridge broadcast returned result=0 with no data; AutoTermux was likely killed: {output}",
                code="OEM_BATTERY_KILL",
            )
        raise CliError(
            f"Could not parse bridge broadcast output: {output}",
            code="BRIDGE_PARSE_FAILED",
        )
    encoded = match.group(1)
    padded = encoded + "=" * ((4 - len(encoded) % 4) % 4)
    try:
        raw = base64.urlsafe_b64decode(padded.encode()).decode()
        parsed = json.loads(raw)
    except Exception as exc:
        raise CliError(f"Invalid bridge response: {exc}", code="BRIDGE_PARSE_FAILED") from exc
    if isinstance(parsed, dict) and parsed.get("status") == "error":
        err_message = parsed.get("error") or parsed.get("message") or "Bridge command failed"
        # Promote a few well-known server-side error strings to typed codes
        # so agents can branch on them without parsing English.
        err_code = "BRIDGE_RETURNED_ERROR"
        lowered = str(err_message).lower()
        if "accessibility" in lowered and ("not" in lowered or "unavail" in lowered or "disable" in lowered):
            err_code = "A11Y_DISABLED"
        elif "permission" in lowered and "denied" in lowered:
            err_code = "PERMISSION_MISSING"
        elif "binder" in lowered or "transaction" in lowered and "large" in lowered:
            err_code = "BINDER_OVERFLOW"
        elif "consent" in lowered and ("denied" in lowered or "cancel" in lowered):
            err_code = "SCREENSHOT_CONSENT_DENIED"
        raise CliError(err_message, code=err_code, details=parsed if isinstance(parsed, dict) else None)
    if isinstance(parsed, dict) and "result" in parsed:
        return parsed["result"]
    return parsed


def bridge_broadcast(config: dict[str, Any], action: str, extras: list[str] | None = None) -> Any:
    output = run_system_am(
        [
            "broadcast",
            "--user",
            config_android_user(config),
            "--receiver-foreground",
            "-a",
            f"{BRIDGE_ACTION_PREFIX}.{action}",
            "-n",
            bridge_component(config),
            *(extras or []),
        ]
    )
    return parse_bridge_broadcast(output)


def parse_provider_json(output: str) -> Any:
    for line in output.splitlines():
        line = line.strip()
        if "result=" in line:
            candidate = line.split("result=", 1)[1]
        else:
            candidate = line
        if not candidate:
            continue
        try:
            parsed = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(parsed, dict) and parsed.get("status") == "success":
            result = parsed.get("result")
            if isinstance(result, str):
                try:
                    return json.loads(result)
                except json.JSONDecodeError:
                    return result
            return result
        if isinstance(parsed, dict) and parsed.get("status") == "error":
            raise CliError(parsed.get("error") or parsed.get("message") or "ContentProvider returned error")
        return parsed
    raise CliError(f"Could not parse ContentProvider output: {output}")


def active_output_format(args: argparse.Namespace | None) -> str:
    if args is None:
        return "json"
    return getattr(args, "output_format", "json")


def configure_runtime(args: argparse.Namespace) -> None:
    global CONFIG_PATH
    config_path = getattr(args, "config", None)
    if config_path:
        CONFIG_PATH = Path(config_path).expanduser()


def load_runtime_config(args: argparse.Namespace) -> dict[str, Any]:
    config = load_config()
    overrides = {
        "_base_url_override": getattr(args, "base_url", None),
        "_authority_override": getattr(args, "authority", None),
        "_user_override": getattr(args, "user", None),
        "_token_override": getattr(args, "token", None),
        "_transport_override": getattr(args, "transport", None),
    }
    for key, value in overrides.items():
        if value not in (None, ""):
            config[key] = value.rstrip("/") if key == "_base_url_override" else value
    return config


def provider_query(authority: str, path: str) -> Any:
    output = run_system_content(["query", "--uri", f"content://{authority}/{path}"])
    return parse_provider_json(output)


def parse_provider_result_uri(output: str) -> dict[str, Any]:
    match = re.search(r"content://\S+", output)
    if not match:
        return {"status": "unknown", "raw": output}
    raw_uri = match.group(0).rstrip(".,;")
    parsed_uri = urllib.parse.urlparse(raw_uri)
    query = urllib.parse.parse_qs(parsed_uri.query)
    status = query.get("status", ["unknown"])[0]
    message = query.get("message", [""])[0]
    result = {"status": status}
    if message:
        result["message"] = message
        try:
            parsed_message = json.loads(message)
        except json.JSONDecodeError:
            parsed_message = None
        if isinstance(parsed_message, dict):
            if parsed_message.get("status") == "error":
                raise CliError(parsed_message.get("error") or parsed_message.get("message") or message)
            result["response"] = parsed_message
            if "result" in parsed_message:
                result["result"] = parsed_message["result"]
    if status == "error":
        raise CliError(message or output)
    return result


def provider_insert(authority: str, path: str, binds: list[str]) -> dict[str, Any]:
    output = run_system_content(["insert", "--uri", f"content://{authority}/{path}", *binds])
    return parse_provider_result_uri(output)


def content_bind_args(payload: dict[str, Any]) -> list[str]:
    binds: list[str] = []
    for key, value in payload.items():
        if value is None:
            continue
        if isinstance(value, bool):
            value_type = "b"
            encoded = "true" if value else "false"
        elif isinstance(value, int) and not isinstance(value, bool):
            value_type = "i"
            encoded = str(value)
        elif isinstance(value, float):
            value_type = "f"
            encoded = str(value)
        elif isinstance(value, (dict, list)):
            value_type = "s"
            encoded = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        else:
            value_type = "s"
            encoded = str(value)
        binds.extend(["--bind", f"{key}:{value_type}:{encoded}"])
    return binds


def provider_action(config: dict[str, Any], action: str, payload: dict[str, Any] | None = None) -> Any:
    response = provider_insert(
        config_authority(config),
        "action/" + action.lstrip("/"),
        content_bind_args(payload or {}),
    )
    return response.get("result", response)


def bridge_call(config: dict[str, Any], method: str, payload: dict[str, Any] | None = None) -> Any:
    return bridge_broadcast(
        config,
        "CALL",
        [
            "--es",
            "method",
            method.lstrip("/"),
            "--es",
            "params_json",
            json.dumps(payload or {}, ensure_ascii=False, separators=(",", ":")),
        ],
    )


def copy_stream(input_stream: Any, output_stream: Any) -> int:
    total = 0
    while True:
        chunk = input_stream.read(1024 * 1024)
        if not chunk:
            return total
        output_stream.write(chunk)
        total += len(chunk)


def copy_transfer_cache_to_output(cache_path: str, output_path: str, args: argparse.Namespace | None = None) -> int:
    """
    Copy AutoTermux's transfer-cache file out to the user's chosen output path.

    Termux's real app context (`untrusted_app`) has MANAGE_EXTERNAL_STORAGE and
    can read `/sdcard/Download/.termuxplus/tp-android-cache/*` directly. The
    only contexts where this fails are `adb shell run-as` (which on some OEMs
    like vivo gets a stricter `runas_app` SELinux context) — but tp-android is
    intended to be run from inside Termux, not via run-as for production use.

    The `args` parameter is accepted for forward-compat with future fallbacks
    but the direct read covers all real Termux invocations.
    """
    del args  # currently unused; reserved for chunked/bridge fallbacks
    source = Path(cache_path)
    try:
        if output_path == "-":
            with source.open("rb") as input_stream:
                return copy_stream(input_stream, sys.stdout.buffer)
        output = Path(output_path)
        output.parent.mkdir(parents=True, exist_ok=True)
        with source.open("rb") as input_stream, output.open("wb") as output_stream:
            return copy_stream(input_stream, output_stream)
    except PermissionError as exc:
        raise CliError(
            f"Transfer cache file not readable: {cache_path}.\n"
            "  This usually means you are running tp-android via `adb shell run-as`,\n"
            "  which has a stricter SELinux context (runas_app) than a real Termux\n"
            "  session (untrusted_app). Run tp-android from inside the Termux app\n"
            f"  (terminal session). Original error: {exc}"
        ) from exc


def create_transfer_cache_path(input_path: str | None = None) -> Path:
    suffix = ".bin"
    if input_path and input_path != "-":
        candidate = Path(input_path).suffix
        if candidate and re.fullmatch(r"\.[A-Za-z0-9_-]{1,16}", candidate):
            suffix = candidate
    try:
        TRANSFER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise CliError(
            f"Cannot create transfer cache directory {TRANSFER_CACHE_DIR}: {exc}. "
            "Run termux-setup-storage and ensure shared storage is writable."
        ) from exc
    return TRANSFER_CACHE_DIR / f"tp-{int(time.time() * 1000)}-{uuid.uuid4()}{suffix}"


def stage_input_file_for_bridge(input_path: str) -> tuple[str, int]:
    cache_path = create_transfer_cache_path(input_path)
    try:
        if input_path == "-":
            with cache_path.open("wb") as output_stream:
                bytes_written = copy_stream(sys.stdin.buffer, output_stream)
        else:
            with Path(input_path).open("rb") as input_stream, cache_path.open("wb") as output_stream:
                bytes_written = copy_stream(input_stream, output_stream)
    except OSError as exc:
        raise CliError(f"Failed to stage input file in transfer cache: {exc}") from exc
    return str(cache_path), bytes_written


def resolve_token(config: dict[str, Any], *, allow_provider: bool = True) -> tuple[str | None, str]:
    token = configured_token(config)
    if token:
        return token, "config"
    if not allow_provider:
        return None, "missing"
    authority = config_authority(config)
    token_source = "bridge"
    try:
        token = bridge_broadcast(config, "AUTH_TOKEN")
    except CliError:
        try:
            token = provider_query(authority, "auth_token")
            token_source = "provider"
        except CliError:
            return None, "missing"
    if isinstance(token, str) and token:
        return token, token_source
    return None, "missing"


def http_request(
    config: dict[str, Any],
    method: str,
    path: str,
    *,
    token: str | None = None,
    payload: dict[str, Any] | None = None,
    timeout: float = 10.0,
) -> Any:
    base_url = config_base_url(config)
    url = base_url + path
    headers = {}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = None
    if payload is not None:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError:
            parsed = {"status": "error", "error": raw or str(exc)}
        raise CliError(parsed.get("error") or parsed.get("message") or str(exc)) from exc
    except urllib.error.URLError as exc:
        raise CliError(str(exc.reason)) from exc

    if not raw:
        return None
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        return raw
    if isinstance(parsed, dict) and parsed.get("status") == "error":
        raise CliError(parsed.get("error", "AutoTermux API returned error"))
    if isinstance(parsed, dict) and "result" in parsed:
        return parsed["result"]
    return parsed


def websocket_resource_with_token(url: str, token: str, event_format: str | None = None) -> tuple[urllib.parse.ParseResult, str]:
    parsed = urllib.parse.urlparse(url)
    query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
    if token and not any(key == "token" for key, _ in query):
        query.append(("token", token))
    if event_format and event_format != "default" and not any(key == "eventFormat" for key, _ in query):
        query.append(("eventFormat", event_format))
    encoded_query = urllib.parse.urlencode(query)
    resource = parsed.path or "/"
    if encoded_query:
        resource += f"?{encoded_query}"
    return parsed, resource


def websocket_connect(url: str, token: str, event_format: str | None, timeout: float) -> socket.socket:
    parsed, resource = websocket_resource_with_token(url, token, event_format)
    if parsed.scheme not in ("ws", "wss"):
        raise CliError("WebSocket URL must start with ws:// or wss://")
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "wss" else 80)
    raw_sock = socket.create_connection((host, port), timeout=timeout)
    sock = ssl.create_default_context().wrap_socket(raw_sock, server_hostname=host) if parsed.scheme == "wss" else raw_sock
    sock.settimeout(timeout)
    key = base64.b64encode(os.urandom(16)).decode()
    host_header = f"{host}:{port}"
    request = (
        f"GET {resource} HTTP/1.1\r\n"
        f"Host: {host_header}\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\n"
        f"Authorization: Bearer {token}\r\n"
        "\r\n"
    )
    sock.sendall(request.encode("ascii"))
    response = b""
    while b"\r\n\r\n" not in response:
        chunk = sock.recv(4096)
        if not chunk:
            break
        response += chunk
        if len(response) > 65536:
            raise CliError("WebSocket handshake response too large")
    header = response.decode("iso-8859-1", errors="replace")
    if not header.startswith("HTTP/1.1 101") and not header.startswith("HTTP/1.0 101"):
        raise CliError(f"WebSocket handshake failed: {header.splitlines()[0] if header else 'empty response'}")
    accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    if f"Sec-WebSocket-Accept: {accept}".lower() not in header.lower():
        raise CliError("WebSocket handshake failed: invalid Sec-WebSocket-Accept")
    return sock


def websocket_read_exact(sock: socket.socket, size: int) -> bytes:
    data = bytearray()
    while len(data) < size:
        chunk = sock.recv(size - len(data))
        if not chunk:
            raise CliError("WebSocket connection closed")
        data.extend(chunk)
    return bytes(data)


def websocket_read_frame(sock: socket.socket) -> tuple[int, bytes]:
    first = websocket_read_exact(sock, 2)
    opcode = first[0] & 0x0F
    masked = bool(first[1] & 0x80)
    length = first[1] & 0x7F
    if length == 126:
        length = struct.unpack("!H", websocket_read_exact(sock, 2))[0]
    elif length == 127:
        length = struct.unpack("!Q", websocket_read_exact(sock, 8))[0]
    mask = websocket_read_exact(sock, 4) if masked else b""
    payload = websocket_read_exact(sock, length) if length else b""
    if masked:
        payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
    return opcode, payload


def websocket_send_frame(sock: socket.socket, opcode: int, payload: bytes = b"") -> None:
    mask = os.urandom(4)
    first = 0x80 | (opcode & 0x0F)
    length = len(payload)
    if length < 126:
        header = struct.pack("!BB", first, 0x80 | length)
    elif length <= 0xFFFF:
        header = struct.pack("!BBH", first, 0x80 | 126, length)
    else:
        header = struct.pack("!BBQ", first, 0x80 | 127, length)
    masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
    sock.sendall(header + mask + masked)


def print_json(value: Any, *, compact: bool = False, file: Any = None) -> None:
    file = file or sys.stdout
    if compact:
        print(json.dumps(value, ensure_ascii=False, separators=(",", ":")), file=file)
    else:
        print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True), file=file)


def print_raw(value: Any) -> None:
    if value is None:
        return
    if isinstance(value, bytes):
        sys.stdout.buffer.write(value)
        return
    if isinstance(value, (dict, list)):
        print_json(value, compact=True)
        return
    print(str(value))


def emit_success(
    args: argparse.Namespace,
    result: Any = None,
    *,
    command: str | None = None,
    meta: dict[str, Any] | None = None,
) -> None:
    output_format = active_output_format(args)
    if output_format == "none":
        return
    if output_format == "raw":
        print_raw(result)
        return
    payload: dict[str, Any] = {
        "ok": True,
        "schema_version": "tp-android.v1",
        "command": command or getattr(args, "command_path", getattr(args, "command", "")),
        "result": result,
    }
    if meta:
        payload["meta"] = meta
    print_json(payload, compact=(output_format == "json"))


def emit_error(
    message: str,
    args: argparse.Namespace | None = None,
    *,
    code: str = "CLI_ERROR",
    hint: str | None = None,
    recoverable: bool | None = None,
    details: dict[str, Any] | None = None,
) -> None:
    spec = ERROR_CODES.get(code, ERROR_CODES["CLI_ERROR"])
    effective_hint = hint if hint is not None else spec.get("hint")
    effective_recoverable = recoverable if recoverable is not None else spec.get("recoverable", False)
    error_obj: dict[str, Any] = {
        "code": code,
        "message": message,
        "recoverable": bool(effective_recoverable),
    }
    if effective_hint:
        error_obj["hint"] = effective_hint
    if details:
        error_obj["details"] = details
    payload = {
        "ok": False,
        "schema_version": "tp-android.v1",
        "error": error_obj,
    }
    print_json(payload, compact=(active_output_format(args) != "pretty"), file=sys.stderr)


# ============================================================================
# Status protocol (L4 in docs/automation-agent-ux-plan.md)
# ----------------------------------------------------------------------------
# A "run" is one logical Agent task. We persist its lifecycle to disk so that
# (a) the HUD overlay process can read state without an IPC handshake, and
# (b) the user can introspect / cancel runs from another shell.
#
# Layout under $HOME/.termuxplus/runs/ :
#   current                       # plain text file: latest run_id
#   <run_id>/run.json             # full run state (atomically rewritten)
#   <run_id>/interaction-<id>.req # pending interaction request
#   <run_id>/interaction-<id>.res # response written by HUD / terminal fallback
#
# All writes go through _status_write_json which writes to a temp file and
# renames into place, so partial writes are never observable.
# ============================================================================

STATUS_SCHEMA_VERSION = "tp-android.status.v1"

STATUS_HUD_PID_FILE = Path(
    os.environ.get("TP_HUD_PID_FILE")
    or (Path(os.environ.get("HOME", "/data/data/com.termux/files/home")) / ".termuxplus" / "hud.pid")
)


def _status_root() -> Path:
    base = Path(os.environ.get("TP_RUN_DIR") or (Path(os.environ.get("HOME", "/data/data/com.termux/files/home")) / ".termuxplus" / "runs"))
    base.mkdir(parents=True, exist_ok=True)
    return base


def _status_run_dir(run_id: str) -> Path:
    path = _status_root() / run_id
    path.mkdir(parents=True, exist_ok=True)
    return path


def _status_current_file() -> Path:
    return _status_root() / "current"


def _status_now_ms() -> int:
    return int(time.time() * 1000)


def _status_write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
    os.replace(tmp, path)


def _status_read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except json.JSONDecodeError:
        return None


def _status_new_run_id() -> str:
    return "r_" + uuid.uuid4().hex[:16]


def _status_resolve_run_id(explicit: str | None) -> str | None:
    if explicit:
        return explicit
    env_id = os.environ.get("TP_RUN_ID")
    if env_id:
        return env_id
    cur = _status_current_file()
    if cur.exists():
        text = cur.read_text(encoding="utf-8").strip()
        if text:
            return text
    return None


def _status_set_current(run_id: str | None) -> None:
    cur = _status_current_file()
    if run_id is None:
        try:
            cur.unlink()
        except FileNotFoundError:
            pass
        return
    cur.write_text(run_id, encoding="utf-8")


def _status_load_run(run_id: str) -> dict[str, Any]:
    data = _status_read_json(_status_run_dir(run_id) / "run.json")
    if not isinstance(data, dict):
        raise CliError(f"Run not found: {run_id}", code="CLI_ERROR")
    return data


def _status_save_run(run: dict[str, Any]) -> None:
    run["updated_at"] = _status_now_ms()
    _status_write_json(_status_run_dir(run["run_id"]) / "run.json", run)


def _status_append_event(run: dict[str, Any], kind: str, **payload: Any) -> dict[str, Any]:
    event = {"at": _status_now_ms(), "kind": kind, **payload}
    events = run.setdefault("events", [])
    events.append(event)
    # Keep memory bounded; HUD only needs a tail.
    if len(events) > 500:
        del events[: len(events) - 500]
    return event


def _status_get_run_id_or_error(explicit: str | None) -> str:
    run_id = _status_resolve_run_id(explicit)
    if not run_id:
        raise CliError(
            "No active run. Start one with: tp-android status start --task '...'",
            code="CLI_ERROR",
        )
    return run_id


STATUS_NOTIFICATION_CHANNEL = "tp-android-status"

# Shared-storage directory where AutoTermux's HUD writes pause/cancel markers
# when the user taps the corresponding button. Both packages can reach this
# path. See HudControlSignal.kt for the writer side.
HUD_SIGNAL_DIR = Path("/storage/emulated/0/Download/.termuxplus/tp-android-cache/hud-signals")


def _hud_signal_consume(run_id: str) -> str | None:
    """Return ("pause"|"cancel"|"user-touch") if the HUD/a11y has signalled for this run."""
    if not run_id:
        return None
    for kind in ("cancel", "pause", "user-touch"):
        target = HUD_SIGNAL_DIR / f"{run_id}.{kind}"
        if target.exists():
            try:
                target.unlink()
            except OSError:
                pass
            return kind
        fallback = HUD_SIGNAL_DIR / f"current.{kind}"
        if fallback.exists():
            try:
                fallback.unlink()
            except OSError:
                pass
            return kind
    return None


AGENT_MODE_STATE_PATH = Path(
    os.environ.get("TP_AGENT_MODE_STATE")
    or (Path(os.environ.get("HOME", "/data/data/com.termux/files/home")) / ".termuxplus" / "agent-mode.json")
)


def _agent_mode_read() -> dict[str, Any] | None:
    try:
        return json.loads(AGENT_MODE_STATE_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def _agent_mode_write(state: dict[str, Any] | None) -> None:
    if state is None:
        try:
            AGENT_MODE_STATE_PATH.unlink()
        except FileNotFoundError:
            pass
        return
    AGENT_MODE_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    AGENT_MODE_STATE_PATH.write_text(json.dumps(state, ensure_ascii=False), encoding="utf-8")


def command_agent_mode_start(args: argparse.Namespace) -> int:
    state = {
        "active": True,
        "on_user_touch": args.on_user_touch,
        "on_app_switch": args.on_app_switch,
        "started_at": _status_now_ms(),
    }
    _agent_mode_write(state)
    emit_success(args, state, command="agent-mode.start")
    return 0


def command_agent_mode_stop(args: argparse.Namespace) -> int:
    _agent_mode_write(None)
    emit_success(args, {"active": False}, command="agent-mode.stop")
    return 0


def command_agent_mode_status(args: argparse.Namespace) -> int:
    state = _agent_mode_read() or {"active": False}
    emit_success(args, state, command="agent-mode.status")
    return 0


def _hud_push_state(args: argparse.Namespace, run: dict[str, Any]) -> None:
    """Best-effort: mirror current run state to AutoTermux's HUD overlay.

    Only fires when the run was started with --hud / --notify (the same flag
    enables sticky notification too), or when $TP_STATUS_HUD=1. Failures are
    swallowed because the HUD is decorative — losing it must not break the run.
    """
    if not (
        run.get("hud") or run.get("notify")
        or os.environ.get("TP_STATUS_HUD") in {"1", "true", "yes", "on"}
    ):
        return
    step = run.get("current_step") or {}
    payload: dict[str, Any] = {
        "run_id": run.get("run_id"),
        "task": run.get("task"),
        "state": run.get("state") or "running",
        "step": step.get("index", 0) if isinstance(step, dict) else 0,
        "total_steps": run.get("total_steps") or 0,
        "step_label": step.get("label") if isinstance(step, dict) else None,
    }
    if isinstance(step, dict):
        progress = step.get("progress")
        if isinstance(progress, dict) and progress.get("percent") is not None:
            payload["percent"] = progress["percent"]
    pending = run.get("pending_interaction")
    if isinstance(pending, dict):
        inner = pending.get("payload") or {}
        payload["pending_prompt"] = inner.get("reason") or inner.get("prompt")
    try:
        bridge_call(load_runtime_config(args), "hud/update", payload)
    except CliError:
        pass


def _hud_hide_quiet(args: argparse.Namespace) -> None:
    try:
        bridge_call(load_runtime_config(args), "hud/hide")
    except CliError:
        pass


def _status_notification_id_for(run_id: str) -> int:
    # Stable positive 31-bit int derived from run_id, so updates replace and
    # different runs don't clobber each other.
    digest = hashlib.sha1(run_id.encode("utf-8")).digest()
    return (int.from_bytes(digest[:4], "big") & 0x7FFFFFFF) or 1


def _status_notification_should_publish(run: dict[str, Any]) -> bool:
    if os.environ.get("TP_STATUS_NOTIFY") in {"1", "true", "yes", "on"}:
        return True
    return bool(run.get("notify"))


def _status_notification_publish(args: argparse.Namespace, run: dict[str, Any]) -> None:
    """Push the run state to AutoTermux's foreground keepalive service.

    That service holds the sticky notification (with Pause/Cancel actions) and
    keeps our companion process alive against OEM battery kills. It's started
    on first call and stopped explicitly via `_status_notification_remove`.
    """
    if not _status_notification_should_publish(run):
        return
    run_id = run.get("run_id")
    if not isinstance(run_id, str):
        return
    step = run.get("current_step") if isinstance(run.get("current_step"), dict) else {}
    pending = run.get("pending_interaction") if isinstance(run.get("pending_interaction"), dict) else {}
    payload: dict[str, Any] = {
        "run_id": run_id,
        "task": run.get("task"),
        "state": run.get("state") or "running",
        "step": step.get("index", 0) if isinstance(step, dict) else 0,
        "total_steps": run.get("total_steps") or 0,
        "step_label": step.get("label") if isinstance(step, dict) else None,
    }
    if isinstance(step, dict):
        progress = step.get("progress")
        if isinstance(progress, dict) and progress.get("percent") is not None:
            payload["percent"] = progress["percent"]
    if isinstance(pending, dict):
        inner = pending.get("payload") or {}
        if isinstance(inner, dict):
            payload["pending_prompt"] = inner.get("reason") or inner.get("prompt")
    try:
        bridge_call(load_runtime_config(args), "keepalive/update", payload)
    except CliError:
        # Notification posting is best-effort — losing it should never fail
        # the status protocol itself.
        pass


def _status_notification_remove(args: argparse.Namespace, run_id: str) -> None:
    try:
        bridge_call(load_runtime_config(args), "keepalive/stop")
    except CliError:
        pass


def _status_hud_active() -> bool:
    """Return True if a HUD process registered a pid file and the pid is alive.

    When False, the interactive status commands fall back to terminal stdin.
    """
    try:
        pid_text = STATUS_HUD_PID_FILE.read_text(encoding="utf-8").strip()
        pid = int(pid_text)
    except (FileNotFoundError, ValueError, OSError):
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def _status_request_interaction(
    run: dict[str, Any],
    kind: str,
    payload: dict[str, Any],
    timeout_seconds: float,
    args: argparse.Namespace | None = None,
) -> dict[str, Any]:
    """Solicit user input for a run.

    Resolution order:
      1. If AutoTermux's bridge is reachable and `--no-dialog` isn't set, render
         the prompt with the existing DialogBridgeActivity — that's a modal
         system dialog over whatever the user is currently looking at. This is
         the "HUD intervention" path.
      2. Otherwise, if stdin is a TTY, fall back to a terminal prompt. This is
         the dev/SSH path.
      3. Otherwise, time out immediately.

    Either way we persist the request and the response to the run directory so
    `status tail` and the on-disk history reflect the interaction.
    """

    interaction_id = uuid.uuid4().hex[:12]
    req = {
        "interaction_id": interaction_id,
        "run_id": run["run_id"],
        "kind": kind,
        "payload": payload,
        "requested_at": _status_now_ms(),
        "expires_at": _status_now_ms() + int(timeout_seconds * 1000),
    }
    run_dir = _status_run_dir(run["run_id"])
    req_path = run_dir / f"interaction-{interaction_id}.req"
    res_path = run_dir / f"interaction-{interaction_id}.res"

    _status_write_json(req_path, req)
    run["pending_interaction"] = {
        "interaction_id": interaction_id,
        "kind": kind,
        "payload": payload,
        "expires_at": req["expires_at"],
    }
    _status_append_event(run, "interaction_request", interaction_id=interaction_id, interaction_kind=kind, payload=payload)
    _status_save_run(run)

    response: dict[str, Any] | None = None
    used_channel = "none"

    if args is not None and not getattr(args, "no_dialog", False):
        response = _status_dialog_channel(args, kind, payload, timeout_seconds)
        if response is not None:
            used_channel = "dialog"

    if response is None:
        response = _status_terminal_fallback(kind, payload, timeout_seconds)
        if response is not None:
            used_channel = "terminal"

    if response is not None:
        _status_write_json(res_path, response)

    run = _status_load_run(run["run_id"])
    run.pop("pending_interaction", None)
    if response is None:
        _status_append_event(run, "interaction_timeout", interaction_id=interaction_id, channel=used_channel)
        _status_save_run(run)
        return {"timeout": True, "interaction_id": interaction_id, "channel": used_channel}
    _status_append_event(
        run,
        "interaction_response",
        interaction_id=interaction_id,
        response=response,
        channel=used_channel,
    )
    _status_save_run(run)
    return {**response, "interaction_id": interaction_id, "channel": used_channel}


def _status_dialog_channel(
    args: argparse.Namespace,
    kind: str,
    payload: dict[str, Any],
    timeout_seconds: float,
) -> dict[str, Any] | None:
    """Render the interaction as a modal Android dialog via DialogBridgeActivity.

    Returns the normalized response dict, or None if the dialog channel is
    unavailable (bridge down, AutoTermux missing, OEM kill, etc.) so the caller
    can fall back to the terminal channel.
    """
    timeout_ms = int(max(1.0, timeout_seconds) * 1000)
    try:
        if kind == "intervene":
            choices = list(payload.get("choices") or [])
            if not choices:
                choices = ["continue", "cancel"]
            dialog_payload = {
                "widget": "radio",
                "title": "Agent needs you",
                "hint": payload.get("reason") or "Pick an option",
                "values": ",".join(choices),
                "timeoutMs": timeout_ms,
            }
            result = termux_api_call(args, "dialog", dialog_payload)
            if not isinstance(result, dict):
                return None
            if result.get("code", 0) != 0:
                return {"choice": "__cancel__"}
            text = result.get("text") if isinstance(result.get("text"), str) else None
            if not text and result.get("index") is not None:
                idx = int(result["index"])
                if 0 <= idx < len(choices):
                    text = choices[idx]
            return {"choice": text} if text else None
        if kind == "ask_input":
            widget_payload = {
                "widget": "text",
                "title": "Agent needs input",
                "hint": payload.get("prompt") or "Enter a value",
                "timeoutMs": timeout_ms,
            }
            if payload.get("kind") == "password":
                widget_payload["password"] = True
            if payload.get("kind") == "number":
                widget_payload["numeric"] = True
            result = termux_api_call(args, "dialog", widget_payload)
            if not isinstance(result, dict):
                return None
            if result.get("code", 0) != 0:
                return {"value": ""}
            return {"value": result.get("text") if isinstance(result.get("text"), str) else ""}
        if kind == "confirm":
            widget_payload = {
                "widget": "confirm",
                "title": "Agent confirmation",
                "hint": payload.get("prompt") or "Confirm action",
                "timeoutMs": timeout_ms,
            }
            result = termux_api_call(args, "dialog", widget_payload)
            if not isinstance(result, dict):
                return None
            return {"confirmed": result.get("code", 0) == 0 and result.get("text", "").lower() in {"yes", "ok", "true", ""}}
        return None
    except CliError:
        return None


def _status_terminal_fallback(kind: str, payload: dict[str, Any], timeout_seconds: float) -> dict[str, Any] | None:
    """Read interaction response from the user's TTY when no HUD is running.

    Returns None on timeout/EOF. Prompts are written to stderr so stdout stays
    a clean JSON channel for callers that pipe.
    """

    if not sys.stdin.isatty():
        # No TTY and no HUD — we cannot collect a response.
        return None

    prompt = payload.get("prompt") or payload.get("reason") or "Agent needs input"
    if kind == "intervene":
        choices: list[str] = list(payload.get("choices") or [])
        if not choices:
            choices = ["continue", "cancel"]
        sys.stderr.write(f"\n[tp-android status intervene] {prompt}\n")
        for idx, label in enumerate(choices, start=1):
            sys.stderr.write(f"  [{idx}] {label}\n")
        sys.stderr.write(f"  (timeout in {timeout_seconds:.0f}s, blank to cancel)\n> ")
        sys.stderr.flush()
        try:
            raw = sys.stdin.readline().strip()
        except KeyboardInterrupt:
            return {"choice": "__interrupt__"}
        if not raw:
            return None
        if raw.isdigit() and 1 <= int(raw) <= len(choices):
            return {"choice": choices[int(raw) - 1]}
        if raw in choices:
            return {"choice": raw}
        return {"choice": raw}
    if kind == "ask_input":
        sys.stderr.write(f"\n[tp-android status ask-input] {prompt}\n> ")
        sys.stderr.flush()
        try:
            raw = sys.stdin.readline()
        except KeyboardInterrupt:
            return None
        if not raw:
            return None
        return {"value": raw.rstrip("\n")}
    if kind == "confirm":
        sys.stderr.write(f"\n[tp-android status confirm] {prompt} [y/N]: ")
        sys.stderr.flush()
        try:
            raw = sys.stdin.readline().strip().lower()
        except KeyboardInterrupt:
            return {"confirmed": False}
        if raw in {"y", "yes", "1", "true"}:
            return {"confirmed": True}
        if not raw:
            return {"confirmed": False}
        return {"confirmed": False}
    return None


def command_status_start(args: argparse.Namespace) -> int:
    run_id = args.id or _status_new_run_id()
    now = _status_now_ms()
    run = {
        "schema_version": STATUS_SCHEMA_VERSION,
        "run_id": run_id,
        "task": args.task,
        "total_steps": args.total_steps,
        "state": "running",
        "current_step": None,
        "pending_interaction": None,
        "started_at": now,
        "updated_at": now,
        "ended_at": None,
        "summary": None,
        "error": None,
        "notify": bool(args.notify),
        "hud": bool(args.hud or args.notify),
        "events": [],
    }
    _status_append_event(run, "start", task=args.task, total_steps=args.total_steps)
    _status_save_run(run)
    _status_set_current(run_id)
    _status_notification_publish(args, run)
    _hud_push_state(args, run)
    emit_success(args, {"run_id": run_id, "started_at": now}, command="status.start")
    return 0


def command_status_finish(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    run["state"] = args.state
    run["summary"] = args.summary
    run["ended_at"] = _status_now_ms()
    _status_append_event(run, "finish", state=args.state, summary=args.summary)
    _status_save_run(run)
    # Clear current pointer only if it points at this run
    cur = _status_resolve_run_id(None)
    if cur == run_id:
        _status_set_current(None)
    # Update or remove the sticky notification depending on outcome.
    if args.state == "success" and not args.keep_notification:
        _status_notification_remove(args, run_id)
    else:
        _status_notification_publish(args, run)
    _hud_push_state(args, run)
    _hud_hide_quiet(args)
    emit_success(args, {"run_id": run_id, "state": args.state, "ended_at": run["ended_at"]}, command="status.finish")
    return 0


def command_status_step(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    step = {
        "index": args.step,
        "label": args.label,
        "state": args.state,
        "detail": args.detail,
        "updated_at": _status_now_ms(),
    }
    if args.state == "running" or run.get("current_step") is None or run.get("current_step", {}).get("index") != args.step:
        step["started_at"] = _status_now_ms()
    else:
        existing = run.get("current_step", {})
        step["started_at"] = existing.get("started_at", _status_now_ms())
    run["current_step"] = step
    _status_append_event(run, "step", **step)
    _status_save_run(run)
    _status_notification_publish(args, run)
    _hud_push_state(args, run)
    _maybe_apply_hud_signal(args, run_id, run)
    emit_success(args, {"run_id": run_id, "step": step}, command="status.step")
    return 0


def _maybe_apply_hud_signal(args: argparse.Namespace, run_id: str, run: dict[str, Any]) -> None:
    """Honor pause/cancel/user-touch markers if present, applying agent-mode policy."""
    signal = _hud_signal_consume(run_id)
    if not signal:
        return
    if signal == "cancel":
        run["state"] = "cancelled"
        run["ended_at"] = _status_now_ms()
        _status_append_event(run, "cancel", source="hud")
        _status_save_run(run)
        _status_notification_remove(args, run_id)
        _hud_hide_quiet(args)
        return
    if signal == "pause":
        _status_append_event(run, "pause_request", source="hud")
        _status_save_run(run)
        return
    if signal == "user-touch":
        policy = (_agent_mode_read() or {}).get("on_user_touch", "log")
        _status_append_event(run, "user_touch", policy=policy)
        if policy == "abort":
            run["state"] = "cancelled"
            run["ended_at"] = _status_now_ms()
            _status_append_event(run, "cancel", source="user-touch")
            _status_save_run(run)
            _hud_hide_quiet(args)
            return
        if policy == "pause":
            # Ask the user what to do via the same intervene channel.
            run["state"] = "waiting"
            _status_save_run(run)
            response = _status_request_interaction(
                run,
                "intervene",
                {"reason": "User touched the screen — continue or stop?", "choices": ["continue", "abort"]},
                30.0,
                args=args,
            )
            choice = response.get("choice") if isinstance(response, dict) else None
            run = _status_load_run(run["run_id"])
            if choice == "abort" or response.get("timeout"):
                run["state"] = "cancelled"
                run["ended_at"] = _status_now_ms()
                _status_append_event(run, "cancel", source="user-touch-policy")
            else:
                run["state"] = "running"
            _status_save_run(run)
            return
        # default "log": just keep going
        _status_save_run(run)


def command_status_progress(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    progress = {
        "percent": max(0.0, min(100.0, float(args.percent))),
        "detail": args.detail,
        "at": _status_now_ms(),
    }
    if isinstance(run.get("current_step"), dict):
        run["current_step"]["progress"] = progress
    _status_append_event(run, "progress", **progress)
    _status_save_run(run)
    _status_notification_publish(args, run)
    _hud_push_state(args, run)
    _maybe_apply_hud_signal(args, run_id, run)
    emit_success(args, {"run_id": run_id, "progress": progress}, command="status.progress")
    return 0


def command_status_intervene(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    choices = [c.strip() for c in (args.choices or "").split(",") if c.strip()]
    payload = {"reason": args.reason, "choices": choices, "tts": args.tts}
    run["state"] = "waiting"
    _status_save_run(run)
    _status_notification_publish(args, run)
    _hud_push_state(args, run)
    response = _status_request_interaction(run, "intervene", payload, args.wait_timeout, args=args)
    run = _status_load_run(run_id)
    if response.get("timeout"):
        run["state"] = "running"
        _status_save_run(run)
        _status_notification_publish(args, run)
        emit_success(args, response, command="status.intervene")
        return 0
    run["state"] = "running"
    _status_save_run(run)
    _status_notification_publish(args, run)
    emit_success(args, response, command="status.intervene")
    return 0


def command_status_ask_input(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    payload = {"prompt": args.prompt, "kind": args.kind, "tts": args.tts}
    run["state"] = "waiting"
    _status_save_run(run)
    _status_notification_publish(args, run)
    response = _status_request_interaction(run, "ask_input", payload, args.wait_timeout, args=args)
    run = _status_load_run(run_id)
    run["state"] = "running"
    _status_save_run(run)
    _status_notification_publish(args, run)
    emit_success(args, response, command="status.ask-input")
    return 0


def command_status_confirm(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    payload = {"prompt": args.prompt, "tts": args.tts}
    run["state"] = "waiting"
    _status_save_run(run)
    _status_notification_publish(args, run)
    response = _status_request_interaction(run, "confirm", payload, args.wait_timeout, args=args)
    run = _status_load_run(run_id)
    run["state"] = "running"
    _status_save_run(run)
    _status_notification_publish(args, run)
    emit_success(args, response, command="status.confirm")
    return 0


def command_status_error(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    spec = ERROR_CODES.get(args.code, ERROR_CODES["CLI_ERROR"])
    recoverable = args.recoverable if args.recoverable is not None else bool(spec.get("recoverable", False))
    hint = args.hint or spec.get("hint")
    err = {
        "code": args.code,
        "message": args.message,
        "hint": hint,
        "recoverable": recoverable,
        "at": _status_now_ms(),
    }
    run["error"] = err
    if not recoverable:
        run["state"] = "error"
        run["ended_at"] = _status_now_ms()
    _status_append_event(run, "error", **err)
    _status_save_run(run)
    _status_notification_publish(args, run)
    _hud_push_state(args, run)
    emit_success(args, {"run_id": run_id, "error": err}, command="status.error")
    return 0


def command_status_cancel(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    run = _status_load_run(run_id)
    run["state"] = "cancelled"
    run["ended_at"] = _status_now_ms()
    _status_append_event(run, "cancel", source=args.source)
    _status_save_run(run)
    cur = _status_resolve_run_id(None)
    if cur == run_id:
        _status_set_current(None)
    _status_notification_remove(args, run_id)
    _hud_hide_quiet(args)
    emit_success(args, {"run_id": run_id, "state": "cancelled"}, command="status.cancel")
    return 0


def command_status_current(args: argparse.Namespace) -> int:
    run_id = _status_resolve_run_id(args.id)
    if not run_id:
        emit_success(args, None, command="status.current")
        return 0
    run = _status_load_run(run_id)
    emit_success(args, run, command="status.current")
    return 0


def command_status_history(args: argparse.Namespace) -> int:
    root = _status_root()
    runs = []
    for entry in sorted(root.iterdir(), key=lambda p: p.name, reverse=True):
        if not entry.is_dir():
            continue
        run = _status_read_json(entry / "run.json")
        if isinstance(run, dict):
            runs.append({
                "run_id": run.get("run_id"),
                "task": run.get("task"),
                "state": run.get("state"),
                "started_at": run.get("started_at"),
                "ended_at": run.get("ended_at"),
            })
        if len(runs) >= args.limit:
            break
    emit_success(args, {"runs": runs}, command="status.history")
    return 0


def command_status_tail(args: argparse.Namespace) -> int:
    run_id = _status_get_run_id_or_error(args.id)
    seen = 0
    while True:
        run = _status_load_run(run_id)
        events = run.get("events") or []
        if len(events) > seen:
            for ev in events[seen:]:
                print_json(ev, compact=True)
            seen = len(events)
        if not args.follow:
            return 0
        if run.get("state") in {"done", "cancelled", "error"}:
            return 0
        time.sleep(args.interval)


def redact_config(config: dict[str, Any], *, show_token: bool = False) -> dict[str, Any]:
    token = configured_token(config)
    return {
        "config": str(CONFIG_PATH),
        "transport": config_transport(config),
        "base_url": config_base_url(config),
        "authority": config_authority(config),
        "user": config_android_user(config),
        "token": token if show_token else ("present" if token else "missing"),
    }


def parse_json_value(value: str) -> Any:
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        lowered = value.lower()
        if lowered == "true":
            return True
        if lowered == "false":
            return False
        if lowered == "null":
            return None
        if re.fullmatch(r"-?\d+", value):
            return int(value)
        if re.fullmatch(r"-?\d+\.\d+", value):
            return float(value)
        return value


def parse_bool(value: str) -> bool:
    parsed = parse_json_value(value)
    if isinstance(parsed, bool):
        return parsed
    lowered = str(value).strip().lower()
    if lowered in {"1", "yes", "on", "enable", "enabled"}:
        return True
    if lowered in {"0", "no", "off", "disable", "disabled"}:
        return False
    raise argparse.ArgumentTypeError("expected boolean: true/false, 1/0, on/off, enable/disable")


def parse_json_input(value: str | None) -> dict[str, Any]:
    if not value:
        return {}
    if value == "-":
        raw = sys.stdin.read()
    elif value.startswith("@"):
        raw = Path(value[1:]).read_text()
    else:
        raw = value
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise CliError(f"Invalid JSON: {exc}") from exc
    if not isinstance(parsed, dict):
        raise CliError("JSON input must be an object")
    return parsed


def parse_key_values(values: list[str] | None) -> dict[str, Any]:
    payload: dict[str, Any] = {}
    for item in values or []:
        if "=" not in item:
            raise CliError(f"Expected KEY=VALUE, got '{item}'")
        key, value = item.split("=", 1)
        if not key:
            raise CliError(f"Expected non-empty key in '{item}'")
        payload[key] = parse_json_value(value)
    return payload


def command_text_arg(args: argparse.Namespace, attr: str = "text") -> str:
    if getattr(args, "stdin", False):
        return sys.stdin.read()
    value = getattr(args, attr, None)
    if value is None:
        raise CliError("Text is required; pass TEXT or --stdin")
    if isinstance(value, list):
        if not value:
            raise CliError("Text is required; pass TEXT or --stdin")
        return " ".join(value)
    return value


def command_configure(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    if args.base_url:
        config["base_url"] = args.base_url.rstrip("/")
    if args.authority:
        config["authority"] = args.authority
    if args.user:
        config["user"] = args.user
    if getattr(args, "transport", None):
        config["transport"] = args.transport
    if args.token:
        config["token"] = args.token
    save_config(config)
    emit_success(args, redact_config(config), command=getattr(args, "command_path", "config.set"))
    return 0


def command_config_show(args: argparse.Namespace) -> int:
    emit_success(args, redact_config(load_runtime_config(args), show_token=args.show_token))
    return 0


def command_config_set(args: argparse.Namespace) -> int:
    config = load_config()
    changed: list[str] = []
    for key in ("base_url", "authority", "user", "token", "transport"):
        value = getattr(args, key, None)
        if value not in (None, ""):
            config[key] = value.rstrip("/") if key == "base_url" else value
            changed.append(key)
    if args.token_stdin:
        config["token"] = sys.stdin.read().strip()
        changed.append("token")
    save_config(config)
    result = redact_config(config)
    result["changed"] = sorted(set(changed))
    emit_success(args, result)
    return 0


def command_config_unset(args: argparse.Namespace) -> int:
    config = load_config()
    removed: list[str] = []
    for key in args.keys:
        if key in config:
            config.pop(key, None)
            removed.append(key)
    save_config(config)
    result = redact_config(config)
    result["removed"] = removed
    emit_success(args, result)
    return 0


def command_config_path(args: argparse.Namespace) -> int:
    emit_success(args, {"path": str(CONFIG_PATH)})
    return 0


def command_install_companion(args: argparse.Namespace) -> int:
    if not args.skip_asset_check and not embedded_autotermux_asset_available():
        raise CliError(
            "This Termux build does not contain the embedded AutoTermux APK. "
            "Install a newer Termux build or pass --skip-asset-check to open the installer anyway."
        )

    config = load_config()
    output = run_system_am([
        "broadcast",
        "--user",
        config_android_user(config),
        "--receiver-foreground",
        "-a",
        AUTOTERMUX_INSTALL_ACTION,
        "-n",
        AUTOTERMUX_INSTALL_RECEIVER,
    ])
    emit_success(args, {
        "status": "started",
        "package": AUTOTERMUX_PACKAGE,
        "installer": AUTOTERMUX_INSTALL_RECEIVER,
        "output": output,
    })
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    transport = config_transport(config)
    result: dict[str, Any] = {
        "transport": transport,
        "authority": config_authority(config),
        "user": config_android_user(config),
        "config": str(CONFIG_PATH),
    }
    checks: list[dict[str, Any]] = []

    if transport == "provider":
        try:
            result["ping"] = provider_query(config_authority(config), "ping")
            checks.append({"name": "provider_ping", "ok": bool(result["ping"])})
        except CliError as exc:
            result["ping_error"] = str(exc)
            checks.append({"name": "provider_ping", "ok": False, "error": str(exc)})
    else:
        try:
            result["ping"] = bridge_call(config, "ping")
            checks.append({"name": "bridge_ping", "ok": bool(result["ping"])})
        except CliError as exc:
            result["ping_error"] = str(exc)
            checks.append({"name": "bridge_ping", "ok": False, "error": str(exc)})

    try:
        state = portal_get("/state_full", args)
        result["accessibility"] = "ready" if isinstance(state, dict) and "a11y_tree" in state else "unknown"
        checks.append({"name": "accessibility", "ok": result["accessibility"] == "ready"})
    except CliError as exc:
        result["accessibility"] = "not_ready"
        result["accessibility_error"] = str(exc)
        checks.append({"name": "accessibility", "ok": False, "error": str(exc)})

    result["checks"] = checks
    ok = any(check.get("name", "").endswith("_ping") and check.get("ok") for check in checks)
    emit_success(args, result, meta={"ok": ok})
    return 0 if ok else 1


def command_ping(args: argparse.Namespace) -> int:
    started = time.monotonic()
    result = portal_get("/ping", args)
    elapsed_ms = (time.monotonic() - started) * 1000.0
    emit_success(
        args,
        {
            "result": result,
            "latency_ms": round(elapsed_ms, 2),
            "transport": config_transport(load_runtime_config(args)),
        },
        command=getattr(args, "command_path", "ping"),
    )
    return 0


# ============================================================================
# keepalive — check the 4 processes the agent depends on, optionally try to
# revive them. Intended to be called at the start of every long-running run
# and (with --watch) as a background watchdog. See L0 in the UX plan.
# ============================================================================

KEEPALIVE_AUTOTERMUX_LAUNCH_INTENT = "android.intent.action.MAIN"


def _keepalive_probe_termux() -> dict[str, Any]:
    # If this script is running at all, the Termux process is alive. The check
    # that actually matters is whether `$PREFIX` / TERMUX_VERSION are set,
    # which guards against being invoked from `adb shell run-as` (which is
    # NOT the same context — see CLAUDE.md "run-as ≠ Termux").
    termux_version = os.environ.get("TERMUX_VERSION")
    prefix = os.environ.get("PREFIX", "")
    is_termux = bool(termux_version) and prefix.startswith("/data/data/com.termux/files/usr")
    return {
        "name": "termux",
        "ok": is_termux,
        "version": termux_version,
        "prefix": prefix or None,
        "hint": None if is_termux else (
            "Not running in Termux app context. tp-android only works inside the Termux app "
            "(not adb shell, not run-as)."
        ),
    }


def _keepalive_probe_bridge(args: argparse.Namespace) -> dict[str, Any]:
    config = load_runtime_config(args)
    started = time.monotonic()
    try:
        result = bridge_call(config, "ping")
        elapsed_ms = round((time.monotonic() - started) * 1000.0, 1)
        return {"name": "autotermux_bridge", "ok": True, "latency_ms": elapsed_ms, "result": result}
    except CliError as exc:
        return {"name": "autotermux_bridge", "ok": False, "code": exc.code, "message": str(exc), "hint": exc.hint}


def _keepalive_probe_a11y(args: argparse.Namespace) -> dict[str, Any]:
    try:
        state = portal_get("/state_full", args)
        ready = isinstance(state, dict) and "a11y_tree" in state
        return {
            "name": "accessibility_service",
            "ok": ready,
            "hint": None if ready else ERROR_CODES["A11Y_DISABLED"]["hint"],
        }
    except CliError as exc:
        return {
            "name": "accessibility_service",
            "ok": False,
            "code": exc.code,
            "message": str(exc),
            "hint": exc.hint or ERROR_CODES["A11Y_DISABLED"]["hint"],
        }


def _keepalive_probe_notification_listener(args: argparse.Namespace) -> dict[str, Any]:
    # Fold this into the existing permissions check. We do not fail keepalive
    # when notification listener is off because many automations don't need it.
    try:
        perms = termux_api_call(args, "permissions-status", {})
    except CliError as exc:
        return {"name": "notification_listener", "ok": None, "message": f"unable to probe: {exc}"}
    if not isinstance(perms, dict):
        return {"name": "notification_listener", "ok": None, "message": "unexpected permissions payload"}
    enabled = None
    for key in ("notificationListener", "notification_listener", "notification-listener"):
        if key in perms:
            value = perms[key]
            if isinstance(value, bool):
                enabled = value
                break
            if isinstance(value, dict) and "enabled" in value:
                enabled = bool(value["enabled"])
                break
    return {
        "name": "notification_listener",
        "ok": enabled if enabled is not None else None,
        "hint": None if enabled else ERROR_CODES["NOTIF_LISTENER_DISABLED"]["hint"],
    }


def _keepalive_try_restart_autotermux(args: argparse.Namespace) -> dict[str, Any]:
    """Best-effort nudge: ask Android to launch AutoTermux's main activity.

    Won't help if the user has the OEM battery manager actively killing the
    package — that's a manual whitelist step we cannot bypass.
    """
    try:
        run_system_am([
            "start",
            "--user", config_android_user(load_runtime_config(args)),
            "-a", KEEPALIVE_AUTOTERMUX_LAUNCH_INTENT,
            "-n", f"{AUTOTERMUX_PACKAGE}/{AUTOTERMUX_PACKAGE}.ui.MainActivity",
        ])
        return {"action": "autotermux_launch", "ok": True}
    except CliError as exc:
        return {"action": "autotermux_launch", "ok": False, "error": str(exc)}


def command_keepalive_ensure(args: argparse.Namespace) -> int:
    components = [_keepalive_probe_termux()]
    components.append(_keepalive_probe_bridge(args))

    # Bridge has to be up before the others make sense.
    bridge_ok = components[-1]["ok"]
    if bridge_ok:
        components.append(_keepalive_probe_a11y(args))
        components.append(_keepalive_probe_notification_listener(args))
    else:
        components.append({"name": "accessibility_service", "ok": None, "message": "skipped — bridge down"})
        components.append({"name": "notification_listener", "ok": None, "message": "skipped — bridge down"})

    actions: list[dict[str, Any]] = []
    if args.restart and not bridge_ok:
        actions.append(_keepalive_try_restart_autotermux(args))
        # Re-probe bridge briefly after nudge
        for _ in range(int(max(1, args.restart_wait))):
            time.sleep(1)
            new_bridge = _keepalive_probe_bridge(args)
            components[1] = new_bridge
            if new_bridge["ok"]:
                components[2] = _keepalive_probe_a11y(args)
                components[3] = _keepalive_probe_notification_listener(args)
                bridge_ok = True
                break

    critical_ok = all(
        c["ok"] is True
        for c in components
        if c["name"] in {"termux", "autotermux_bridge", "accessibility_service"}
    )

    result: dict[str, Any] = {"ok": critical_ok, "components": components}
    if actions:
        result["actions"] = actions

    emit_success(args, result, command="keepalive.ensure", meta={"ok": critical_ok})
    return 0 if critical_ok else 1


# ============================================================================
# setup — first-time guided onboarding. Walks through the 7 things a fresh
# install needs (companion, a11y, notification listener, overlay, app-perm,
# termux properties, OEM battery whitelist), opening the right Settings page
# for each and polling for it to flip to OK.
# ============================================================================

SETUP_STEPS = [
    "termux",
    "companion",
    "accessibility",
    "notification_listener",
    "overlay",
    "runtime_permissions",
    "termux_properties",
    "battery_whitelist",
]

# Settings intents used by the wizard. Many of these need `am start -a <action>`
# rather than `am start -n <component>`, which is why we keep them as actions.
_SETTINGS_ACTIONS: dict[str, dict[str, Any]] = {
    "accessibility": {
        "action": "android.settings.ACCESSIBILITY_SETTINGS",
    },
    "notification_listener": {
        "action": "android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS",
    },
    "overlay": {
        "action": "android.settings.action.MANAGE_OVERLAY_PERMISSION",
        "data": f"package:{AUTOTERMUX_PACKAGE}",
    },
    "app_details_autotermux": {
        "action": "android.settings.APPLICATION_DETAILS_SETTINGS",
        "data": f"package:{AUTOTERMUX_PACKAGE}",
    },
    "battery_optimization_autotermux": {
        "action": "android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "data": f"package:{AUTOTERMUX_PACKAGE}",
    },
}


def _setup_open_settings(args: argparse.Namespace, key: str) -> None:
    spec = _SETTINGS_ACTIONS.get(key)
    if not spec:
        return
    cmd = [
        "start",
        "--user", config_android_user(load_runtime_config(args)),
        "-a", spec["action"],
    ]
    if "data" in spec:
        cmd.extend(["-d", spec["data"]])
    cmd.extend(["--activity-clear-task", "--activity-new-task"])
    try:
        run_system_am(cmd)
    except CliError:
        # The settings intent may not be available on every OEM; the wizard
        # still tells the user where to look manually.
        pass


def _setup_termux_properties_path() -> Path:
    home = os.environ.get("HOME", "/data/data/com.termux/files/home")
    return Path(home) / ".termux" / "termux.properties"


def _setup_termux_properties_state() -> dict[str, Any]:
    path = _setup_termux_properties_path()
    if not path.exists():
        return {"exists": False, "allow_external_apps": False, "path": str(path)}
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return {"exists": True, "error": str(exc), "path": str(path)}
    allow = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("#"):
            continue
        if stripped.lower().startswith("allow-external-apps") and "=" in stripped:
            value = stripped.split("=", 1)[1].strip().lower()
            allow = value in {"true", "1", "yes", "on"}
            break
    return {"exists": True, "allow_external_apps": allow, "path": str(path)}


def _setup_fix_termux_properties(args: argparse.Namespace) -> dict[str, Any]:
    path = _setup_termux_properties_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    existing = path.read_text(encoding="utf-8") if path.exists() else ""
    new_lines = []
    found = False
    for line in existing.splitlines():
        stripped = line.strip()
        if stripped.startswith("#") or "=" not in stripped:
            new_lines.append(line)
            continue
        if stripped.lower().startswith("allow-external-apps"):
            new_lines.append("allow-external-apps=true")
            found = True
        else:
            new_lines.append(line)
    if not found:
        new_lines.append("allow-external-apps=true")
    path.write_text("\n".join(new_lines) + "\n", encoding="utf-8")
    # Reload Termux settings if the binary is on PATH.
    reload_output = None
    reload_bin = Path("/data/data/com.termux/files/usr/bin/termux-reload-settings")
    if reload_bin.exists():
        try:
            completed = subprocess.run([str(reload_bin)], capture_output=True, text=True, check=False)
            reload_output = (completed.stdout or "") + (completed.stderr or "")
        except OSError as exc:
            reload_output = f"reload failed: {exc}"
    return {"path": str(path), "allow_external_apps": True, "reload_output": reload_output}


def _setup_companion_installed(args: argparse.Namespace) -> bool:
    # Cheapest check: ask the bridge for ping. If it answers we know the
    # package is installed AND the receiver is alive.
    try:
        bridge_call(load_runtime_config(args), "ping")
        return True
    except CliError:
        pass
    # Fallback: `pm path <pkg>` returns 0 only when installed.
    pm_bin = Path("/system/bin/pm")
    if pm_bin.exists():
        try:
            completed = subprocess.run([str(pm_bin), "path", AUTOTERMUX_PACKAGE], capture_output=True, text=True, check=False)
            return completed.returncode == 0 and bool(completed.stdout.strip())
        except OSError:
            return False
    return False


def _setup_runtime_permissions_state(args: argparse.Namespace) -> dict[str, Any]:
    try:
        perms = termux_api_call(args, "permissions-status", {})
    except CliError as exc:
        return {"available": False, "error": str(exc)}
    if not isinstance(perms, dict):
        return {"available": False, "error": "unexpected permissions payload"}
    return {"available": True, "raw": perms}


def _setup_oem_brand() -> str:
    getprop = Path("/system/bin/getprop")
    if not getprop.exists():
        return ""
    try:
        completed = subprocess.run([str(getprop), "ro.product.brand"], capture_output=True, text=True, check=False)
        return (completed.stdout or "").strip().lower()
    except OSError:
        return ""


def _setup_probe(args: argparse.Namespace, step: str) -> dict[str, Any]:
    if step == "termux":
        return _keepalive_probe_termux()
    if step == "companion":
        installed = _setup_companion_installed(args)
        return {
            "name": "companion",
            "ok": installed,
            "hint": None if installed else "Run: tp-android install-companion",
        }
    if step == "accessibility":
        probe = _keepalive_probe_a11y(args)
        return {"name": "accessibility", "ok": bool(probe.get("ok")), "hint": probe.get("hint")}
    if step == "notification_listener":
        probe = _keepalive_probe_notification_listener(args)
        return {"name": "notification_listener", "ok": probe.get("ok") is True, "hint": probe.get("hint")}
    if step == "overlay":
        # Ask the companion: hud/show fails with OVERLAY_BLOCKED when
        # Settings.canDrawOverlays() is false. Cheap, definitive, no UI side-effects
        # (we immediately hide if it succeeded).
        try:
            bridge_call(load_runtime_config(args), "hud/show")
            try:
                bridge_call(load_runtime_config(args), "hud/hide")
            except CliError:
                pass
            return {"name": "overlay", "ok": True, "hint": None}
        except CliError as exc:
            if exc.code in {"PERMISSION_MISSING", "OVERLAY_BLOCKED"} or "OVERLAY_BLOCKED" in str(exc):
                return {"name": "overlay", "ok": False, "hint": "Settings → Apps → AutoTermux → Display over other apps"}
            # Bridge down or unrelated error — keep ambiguous.
            return {"name": "overlay", "ok": None, "hint": f"Could not probe: {exc}"}
    if step == "runtime_permissions":
        state = _setup_runtime_permissions_state(args)
        if not state.get("available"):
            return {"name": "runtime_permissions", "ok": None, "hint": state.get("error")}
        raw = state.get("raw", {})
        # Roll up whichever permission keys exist into a single ok-flag.
        critical = ["sms", "contacts", "callLog", "phone", "storage"]
        missing = []
        for key in critical:
            value = raw.get(key) if isinstance(raw, dict) else None
            if isinstance(value, dict):
                value = value.get("granted")
            if value is False:
                missing.append(key)
        return {
            "name": "runtime_permissions",
            "ok": not missing,
            "missing": missing,
            "hint": None if not missing else f"Grant: {', '.join(missing)} (Settings → Apps → AutoTermux → Permissions)",
        }
    if step == "termux_properties":
        state = _setup_termux_properties_state()
        ok = bool(state.get("allow_external_apps"))
        return {
            "name": "termux_properties",
            "ok": ok,
            "hint": None if ok else f"Add allow-external-apps=true to {state.get('path')}",
            "path": state.get("path"),
        }
    if step == "battery_whitelist":
        brand = _setup_oem_brand()
        # We cannot probe whitelist status reliably without a system permission;
        # we return ok=None and rely on the user to confirm after we open the
        # battery-optimization settings page.
        return {
            "name": "battery_whitelist",
            "ok": None,
            "brand": brand or None,
            "hint": "Confirm both Termux and AutoTermux are exempt from battery optimization on this OEM",
        }
    return {"name": step, "ok": None, "hint": f"Unknown step: {step}"}


def _setup_print(msg: str) -> None:
    sys.stderr.write(msg)
    sys.stderr.flush()


def _setup_run_step(args: argparse.Namespace, step: str) -> dict[str, Any]:
    initial = _setup_probe(args, step)
    if initial.get("ok") is True:
        if not args.headless:
            _setup_print(f"  ✓ {step}: ok\n")
        return {"step": step, "state": "ok", "probe": initial}

    if args.check:
        probe_ok = initial.get("ok")
        if probe_ok is None:
            check_state = "unknown"
            symbol = "?"
        else:
            check_state = "not_ready"
            symbol = "✗"
        if not args.headless:
            _setup_print(f"  {symbol} {step}: {check_state} — {initial.get('hint') or 'see plan'}\n")
        return {"step": step, "state": check_state, "probe": initial}

    # Try to nudge in-place fixes first.
    nudged: dict[str, Any] | None = None
    if step == "companion":
        # Inline broadcast (don't recurse into command_install_companion which
        # would emit its own envelope on stdout and pollute our final report).
        try:
            run_system_am([
                "broadcast",
                "--user", config_android_user(load_runtime_config(args)),
                "--receiver-foreground",
                "-a", AUTOTERMUX_INSTALL_ACTION,
                "-n", AUTOTERMUX_INSTALL_RECEIVER,
            ])
            nudged = {"action": "install-companion"}
        except CliError as exc:
            nudged = {"action": "install-companion", "ok": False, "error": str(exc)}
    elif step == "termux_properties":
        nudged = {"action": "edit-termux.properties", "result": _setup_fix_termux_properties(args)}
    elif step == "accessibility":
        _setup_open_settings(args, "accessibility")
        nudged = {"action": "open-settings:accessibility"}
    elif step == "notification_listener":
        _setup_open_settings(args, "notification_listener")
        nudged = {"action": "open-settings:notification_listener"}
    elif step == "overlay":
        _setup_open_settings(args, "overlay")
        nudged = {"action": "open-settings:overlay"}
    elif step == "runtime_permissions":
        _setup_open_settings(args, "app_details_autotermux")
        nudged = {"action": "open-settings:app_details"}
    elif step == "battery_whitelist":
        _setup_open_settings(args, "battery_optimization_autotermux")
        nudged = {"action": "open-settings:battery_optimization"}

    if not args.headless:
        _setup_print(f"  … {step}: {initial.get('hint') or 'needs your attention'}\n")
        if nudged and "open-settings" in (nudged.get("action") or ""):
            _setup_print("     opened the relevant Settings page. Tap the toggle, then return here.\n")

    # Poll until OK or timeout — non-block-able steps (overlay / battery /
    # runtime perms when we can't probe) require an explicit confirmation.
    deadline = time.monotonic() + args.poll_timeout
    final = initial
    while time.monotonic() < deadline:
        time.sleep(2)
        final = _setup_probe(args, step)
        if final.get("ok") is True:
            break
        if final.get("ok") is None and not args.headless and sys.stdin.isatty() and step in {"overlay", "runtime_permissions", "battery_whitelist"}:
            _setup_print(f"     press ENTER once you've confirmed {step}, or type 'skip' to continue: ")
            try:
                line = sys.stdin.readline().strip().lower()
            except KeyboardInterrupt:
                return {"step": step, "state": "interrupted", "probe": final, "nudge": nudged}
            if line == "skip":
                return {"step": step, "state": "skipped", "probe": final, "nudge": nudged}
            # treat blank line as "I did it, re-probe"
            final = _setup_probe(args, step)
            if final.get("ok") is not False:
                break

    state = "ok" if final.get("ok") is True else ("skipped" if final.get("ok") is None else "not_ready")
    return {"step": step, "state": state, "probe": final, "nudge": nudged}


def command_setup(args: argparse.Namespace) -> int:
    if args.resume and args.resume not in SETUP_STEPS:
        raise CliError(
            f"Unknown --resume step: {args.resume}. Valid: {', '.join(SETUP_STEPS)}",
            code="CLI_ERROR",
        )

    steps_to_run = SETUP_STEPS
    if args.resume:
        idx = SETUP_STEPS.index(args.resume)
        steps_to_run = SETUP_STEPS[idx:]

    if not args.headless:
        _setup_print(f"\ntp-android setup — checking {len(steps_to_run)} prerequisites\n")

    results = []
    all_ok = True
    OK_STATES = {"ok", "skipped", "unknown"}
    for step in steps_to_run:
        result = _setup_run_step(args, step)
        results.append(result)
        if result["state"] not in OK_STATES:
            all_ok = False
            if not args.continue_on_error:
                break

    if not args.headless:
        _setup_print("\n")

    emit_success(
        args,
        {
            "ok": all_ok,
            "steps": results,
            "resume_hint": (
                None
                if all_ok
                else f"tp-android setup --resume {next((r['step'] for r in results if r['state'] not in {'ok', 'skipped'}), '')}".strip()
            ),
        },
        command="setup",
        meta={"ok": all_ok},
    )
    return 0 if all_ok else 1


# ============================================================================
# batch — run a JSONL stream of tp-android commands in a single Python process
# so we pay the import / startup cost once. Each line is `{"op":"sub.command",
# "args":{...}}` and is dispatched through the same argparse tree as the CLI.
# Templates (`{{var}}`) are expanded against --vars before execution.
# ============================================================================

def _batch_render(value: Any, vars_map: dict[str, str]) -> Any:
    if isinstance(value, str):
        out = value
        for k, v in vars_map.items():
            out = out.replace("{{" + k + "}}", v)
        return out
    if isinstance(value, list):
        return [_batch_render(v, vars_map) for v in value]
    if isinstance(value, dict):
        return {k: _batch_render(v, vars_map) for k, v in value.items()}
    return value


def _batch_op_to_argv(op: str, op_args: dict[str, Any]) -> list[str]:
    """Translate {op:"ui.click", args:{text:"x"}} → ["ui", "click", "--text", "x"]."""
    argv = op.split(".")
    for key, value in (op_args or {}).items():
        if value is None or value is False:
            continue
        flag = "--" + key.replace("_", "-")
        if value is True:
            argv.append(flag)
            continue
        if isinstance(value, list):
            for item in value:
                argv.extend([flag, str(item)])
        else:
            argv.extend([flag, str(value)])
    return argv


# ============================================================================
# daemon — keep a Python process resident, dispatch argv over a Unix socket.
# Cuts per-call latency from ~300ms (Python startup) to <10ms (socket RTT).
# When TP_DAEMON_SOCK exists, the regular CLI auto-forwards there in main().
# ============================================================================

DEFAULT_DAEMON_SOCKET = Path(
    os.environ.get("TP_DAEMON_SOCK")
    or (Path(os.environ.get("HOME", "/data/data/com.termux/files/home")) / ".termuxplus" / "tp.sock")
)


def _daemon_recv_message(conn: socket.socket) -> dict[str, Any] | None:
    """Read a length-prefixed JSON message; returns None on closed connection."""
    header = b""
    while len(header) < 4:
        chunk = conn.recv(4 - len(header))
        if not chunk:
            return None
        header += chunk
    size = struct.unpack(">I", header)[0]
    if size > 16 * 1024 * 1024:
        raise ValueError(f"daemon message too large: {size}")
    body = b""
    while len(body) < size:
        chunk = conn.recv(size - len(body))
        if not chunk:
            return None
        body += chunk
    return json.loads(body.decode("utf-8"))


def _daemon_send_message(conn: socket.socket, payload: dict[str, Any]) -> None:
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    conn.sendall(struct.pack(">I", len(body)) + body)


def _daemon_dispatch_in_process(argv: list[str]) -> dict[str, Any]:
    """Run a single argv list through the parser inside this process."""
    import io
    parser = build_parser()
    stdout_buf, stderr_buf = io.StringIO(), io.StringIO()
    saved_out, saved_err = sys.stdout, sys.stderr
    sys.stdout, sys.stderr = stdout_buf, stderr_buf
    exit_code = 0
    try:
        sub_args = parser.parse_args(argv)
        configure_runtime(sub_args)
        exit_code = sub_args.func(sub_args)
    except SystemExit as exc:
        exit_code = int(exc.code) if isinstance(exc.code, int) else 1
    except CliError as exc:
        emit_error(str(exc), None, code=exc.code, hint=exc.hint, recoverable=exc.recoverable, details=exc.details)
        exit_code = 1
    except Exception as exc:
        emit_error(f"daemon dispatch error: {exc}", None, code="CLI_ERROR")
        exit_code = 1
    finally:
        sys.stdout, sys.stderr = saved_out, saved_err
    return {
        "exit_code": exit_code,
        "stdout": stdout_buf.getvalue(),
        "stderr": stderr_buf.getvalue(),
    }


def _daemon_run_server(socket_path: Path, *, silent: bool = False) -> int:
    if socket_path.exists():
        # Stale socket? Check if anyone listens.
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        probe.settimeout(0.5)
        try:
            probe.connect(str(socket_path))
            probe.close()
            raise CliError(f"daemon already running at {socket_path}", code="CLI_ERROR")
        except OSError:
            try:
                socket_path.unlink()
            except OSError:
                pass

    socket_path.parent.mkdir(parents=True, exist_ok=True)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(str(socket_path))
    os.chmod(str(socket_path), 0o600)
    srv.listen(8)

    pid_file = socket_path.with_suffix(socket_path.suffix + ".pid")
    pid_file.write_text(str(os.getpid()), encoding="utf-8")

    if not silent:
        sys.stderr.write(f"tp-android daemon listening at {socket_path} (pid={os.getpid()})\n")
        sys.stderr.flush()

    stop_requested = False
    while not stop_requested:
        try:
            conn, _addr = srv.accept()
        except KeyboardInterrupt:
            break
        try:
            msg = _daemon_recv_message(conn)
            if msg is None:
                conn.close()
                continue
            if msg.get("op") == "shutdown":
                _daemon_send_message(conn, {"ok": True, "shutting_down": True})
                conn.close()
                stop_requested = True
                break
            if msg.get("op") == "ping":
                _daemon_send_message(conn, {"ok": True, "pid": os.getpid()})
                conn.close()
                continue
            argv = msg.get("argv") or []
            env = msg.get("env") or {}
            saved_env = {k: os.environ.get(k) for k in env.keys()}
            for k, v in env.items():
                os.environ[k] = str(v)
            try:
                result = _daemon_dispatch_in_process(list(argv))
            finally:
                for k, v in saved_env.items():
                    if v is None:
                        os.environ.pop(k, None)
                    else:
                        os.environ[k] = v
            _daemon_send_message(conn, result)
        except Exception as exc:
            try:
                _daemon_send_message(conn, {"exit_code": 1, "stderr": f"daemon error: {exc}\n", "stdout": ""})
            except OSError:
                pass
        finally:
            try:
                conn.close()
            except OSError:
                pass

    try:
        srv.close()
    finally:
        try:
            socket_path.unlink()
        except OSError:
            pass
        try:
            pid_file.unlink()
        except OSError:
            pass
    return 0


def _daemon_send(socket_path: Path, message: dict[str, Any], timeout: float = 30.0) -> dict[str, Any]:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    sock.connect(str(socket_path))
    try:
        _daemon_send_message(sock, message)
        response = _daemon_recv_message(sock)
        if response is None:
            raise CliError("daemon closed connection without responding", code="BRIDGE_PARSE_FAILED")
        return response
    finally:
        sock.close()


def command_daemon_start(args: argparse.Namespace) -> int:
    socket_path = Path(args.socket) if args.socket else DEFAULT_DAEMON_SOCKET
    if args.foreground:
        return _daemon_run_server(socket_path)
    pid = os.fork()
    if pid == 0:
        # Child: fully detach. Must close stderr too — otherwise the parent
        # shell's `cmd 2>&1 | tee log` pipeline keeps the read side open
        # waiting for the child's stderr to close, hanging indefinitely.
        os.setsid()
        devnull_in = os.open(os.devnull, os.O_RDONLY)
        devnull_out = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull_in, 0)
        os.dup2(devnull_out, 1)
        os.dup2(devnull_out, 2)
        sys.stdin = os.fdopen(0, "r")
        sys.stdout = os.fdopen(1, "w")
        sys.stderr = os.fdopen(2, "w")
        try:
            _daemon_run_server(socket_path, silent=True)
        except Exception:
            pass
        os._exit(0)
    # Parent: wait briefly for socket file to appear before emitting envelope
    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline and not socket_path.exists():
        time.sleep(0.1)
    emit_success(
        args,
        {"socket": str(socket_path), "pid": pid, "started": socket_path.exists()},
        command="daemon.start",
    )
    return 0


def command_daemon_stop(args: argparse.Namespace) -> int:
    socket_path = Path(args.socket) if args.socket else DEFAULT_DAEMON_SOCKET
    if not socket_path.exists():
        emit_success(args, {"socket": str(socket_path), "status": "not_running"}, command="daemon.stop")
        return 0
    try:
        result = _daemon_send(socket_path, {"op": "shutdown"})
    except (OSError, CliError) as exc:
        # Stale socket — clean up
        try:
            socket_path.unlink()
        except OSError:
            pass
        emit_success(args, {"socket": str(socket_path), "status": "stale_cleaned", "error": str(exc)}, command="daemon.stop")
        return 0
    emit_success(args, {"socket": str(socket_path), "status": "stopped", "result": result}, command="daemon.stop")
    return 0


def command_daemon_status(args: argparse.Namespace) -> int:
    socket_path = Path(args.socket) if args.socket else DEFAULT_DAEMON_SOCKET
    if not socket_path.exists():
        emit_success(args, {"socket": str(socket_path), "running": False}, command="daemon.status")
        return 0
    try:
        result = _daemon_send(socket_path, {"op": "ping"}, timeout=2.0)
        emit_success(args, {"socket": str(socket_path), "running": True, "pong": result}, command="daemon.status")
        return 0
    except (OSError, CliError) as exc:
        emit_success(args, {"socket": str(socket_path), "running": False, "error": str(exc)}, command="daemon.status")
        return 1


def _maybe_forward_to_daemon(argv: list[str]) -> int | None:
    """Auto-forward to a running daemon. Returns exit code if forwarded, else None.

    Skipped for argv that touch the daemon itself, and for batch (which already
    runs everything in a single process).
    """
    if not argv:
        return None
    if os.environ.get("TP_NO_DAEMON") in {"1", "true", "yes", "on"}:
        return None
    first = argv[0]
    if first in {"daemon", "batch"}:
        return None
    if "--no-daemon" in argv:
        return None
    socket_env = os.environ.get("TP_DAEMON_SOCK")
    socket_path = Path(socket_env) if socket_env else DEFAULT_DAEMON_SOCKET
    if not socket_path.exists():
        return None
    try:
        result = _daemon_send(
            socket_path,
            {"argv": argv, "env": {k: v for k, v in os.environ.items() if k.startswith("TP_") or k in {"HOME", "PREFIX"}}},
        )
    except (OSError, CliError):
        return None
    sys.stdout.write(result.get("stdout") or "")
    sys.stderr.write(result.get("stderr") or "")
    sys.stdout.flush()
    sys.stderr.flush()
    return int(result.get("exit_code") or 0)


def command_batch(args: argparse.Namespace) -> int:
    vars_map: dict[str, str] = {}
    for kv in args.vars or []:
        if "=" not in kv:
            raise CliError(f"--vars must be KEY=VALUE, got {kv!r}", code="CLI_ERROR")
        k, v = kv.split("=", 1)
        vars_map[k] = v

    source: Any
    if args.script and args.script != "-":
        source = open(args.script, "r", encoding="utf-8")
    else:
        source = sys.stdin

    parser = build_parser()
    results: list[dict[str, Any]] = []
    exit_code = 0

    try:
        for line_no, raw_line in enumerate(source, start=1):
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            try:
                op_obj = json.loads(line)
            except json.JSONDecodeError as exc:
                payload = {"line": line_no, "ok": False, "error": f"JSON parse: {exc}"}
                results.append(payload)
                if args.on_error == "abort":
                    exit_code = 1
                    break
                if args.on_error == "stop":
                    exit_code = 1
                    break
                continue

            if not isinstance(op_obj, dict) or "op" not in op_obj:
                results.append({"line": line_no, "ok": False, "error": "expected {op: ..., args: {...}}"})
                if args.on_error in {"stop", "abort"}:
                    exit_code = 1
                    break
                continue

            op = op_obj["op"]
            op_args = _batch_render(op_obj.get("args") or {}, vars_map)
            argv = _batch_op_to_argv(op, op_args)

            # Capture stdout/stderr per op so the outer JSONL stream stays clean.
            import io
            stdout_buf = io.StringIO()
            stderr_buf = io.StringIO()
            saved_stdout, saved_stderr = sys.stdout, sys.stderr
            sys.stdout = stdout_buf
            sys.stderr = stderr_buf
            op_exit = 0
            try:
                sub_args = parser.parse_args(argv)
                configure_runtime(sub_args)
                op_exit = sub_args.func(sub_args)
            except SystemExit as se:
                op_exit = int(se.code) if isinstance(se.code, int) else 1
            except CliError as exc:
                emit_error(str(exc), sub_args if 'sub_args' in dir() else None,
                          code=exc.code, hint=exc.hint, recoverable=exc.recoverable, details=exc.details)
                op_exit = 1
            except Exception as exc:
                emit_error(f"batch op {op} unexpected: {exc}", None, code="CLI_ERROR")
                op_exit = 1
            finally:
                sys.stdout = saved_stdout
                sys.stderr = saved_stderr

            envelope_stdout = stdout_buf.getvalue().strip()
            envelope_stderr = stderr_buf.getvalue().strip()
            parsed_envelope: Any = None
            for blob in (envelope_stdout, envelope_stderr):
                if not blob:
                    continue
                try:
                    parsed_envelope = json.loads(blob.splitlines()[0])
                    break
                except json.JSONDecodeError:
                    continue

            results.append({
                "line": line_no,
                "op": op,
                "ok": op_exit == 0,
                "exit_code": op_exit,
                "envelope": parsed_envelope,
                "stdout": envelope_stdout if parsed_envelope is None else None,
                "stderr": envelope_stderr if parsed_envelope is None else None,
            })

            # Stream results immediately so observers can follow progress.
            print_json(results[-1], compact=True)

            if op_exit != 0:
                if args.on_error == "abort":
                    exit_code = op_exit
                    break
                if args.on_error == "stop":
                    exit_code = op_exit
                    break
                # continue: keep going
    finally:
        if source is not sys.stdin:
            source.close()

    summary = {
        "ok": exit_code == 0,
        "ran": len(results),
        "failed": sum(1 for r in results if not r.get("ok")),
        "on_error": args.on_error,
    }
    emit_success(args, summary, command="batch", meta={"ok": summary["ok"]})
    return exit_code


# ============================================================================
# exec-script — a tiny declarative DSL on top of the CLI. Each step is one of
# {find_click, click_idx, wait, type, key, scroll, intervene, sleep, done}.
# Designed so an LLM can emit a sequence as a single artifact instead of N
# separate shell invocations. Steps execute in-process (so we get the daemon
# speed-up for free if the daemon is running).
# ============================================================================

EXEC_SCRIPT_KINDS = {"find_click", "click_idx", "wait", "type", "key", "scroll", "intervene", "ask_input", "confirm", "sleep", "screenshot", "done"}


def _exec_script_load(path: str) -> list[dict[str, Any]]:
    if path == "-":
        raw = sys.stdin.read()
    else:
        raw = Path(path).read_text(encoding="utf-8")
    raw = raw.strip()
    if not raw:
        return []
    # Try YAML first if pyyaml is installed, else JSON.
    try:
        import yaml  # type: ignore
        parsed = yaml.safe_load(raw)
    except ImportError:
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise CliError(
                f"exec-script needs YAML or JSON. JSON parse failed: {exc}",
                code="CLI_ERROR",
                hint="pip install pyyaml for YAML support, or pass a JSON array",
            ) from exc
    except Exception as exc:
        raise CliError(f"exec-script parse failed: {exc}", code="CLI_ERROR") from exc

    if not isinstance(parsed, list):
        raise CliError("exec-script must be a list of step objects", code="CLI_ERROR")
    return parsed


def _exec_step_to_argv(step: dict[str, Any]) -> list[str]:
    kind = step.get("kind") or step.get("op")
    if kind not in EXEC_SCRIPT_KINDS:
        raise CliError(f"Unknown exec-script step kind: {kind!r}; expected one of {sorted(EXEC_SCRIPT_KINDS)}", code="CLI_ERROR")

    if kind == "find_click":
        argv = ["ui", "click"]
        for key in ("text", "text-contains", "desc", "desc-contains", "resource-id", "class-name"):
            v = step.get(key) or step.get(key.replace("-", "_"))
            if v is not None:
                argv.extend([f"--{key}", str(v)])
        if step.get("package"):
            argv.extend(["--package", step["package"]])
        if step.get("expect_text") or step.get("expect-text"):
            argv.extend(["--expect-text", str(step.get("expect_text") or step.get("expect-text"))])
        if step.get("verify_timeout") or step.get("verify-timeout"):
            argv.extend(["--verify-timeout", str(step.get("verify_timeout") or step.get("verify-timeout"))])
        return argv
    if kind == "click_idx":
        return ["ui", "click", "--idx", str(step["idx"])]
    if kind == "wait":
        argv = ["ui", "wait"]
        for key in ("text", "text-contains", "package"):
            v = step.get(key) or step.get(key.replace("-", "_"))
            if v is not None:
                argv.extend([f"--{key}", str(v)])
        if step.get("gone"):
            argv.append("--gone")
        if step.get("change"):
            argv.append("--change")
        if step.get("tree_changed") or step.get("tree-changed"):
            argv.append("--tree-changed")
        if step.get("keyboard"):
            argv.extend(["--keyboard", str(step["keyboard"])])
        if step.get("timeout"):
            argv.extend(["--wait-timeout", str(step["timeout"])])
        return argv
    if kind == "type":
        argv = ["input", "text"]
        if step.get("clear"):
            argv.append("--clear")
        argv.append(str(step.get("text", "")))
        return argv
    if kind == "key":
        return ["input", "key", str(step["name"])]
    if kind == "scroll":
        argv = ["ui", "action", "scroll-forward" if step.get("direction", "forward") == "forward" else "scroll-backward"]
        if step.get("package"):
            argv.extend(["--package", step["package"]])
        if step.get("scrollable"):
            argv.append("--scrollable")
        return argv
    if kind == "intervene":
        argv = ["status", "intervene", "--reason", str(step.get("reason", "needs human"))]
        if step.get("choices"):
            choices = step["choices"]
            if isinstance(choices, list):
                choices = ",".join(str(c) for c in choices)
            argv.extend(["--choices", str(choices)])
        if step.get("timeout"):
            argv.extend(["--wait-timeout", str(step["timeout"])])
        return argv
    if kind == "ask_input":
        argv = ["status", "ask-input", "--prompt", str(step.get("prompt", "input?"))]
        if step.get("kind_input"):
            argv.extend(["--kind", str(step["kind_input"])])
        if step.get("timeout"):
            argv.extend(["--wait-timeout", str(step["timeout"])])
        return argv
    if kind == "confirm":
        argv = ["status", "confirm", "--prompt", str(step.get("prompt", "confirm?"))]
        if step.get("timeout"):
            argv.extend(["--wait-timeout", str(step["timeout"])])
        return argv
    if kind == "sleep":
        # Implemented inline (no subcommand to dispatch).
        time.sleep(float(step.get("seconds", 0.5)))
        return []
    if kind == "screenshot":
        argv = ["ui", "screenshot", "-o", str(step.get("output", "/sdcard/Download/screen.png"))]
        if step.get("annotate"):
            argv.extend(["--annotate", str(step["annotate"])])
        return argv
    if kind == "done":
        return ["status", "finish", "--state", str(step.get("state", "success"))]
    return []


def command_exec_script(args: argparse.Namespace) -> int:
    steps = _exec_script_load(args.script)
    if not steps:
        emit_success(args, {"ran": 0, "ok": True}, command="exec-script")
        return 0

    vars_map: dict[str, str] = {}
    for kv in args.vars or []:
        if "=" not in kv:
            raise CliError(f"--vars must be KEY=VALUE, got {kv!r}", code="CLI_ERROR")
        k, v = kv.split("=", 1)
        vars_map[k] = v

    # Auto-wrap with status if --task is set
    auto_wrap = bool(args.task)
    run_id: str | None = None
    if auto_wrap:
        wrap_args = ["status", "start", "--task", args.task, "--total-steps", str(len([s for s in steps if (s.get("kind") or s.get("op")) != "sleep"]))]
        if args.notify:
            wrap_args.append("--notify")
        if args.hud:
            wrap_args.append("--hud")
        result = _daemon_dispatch_in_process(wrap_args)
        envelope = _exec_parse_envelope(result.get("stdout") or "")
        if isinstance(envelope, dict) and isinstance(envelope.get("result"), dict):
            run_id = envelope["result"].get("run_id")

    ok = True
    ran = 0
    failed_step: dict[str, Any] | None = None
    for index, raw_step in enumerate(steps, start=1):
        if not isinstance(raw_step, dict):
            continue
        step = _batch_render(raw_step, vars_map)
        if auto_wrap and (step.get("kind") or step.get("op")) != "done":
            _daemon_dispatch_in_process([
                "status", "step",
                "--step", str(index),
                "--label", str(step.get("label") or step.get("kind") or "step"),
                "--state", "running",
            ])
        argv = _exec_step_to_argv(step)
        if not argv:
            ran += 1
            continue
        result = _daemon_dispatch_in_process(argv)
        sys.stdout.write(result.get("stdout") or "")
        sys.stderr.write(result.get("stderr") or "")
        ran += 1
        if result.get("exit_code", 0) != 0:
            ok = False
            failed_step = {"index": index, "step": step, "result": result}
            if args.on_error == "stop":
                break

    if auto_wrap:
        finish_state = "success" if ok else "error"
        _daemon_dispatch_in_process(["status", "finish", "--state", finish_state])

    emit_success(
        args,
        {"ok": ok, "ran": ran, "total": len(steps), "run_id": run_id, "failed_step": failed_step},
        command="exec-script",
        meta={"ok": ok},
    )
    return 0 if ok else 1


def _exec_parse_envelope(stdout: str) -> Any:
    for line in stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            continue
    return None


def command_hud_show(args: argparse.Namespace) -> int:
