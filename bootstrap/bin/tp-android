def command_screen_keep_awake_status(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    if config_transport(config) == "bridge":
        try:
            result = bridge_broadcast(config, "SCREEN_KEEP_AWAKE_STATUS")
        except CliError:
            result = portal_post("/screen/keepAwake/status", args, {})
    else:
        result = portal_post("/screen/keepAwake/status", args, {})
    emit_success(args, result)
    return 0


def command_screen_keep_awake_set(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    if config_transport(config) == "bridge":
        try:
            result = bridge_broadcast(
                config,
                "TOGGLE_SCREEN_KEEP_AWAKE",
                ["--ez", "enabled", "true" if args.enabled else "false"],
            )
        except CliError:
            result = portal_post("/screen/keepAwake/set", args, {"enabled": args.enabled})
    else:
        result = portal_post("/screen/keepAwake/set", args, {"enabled": args.enabled})
    emit_success(args, result)
    return 0


