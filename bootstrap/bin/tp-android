    result = portal_post("/node/focused", args, {})
    emit_success(args, result, command=getattr(args, "command_path", "ui.focused"))
    return 0


def flatten_ui_nodes(value: Any) -> list[dict[str, Any]]:
    nodes: list[dict[str, Any]] = []
    if isinstance(value, str):
        try:
            decoded = json.loads(value)
        except json.JSONDecodeError:
            return nodes
        return flatten_ui_nodes(decoded)
    if isinstance(value, dict):
        tree = value.get("a11y_tree", value)
        if isinstance(tree, list):
            for item in tree:
                nodes.extend(flatten_ui_nodes(item))
        elif isinstance(tree, dict):
            nodes.append(tree)
            children = tree.get("children")
            if isinstance(children, list):
                for child in children:
                    nodes.extend(flatten_ui_nodes(child))
    elif isinstance(value, list):
        for item in value:
            nodes.extend(flatten_ui_nodes(item))
    return nodes


def ui_node_text(node: dict[str, Any], key: str) -> str:
    value = node.get(key)
    return "" if value is None else str(value)


def ui_node_bool(node: dict[str, Any], *keys: str) -> bool:
    for key in keys:
        value = node.get(key)
        if isinstance(value, bool):
            return value
    return False


def ui_node_matches(args: argparse.Namespace, node: dict[str, Any]) -> bool:
    if getattr(args, "index", None) is not None and int(node.get("index", -1)) != args.index:
        return False
    if getattr(args, "text", None) is not None and ui_node_text(node, "text") != args.text:
        return False
    if getattr(args, "text_contains", None) is not None and args.text_contains.lower() not in ui_node_text(node, "text").lower():
        return False
    if getattr(args, "desc", None) is not None and ui_node_text(node, "contentDescription") != args.desc:
        return False
    if getattr(args, "desc_contains", None) is not None and args.desc_contains.lower() not in ui_node_text(node, "contentDescription").lower():
        return False
    if getattr(args, "resource_id", None) is not None and ui_node_text(node, "resourceId") != args.resource_id:
        return False
    if getattr(args, "class_name", None) is not None and args.class_name.lower() not in ui_node_text(node, "className").lower():
        return False
    if getattr(args, "scrollable", None) is not None and ui_node_bool(node, "isScrollable", "scrollable") != args.scrollable:
        return False
    return True


def require_ui_selector(args: argparse.Namespace) -> None:
    if any(getattr(args, name, None) is not None for name in ("index", "text", "text_contains", "desc", "desc_contains", "resource_id", "class_name", "scrollable")):
        return
    raise CliError("At least one selector is required: --index, --text, --text-contains, --desc, --desc-contains, --resource-id, --class-name, or --scrollable")


def get_scoped_ui_state(args: argparse.Namespace, *, full: bool) -> Any:
    payload = scoped_ui_payload(args, {"filter": getattr(args, "filter", True)})
    if getattr(args, "package", None):
        return portal_post("/state_full" if full else "/state", args, payload)
    path = "/state_full" if full else "/state"
    if full and getattr(args, "filter", True) is False:
        path += "?filter=false"
    return portal_get(path, args)


def ui_node_visible_strings(node: dict[str, Any]) -> list[str]:
    values: list[str] = []
    for key in ("text", "contentDescription", "hint", "stateDescription"):
        value = node.get(key)
        if value is not None:
            text = str(value)
            if text:
                values.append(text)
    return values


def ui_state_has_text(args: argparse.Namespace, *, exact: str | None, contains: str | None) -> tuple[bool, dict[str, Any]]:
    state = get_scoped_ui_state(args, full=False)
    nodes = flatten_ui_nodes(state)
    for node in nodes:
        values = ui_node_visible_strings(node)
        if exact is not None and any(value == exact for value in values):
            return True, {"count": len(nodes), "node": node}
        if contains is not None:
            folded = contains.lower()
            if any(folded in value.lower() for value in values):
                return True, {"count": len(nodes), "node": node}
    return False, {"count": len(nodes)}


def verify_after_ui_action(args: argparse.Namespace) -> dict[str, Any] | None:
    expected_package = getattr(args, "expect_package", None)
    expected_activity = getattr(args, "expect_activity", None)
    expected_text = getattr(args, "expect_text", None)
    expected_text_contains = getattr(args, "expect_text_contains", None)
    if not any((expected_package, expected_activity, expected_text, expected_text_contains)):
        return None

    timeout = max(0.0, getattr(args, "verify_timeout", 5.0))
    interval = max(0.05, getattr(args, "verify_interval", 0.25))
    deadline = time.monotonic() + timeout
    last_state: dict[str, Any] = {}
    last_text_probe: dict[str, Any] = {}

    while True:
        checks: dict[str, bool] = {}
        if expected_package or expected_activity:
            last_state = current_phone_state(args)
            if expected_package:
                checks["package"] = phone_state_field(last_state, "packageName", "package_name") == expected_package
            if expected_activity:
                checks["activity"] = phone_state_field(last_state, "activityName", "activity_name") == expected_activity
        if expected_text or expected_text_contains:
            matched_text, last_text_probe = ui_state_has_text(
                args,
                exact=expected_text,
                contains=expected_text_contains,
            )
            checks["text"] = matched_text

        if checks and all(checks.values()):
            return {
                "matched": True,
                "checks": checks,
                "state": last_state,
                "text_probe": last_text_probe,
            }
        if time.monotonic() >= deadline:
            details = {
                "matched": False,
                "checks": checks,
                "expectedPackage": expected_package,
                "expectedActivity": expected_activity,
                "expectedText": expected_text,
                "expectedTextContains": expected_text_contains,
                "state": last_state,
                "text_probe": last_text_probe,
            }
            raise CliError(f"UI action verification failed after {timeout:g}s: {json.dumps(details, ensure_ascii=False, separators=(',', ':'))}")
        time.sleep(interval)


def target_selector_namespace(args: argparse.Namespace) -> argparse.Namespace:
    return argparse.Namespace(
        index=getattr(args, "target_index", None),
        text=getattr(args, "target_text", None),
        text_contains=getattr(args, "target_text_contains", None),
        desc=getattr(args, "target_desc", None),
        desc_contains=getattr(args, "target_desc_contains", None),
        resource_id=getattr(args, "target_resource_id", None),
        class_name=getattr(args, "target_class_name", None),
        scrollable=None,
    )


def command_ui_wait(args: argparse.Namespace) -> int:
    require_ui_selector(args)
    deadline = time.monotonic() + args.timeout_seconds
    last_count = 0
    while True:
        state = get_scoped_ui_state(args, full=args.full)
        nodes = flatten_ui_nodes(state)
        last_count = len(nodes)
        match = next((node for node in nodes if ui_node_matches(args, node)), None)
        if args.gone and match is None:
            emit_success(
                args,
                {"matched": False, "gone": True, "count": last_count},
                command=getattr(args, "command_path", "ui.wait"),
            )
            return 0
        if not args.gone and match is not None:
            emit_success(
                args,
                {"matched": True, "node": match, "count": last_count},
                command=getattr(args, "command_path", "ui.wait"),
            )
            return 0
        if time.monotonic() >= deadline:
            condition = "disappear" if args.gone else "appear"
            raise CliError(f"Timed out waiting for UI selector to {condition} after {args.timeout_seconds:g}s (nodes={last_count})")
        time.sleep(args.interval)


def command_ui_scroll_until(args: argparse.Namespace) -> int:
    target = target_selector_namespace(args)
    require_ui_selector(target)
    scroll_action = "scroll-forward" if args.direction == "forward" else "scroll-backward"
    scroll_payload: dict[str, Any] = {"action": scroll_action}
    for arg_name, payload_name in (
        ("index", "index"),
        ("text", "text"),
        ("text_contains", "textContains"),
        ("desc", "desc"),
        ("desc_contains", "descContains"),
        ("resource_id", "resourceId"),
        ("class_name", "className"),
        ("scrollable", "scrollable"),
    ):
        value = getattr(args, arg_name, None)
        if value is not None:
            scroll_payload[payload_name] = value
    if getattr(args, "package", None):
        scroll_payload["packageName"] = args.package
    if not any(key in scroll_payload for key in ("index", "text", "textContains", "desc", "descContains", "resourceId", "className", "scrollable")):
        scroll_payload["scrollable"] = True

    last_count = 0
    last_scroll_result: Any = None
    for scrolls in range(args.max_scrolls + 1):
        state = get_scoped_ui_state(args, full=args.full)
        nodes = flatten_ui_nodes(state)
        last_count = len(nodes)
        match = next((node for node in nodes if ui_node_matches(target, node)), None)
        if match is not None:
            emit_success(
                args,
                {
                    "matched": True,
                    "node": match,
                    "count": last_count,
                    "scrolls": scrolls,
                    "last_scroll": last_scroll_result,
                },
                command=getattr(args, "command_path", "ui.scroll-until"),
            )
            return 0
        if scrolls == args.max_scrolls:
            break
        last_scroll_result = portal_post("/node/action", args, scroll_payload)
        time.sleep(args.settle)
    raise CliError(f"Timed out scrolling for UI selector after {args.max_scrolls} scrolls (nodes={last_count})")


def command_screenshot(args: argparse.Namespace) -> int:
    result = portal_post("/screenshot/cache", args, {"hideOverlay": args.hide_overlay})
    if not isinstance(result, dict) or not isinstance(result.get("path"), str):
        raise CliError("Unexpected screenshot cache response")
    cache_path = result["path"]
    bytes_written = copy_transfer_cache_to_output(cache_path, args.output, args)
    if args.output == "-":
        return 0
    emit_success(
        args,
        {"path": str(Path(args.output)), "bytes": bytes_written, "cache_path": cache_path},
        command=getattr(args, "command_path", "ui.screenshot"),
    )
    return 0


