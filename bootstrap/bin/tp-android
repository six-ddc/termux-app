def command_storage_get(args: argparse.Namespace) -> int:
    payload = {
        "mime": args.mime,
        "timeoutMs": int(args.timeout_seconds * 1000),
    }
    result = termux_api_call(args, "storage-get", payload)
    if args.output:
        if not isinstance(result, dict) or "path" not in result:
            raise CliError("Unexpected storage-get response")
        bytes_written = copy_transfer_cache_to_output(result["path"], args.output, args)
        emit_success(
            args,
            {
                "path": str(Path(args.output)),
                "bytes": bytes_written,
                "cache_path": result["path"],
                "uri": result.get("uri", ""),
                "displayName": result.get("displayName", ""),
                "mimeType": result.get("mimeType", ""),
            },
            command="storage.get",
        )
        return 0
    emit_success(args, result, command="storage.get")
    return 0


