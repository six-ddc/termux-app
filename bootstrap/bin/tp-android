def command_screen_record_start(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {}
    if getattr(args, "max_duration", None) is not None:
        payload["maxDurationMs"] = args.max_duration
    if getattr(args, "bit_rate", None) is not None:
        payload["bitRate"] = args.bit_rate
    if getattr(args, "frame_rate", None) is not None:
        payload["frameRate"] = args.frame_rate
    if getattr(args, "include_mic", False):
        payload["includeMic"] = True
    result = portal_post("/screen/record/start", args, payload)
    emit_success(args, result, command=getattr(args, "command_path", "screen.record.start"))
    return 0


