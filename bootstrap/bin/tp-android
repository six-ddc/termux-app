def termux_api_payload(args: argparse.Namespace, base: dict[str, Any] | None = None) -> dict[str, Any]:
    payload = dict(base or {})
    command = getattr(args, "termux_api_command", "")
    api_args = extract_termux_api_cli_options(args, list(getattr(args, "api_args", []) or []))
    if "args" in payload:
        payload["args"] = api_args
    if getattr(args, "cache", False):
        payload["cache"] = True
    if command and (api_args or command in TERMUX_API_PARSE_EMPTY_COMMANDS):
        payload.update(parse_termux_api_script_args(command, list(api_args)))
    if hasattr(args, "data"):
        payload.update(parse_json_input(args.data))
    if hasattr(args, "param"):
        payload.update(parse_key_values(args.param))
    if getattr(args, "cache", False):
        payload["cache"] = True
    return payload


def extract_termux_api_cli_options(args: argparse.Namespace, api_args: list[str]) -> list[str]:
    """Allow tp-android flags after the official termux-api command arguments."""
    script_args: list[str] = []
    index = 0
    param_values = list(getattr(args, "param", []) or [])
    while index < len(api_args):
        item = api_args[index]
        if item == "--":
            index += 1
            continue
        if item == "--cache":
            setattr(args, "cache", True)
        elif item in ("--json", "--compact"):
            setattr(args, "output_format", "json")
        elif item == "--pretty":
            setattr(args, "output_format", "pretty")
        elif item == "--raw":
            setattr(args, "output_format", "raw")
        elif item == "--quiet":
            setattr(args, "output_format", "none")
        elif item == "--format" and index + 1 < len(api_args):
            setattr(args, "output_format", api_args[index + 1])
            index += 1
        elif item.startswith("--format="):
            setattr(args, "output_format", item.split("=", 1)[1])
        elif item == "--data" and index + 1 < len(api_args):
            setattr(args, "data", api_args[index + 1])
            index += 1
        elif item.startswith("--data="):
            setattr(args, "data", item.split("=", 1)[1])
        elif item in ("-p", "--param") and index + 1 < len(api_args):
            param_values.append(api_args[index + 1])
            index += 1
        elif item.startswith("--param="):
            param_values.append(item.split("=", 1)[1])
        elif item in ("--config", "--base-url", "--authority", "--user", "--token", "--transport", "--timeout") and index + 1 < len(api_args):
            setattr(args, item[2:].replace("-", "_"), api_args[index + 1])
            index += 1
        elif item.startswith(("--config=", "--base-url=", "--authority=", "--user=", "--token=", "--transport=", "--timeout=")):
            key, value = item[2:].split("=", 1)
            setattr(args, key.replace("-", "_"), value)
        else:
            script_args.append(item)
        index += 1
    if param_values:
        setattr(args, "param", param_values)
    return script_args


class NonExitingArgParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise CliError(message)


def termux_script_parser(command: str) -> NonExitingArgParser:
    return NonExitingArgParser(prog=f"termux-{command}", add_help=False)


def parse_termux_api_script_args(command: str, argv: list[str]) -> dict[str, Any]:
    """Translate official termux-api script-style args into bridge JSON params."""
    if not argv and command not in TERMUX_API_PARSE_EMPTY_COMMANDS:
        return {}
    if argv and argv[0] == "--":
        argv = argv[1:]
    try:
        return _parse_termux_api_script_args(command, argv)
    except CliError:
        raise
    except Exception as exc:
        raise CliError(f"Could not parse termux-{command} arguments: {exc}") from exc


def _parse_termux_api_script_args(command: str, argv: list[str]) -> dict[str, Any]:
    p = termux_script_parser(command)

    if command == "brightness":
        value = argv[0]
        return {"auto": value == "auto"} if value == "auto" else {"brightness": int(value)}
    if command == "volume":
        return {"stream": argv[0], "volume": int(argv[1])} if len(argv) >= 2 else {}
    if command in ("torch", "wifi-enable"):
        return {"enabled": parse_bool(argv[0])}
    if command == "clipboard-set":
        text = " ".join(argv)
        if not text and not sys.stdin.isatty():
            text = sys.stdin.read()
        return {"text": text}
    if command == "telephony-call":
        return {"number": argv[0], "direct": True}
    if command == "notification-remove":
        return {"id": int(argv[0])}
    if command in ("saf-ls", "saf-stat", "saf-read", "saf-rm"):
        return {"uri" if command != "saf-ls" else "treeuri": argv[0]}
    if command == "saf-write":
        return {"uri": argv[0]}
    if command == "saf-mkdir":
        return {"treeuri": argv[0], "filename": argv[1]}
    if command == "storage-get":
        return {"output": argv[0]}

    if command == "dialog":
        widgets = {"confirm", "checkbox", "counter", "date", "radio", "sheet", "spinner", "speech", "text", "time"}
        widget = "text"
        rest = list(argv)
        if rest and rest[0] in widgets:
            widget = rest[0]
            rest = rest[1:]
        p.add_argument("-i", dest="hint")
        p.add_argument("-m", dest="multiple_lines", action="store_true")
        p.add_argument("-p", dest="password", action="store_true")
        p.add_argument("-n", dest="numeric", action="store_true")
        p.add_argument("-t", dest="title")
        p.add_argument("-d", dest="date_format")
        p.add_argument("-v", dest="values")
        p.add_argument("-r", dest="range")
        ns = p.parse_args(rest)
        out: dict[str, Any] = {"input_method": widget, "widget": widget}
        if ns.hint:
            out["input_hint"] = ns.hint
            out["hint"] = ns.hint
        if ns.title:
            out["input_title"] = ns.title
            out["title"] = ns.title
        if ns.date_format:
            out["date_format"] = ns.date_format
        if ns.values:
            out["input_values"] = ns.values
        if ns.range:
            out["input_range"] = ns.range
        if ns.multiple_lines:
            out["multiple_lines"] = True
        if ns.password:
            out["password"] = True
        if ns.numeric:
            out["numeric"] = True
        return out

    if command == "call-log":
        p.add_argument("-l", dest="limit", type=int, default=10)
        p.add_argument("-o", dest="offset", type=int, default=0)
        ns = p.parse_args(argv)
        return {"limit": ns.limit, "offset": ns.offset}
    if command == "camera-photo":
        p.add_argument("-c", dest="camera", default="")
        p.add_argument("output", nargs="?")
        ns = p.parse_args(argv)
        out: dict[str, Any] = {}
        if ns.camera:
            out["camera"] = ns.camera
        if ns.output:
            out["output"] = ns.output
        return out
    if command == "download":
        p.add_argument("-d", dest="description")
        p.add_argument("-t", dest="title")
        p.add_argument("-p", dest="path")
        p.add_argument("url")
        ns = p.parse_args(argv)
        return {k: v for k, v in {"url": ns.url, "description": ns.description, "title": ns.title, "path": ns.path}.items() if v}
    if command == "fingerprint":
        p.add_argument("-t", dest="title")
        p.add_argument("-d", dest="description")
        p.add_argument("-s", dest="subtitle")
        p.add_argument("-c", dest="cancel")
        ns = p.parse_args(argv)
        return {k: v for k, v in vars(ns).items() if v}
    if command == "infrared-transmit":
        p.add_argument("-f", dest="frequency", type=int, required=True)
        p.add_argument("pattern")
        ns = p.parse_args(argv)
        return {"frequency": ns.frequency, "pattern": ns.pattern}
    if command == "location":
        p.add_argument("-p", dest="provider", default="gps")
        p.add_argument("-r", dest="request", default="once")
        ns = p.parse_args(argv)
        return {"provider": ns.provider, "request": ns.request}
    if command == "media-player":
        p.add_argument("action", nargs="?", default="info")
        p.add_argument("source", nargs="?")
        ns = p.parse_args(argv)
        out = {"action": ns.action}
        if ns.source:
            out["source"] = ns.source
        return out
    if command == "media-scan":
        p.add_argument("-v", dest="verbose", action="store_true")
        p.add_argument("-r", dest="recursive", action="store_true")
        p.add_argument("paths", nargs="+")
        ns = p.parse_args(argv)
        return {"paths": ns.paths, "recursive": ns.recursive, "verbose": ns.verbose}
    if command == "microphone-record":
        p.add_argument("-d", dest="defaults", action="store_true")
        p.add_argument("-f", dest="file")
        p.add_argument("-l", dest="limit", type=int)
        p.add_argument("-e", dest="encoder")
        p.add_argument("-b", dest="bit_rate", type=int)
        p.add_argument("-r", dest="sample_rate", type=int)
        p.add_argument("-c", dest="channels", type=int)
        p.add_argument("-i", dest="info", action="store_true")
        p.add_argument("-q", dest="quit", action="store_true")
        ns = p.parse_args(argv)
        if ns.info:
            return {"action": "info"}
        if ns.quit:
            return {"action": "stop"}
        out: dict[str, Any] = {"action": "start"}
        if ns.file:
            out["file"] = ns.file
        if ns.limit is not None:
            out["limitMs"] = ns.limit * 1000
        if ns.encoder:
            out["encoder"] = ns.encoder
        if ns.bit_rate is not None:
            out["bitRate"] = ns.bit_rate * 1000
        if ns.sample_rate is not None:
            out["sampleRate"] = ns.sample_rate
        if ns.channels is not None:
            out["channels"] = ns.channels
        return out
    if command == "nfc":
        p.add_argument("-r", dest="read", nargs="?", const="short")
        p.add_argument("-w", dest="write", action="store_true")
        p.add_argument("-t", dest="text")
        ns = p.parse_args(argv)
        if ns.write:
            return {"mode": "write", "param": "text", "value": ns.text or ""}
        return {"mode": "read", "param": ns.read or "short"}
    if command == "notification-channel":
        p.add_argument("-d", dest="delete")
        p.add_argument("id", nargs="?")
        p.add_argument("name", nargs="?")
        ns = p.parse_args(argv)
        if ns.delete:
            return {"id": ns.delete, "delete": True}
        return {k: v for k, v in {"id": ns.id, "name": ns.name}.items() if v}
    if command == "notification":
        return parse_termux_notification_args(argv)
    if command == "saf-create":
        p.add_argument("-t", dest="mime", default="application/octet-stream")
        p.add_argument("treeuri")
        p.add_argument("filename")
        ns = p.parse_args(argv)
        return {"treeuri": ns.treeuri, "filename": ns.filename, "mime": ns.mime}
    if command in ("sms-list", "sms-inbox"):
        p.add_argument("-q", "--quiet", action="store_true")
        p.add_argument("-v", "--verbose", action="count", default=0)
        p.add_argument("-c", "--conversation-list", dest="conversation_list", action="store_true")
        p.add_argument("--conversation-limit", dest="conversation_limit", type=int)
        p.add_argument("--conversation-offset", dest="conversation_offset", type=int)
        p.add_argument("--conversation-return-multiple-messages", dest="conversation_return_multiple_messages", action="store_true")
        p.add_argument("--conversation-return-nested-view", dest="conversation_return_nested_view", action="store_true")
        p.add_argument("--conversation-return-no-order-reverse", dest="conversation_return_no_order_reverse", action="store_true")
        p.add_argument("--conversation-selection", dest="conversation_selection")
        p.add_argument("--conversation-sort-order", dest="conversation_sort_order")
        p.add_argument("-f", "--message-address", dest="message_address")
        p.add_argument("-l", "--message-limit", dest="message_limit", type=int, default=10)
        p.add_argument("-o", "--message-offset", dest="message_offset", type=int, default=0)
        p.add_argument("--message-return-no-order-reverse", dest="message_return_no_order_reverse", action="store_true")
        p.add_argument("--message-selection", dest="message_selection")
        p.add_argument("--message-sort-order", dest="message_sort_order")
        p.add_argument("-t", "--message-type", dest="message_type", default="all")
        ns = p.parse_args(argv)
        out = {"limit": ns.message_limit, "offset": ns.message_offset, "type": "inbox" if command == "sms-inbox" else ns.message_type}
        if ns.message_address:
            out["from"] = ns.message_address
        if ns.message_selection:
            out["message-selection"] = ns.message_selection
        if ns.message_sort_order:
            out["message-sort-order"] = ns.message_sort_order
        if ns.message_return_no_order_reverse:
            out["message-return-no-order-reverse"] = True
        if ns.conversation_list:
            out["conversation-list"] = True
        if ns.conversation_limit is not None:
            out["conversation-limit"] = ns.conversation_limit
        if ns.conversation_offset is not None:
            out["conversation-offset"] = ns.conversation_offset
        if ns.conversation_selection:
            out["conversation-selection"] = ns.conversation_selection
        if ns.conversation_sort_order:
            out["conversation-sort-order"] = ns.conversation_sort_order
        if ns.conversation_return_multiple_messages:
            out["conversation-return-multiple-messages"] = True
        if ns.conversation_return_nested_view:
            out["conversation-return-nested-view"] = True
        if ns.conversation_return_no_order_reverse:
            out["conversation-return-no-order-reverse"] = True
        return out
    if command == "sensor":
        p.add_argument("-a", dest="all", action="store_true")
        p.add_argument("-c", dest="cleanup", action="store_true")
        p.add_argument("-l", dest="list", action="store_true")
        p.add_argument("-s", dest="sensors")
        p.add_argument("-d", dest="delay_ms", type=int)
        p.add_argument("-n", dest="limit", type=int)
        ns = p.parse_args(argv)
        if ns.cleanup:
            return {"cleanup": True}
        if ns.list:
            return {"list": True}
        out: dict[str, Any] = {}
        if ns.all:
            out["all"] = True
        if ns.sensors:
            sensors = [item.strip() for item in ns.sensors.split(",") if item.strip()]
            out["sensors"] = sensors
            if sensors:
                out["sensor"] = sensors[0]
        if ns.delay_ms is not None:
            out["delayMs"] = ns.delay_ms
        if ns.limit is not None:
            out["limit"] = ns.limit
        return out
    if command == "share":
        p.add_argument("-a", dest="action", default="view")
        p.add_argument("-c", dest="mime")
        p.add_argument("-d", dest="default_receiver", action="store_true")
        p.add_argument("-t", dest="title")
        p.add_argument("file", nargs="?")
        ns = p.parse_args(argv)
        out = {"action": ns.action, "defaultReceiver": ns.default_receiver}
        if ns.mime:
            out["mime"] = ns.mime
        if ns.title:
            out["title"] = ns.title
        if ns.file:
            out["file"] = ns.file
        elif not sys.stdin.isatty():
            out["text"] = sys.stdin.read()
        return out
    if command == "sms-send":
        p.add_argument("-n", dest="numbers", required=True)
        p.add_argument("-s", dest="slot", type=int)
        p.add_argument("text", nargs="*")
        ns = p.parse_args(argv)
        text = " ".join(ns.text)
        if not text and not sys.stdin.isatty():
            text = sys.stdin.read()
        out = {"to": ns.numbers, "message": text}
        if ns.slot is not None:
            out["slot"] = ns.slot
        return out
    if command == "toast":
        p.add_argument("-b", dest="background")
        p.add_argument("-c", dest="color")
        p.add_argument("-g", dest="gravity")
        p.add_argument("-s", dest="short", action="store_true")
        p.add_argument("text", nargs="*")
        ns = p.parse_args(argv)
        text = " ".join(ns.text)
        if not text and not sys.stdin.isatty():
            text = sys.stdin.read()
        return {k: v for k, v in {"text": text, "short": ns.short, "background": ns.background, "color": ns.color, "gravity": ns.gravity}.items() if v not in (None, "")}
    if command == "tts-speak":
        p.add_argument("-e", dest="engine")
        p.add_argument("-l", dest="language")
        p.add_argument("-n", dest="region")
        p.add_argument("-v", dest="variant")
        p.add_argument("-p", dest="pitch", type=float)
        p.add_argument("-r", dest="rate", type=float)
        p.add_argument("-s", dest="stream")
        p.add_argument("text", nargs="*")
        ns = p.parse_args(argv)
        text = " ".join(ns.text)
        if not text and not sys.stdin.isatty():
            text = sys.stdin.read()
        out = {k: v for k, v in vars(ns).items() if k not in ("text", "region", "variant") and v not in (None, "")}
        if ns.language:
            language = ns.language
            if ns.region:
                language += f"-{ns.region}"
            if ns.variant:
                language += f"-{ns.variant}"
            out["language"] = language
        out["text"] = text
        return out
    if command == "wallpaper":
        p.add_argument("-f", dest="file")
        p.add_argument("-u", dest="url")
        p.add_argument("-l", dest="lockscreen", action="store_true")
        ns = p.parse_args(argv)
        return {k: v for k, v in {"file": ns.file, "url": ns.url, "lockscreen": ns.lockscreen}.items() if v not in (None, "")}
    if command == "vibrate":
        p.add_argument("-d", dest="duration", type=int, default=1000)
        p.add_argument("-f", dest="force", action="store_true")
        ns = p.parse_args(argv)
        return {"duration": ns.duration, "force": ns.force}
    if command == "usb":
        p.add_argument("-l", dest="list", action="store_true")
        p.add_argument("-r", dest="request", action="store_true")
        p.add_argument("-e", dest="callback")
        p.add_argument("-E", dest="export_fd", action="store_true")
        p.add_argument("device", nargs="*")
        ns = p.parse_args(argv)
        if ns.list:
            return {"action": "list"}
        out = {"action": "open" if ns.callback else "permission", "request": ns.request}
        if ns.callback:
            out["callback"] = ns.callback
        if ns.export_fd:
            out["exportFd"] = True
        if len(ns.device) == 1:
            out["device"] = ns.device[0]
        elif len(ns.device) >= 2:
            out["vendorId"] = ns.device[0]
            out["productId"] = ns.device[1]
        return out
    if command == "keystore":
        return parse_termux_keystore_args(argv)
    if command == "job-scheduler":
        return parse_termux_job_scheduler_args(argv)

    return {"args": argv}


def parse_termux_notification_args(argv: list[str]) -> dict[str, Any]:
    p = termux_script_parser("notification")
    p.add_argument("--action")
    p.add_argument("--alert-once", dest="alert_once", action="store_true")
    for index in (1, 2, 3):
        p.add_argument(f"--button{index}", dest=f"button{index}")
        p.add_argument(f"--button{index}-action", dest=f"button{index}_action")
    p.add_argument("-c", "--content")
    p.add_argument("--channel")
    p.add_argument("--group")
    p.add_argument("--icon")
    p.add_argument("-i", "--id", type=int)
    p.add_argument("--image-path", dest="image_path")
    p.add_argument("--led-color", dest="led_color")
    p.add_argument("--led-off", dest="led_off", type=int)
    p.add_argument("--led-on", dest="led_on", type=int)
    p.add_argument("--media-next", dest="media_next")
    p.add_argument("--media-pause", dest="media_pause")
    p.add_argument("--media-play", dest="media_play")
    p.add_argument("--media-previous", dest="media_previous")
    p.add_argument("--on-delete", dest="on_delete")
    p.add_argument("--ongoing", action="store_true")
    p.add_argument("--priority")
    p.add_argument("--sound", action="store_true")
    p.add_argument("-t", "--title")
    p.add_argument("--type", dest="notification_type")
    p.add_argument("--vibrate")
    ns, _unknown = p.parse_known_args(argv)
    out: dict[str, Any] = {}
    for key, value in vars(ns).items():
        if value not in (None, "", False):
            out[key] = value
    if ns.alert_once:
        out["alertOnce"] = True
    if ns.on_delete:
        out["deleteAction"] = ns.on_delete
    if ns.image_path:
        out["imagePath"] = ns.image_path
    if ns.led_color:
        out["led-color"] = ns.led_color
        out["ledColor"] = ns.led_color
    if ns.led_off is not None:
        out["led-off"] = ns.led_off
    if ns.led_on is not None:
        out["led-on"] = ns.led_on
    if ns.notification_type:
        out["type"] = ns.notification_type
    actions = []
    for index in (1, 2, 3):
        title = getattr(ns, f"button{index}")
        if title:
            actions.append({"title": title, "id": getattr(ns, f"button{index}_action") or f"button{index}"})
    for title, action in (
        ("Previous", ns.media_previous),
        ("Pause", ns.media_pause),
        ("Play", ns.media_play),
        ("Next", ns.media_next),
    ):
        if action:
            actions.append({"title": title, "id": action, "action": action})
    if actions:
        out["actions"] = actions
    if "content" not in out and not sys.stdin.isatty():
        out["content"] = sys.stdin.read()
    return out


def parse_termux_keystore_args(argv: list[str]) -> dict[str, Any]:
    command = argv[0] if argv else "list"
    rest = argv[1:]
    if command == "list":
        return {"command": "list", "detailed": "-d" in rest}
    if command == "delete":
        return {"command": "delete", "alias": rest[0]}
    if command == "generate":
        p = termux_script_parser("keystore generate")
        p.add_argument("alias")
        p.add_argument("-a", dest="algorithm", default="RSA")
        p.add_argument("-s", dest="size", type=int)
        p.add_argument("-u", dest="validity", type=int)
        ns = p.parse_args(rest)
        return {k: v for k, v in {"command": "generate", "alias": ns.alias, "algorithm": ns.algorithm, "size": ns.size, "validity": ns.validity}.items() if v is not None}
    if command == "sign":
        return {"command": "sign", "alias": rest[0], "algorithm": rest[1]}
    if command == "verify":
        return {"command": "verify", "alias": rest[0], "algorithm": rest[1], "signature": rest[2]}
    raise CliError(f"Unknown keystore command: {command}")


def parse_termux_job_scheduler_args(argv: list[str]) -> dict[str, Any]:
    p = termux_script_parser("job-scheduler")
    p.add_argument("-s", "--script")
    p.add_argument("--job-id", dest="job_id", type=int)
    p.add_argument("-p", "--pending", action="store_true")
    p.add_argument("--cancel", action="store_true")
    p.add_argument("--cancel-all", dest="cancel_all", action="store_true")
    p.add_argument("--period-ms", dest="period_ms", type=int)
    p.add_argument("--network")
    p.add_argument("--battery-not-low", dest="battery_not_low", type=parse_bool)
    p.add_argument("--storage-not-low", dest="storage_not_low", type=parse_bool)
    p.add_argument("--charging", type=parse_bool)
    p.add_argument("--persisted", type=parse_bool)
    p.add_argument("--trigger-content-uri", dest="trigger_content_uri")
    p.add_argument("--trigger-content-flag", dest="trigger_content_flag", type=int)
    ns = p.parse_args(argv)
    return {k: v for k, v in vars(ns).items() if v not in (None, False)}


def termux_api_call(args: argparse.Namespace, command: str, payload: dict[str, Any] | None = None) -> Any:
    body = termux_api_payload(args, payload)
    body.setdefault("command", command)
    return portal_post(f"/termux-api/{command}", args, body)


def command_termux_api(args: argparse.Namespace) -> int:
    command = args.termux_api_command
    payload = termux_api_payload(args, {"args": getattr(args, "api_args", [])})
    payload.setdefault("command", command)
    if command == "clipboard-get":
        result = portal_get("/clipboard/get", args)
        emit_success(args, result, command=f"termux-api.{command}")
        return 0
    if command == "clipboard-set":
        result = portal_post("/clipboard/set", args, {"text": str(payload.get("text", ""))})
        emit_success(args, result, command=f"termux-api.{command}")
        return 0
    if command == "saf-write" and "cachePath" not in payload and "cache_path" not in payload and "text" not in payload and not sys.stdin.isatty():
        cache_path, _bytes_written = stage_input_file_for_bridge("-")
        payload["cachePath"] = cache_path
    if command == "keystore":
        keystore_command = str(payload.get("command", "list"))
        has_keystore_input = any(
            key in payload
            for key in ("cachePath", "cache_path", "text", "data", "dataBase64", "data_base64")
        )
        if keystore_command in ("sign", "verify") and not has_keystore_input and not sys.stdin.isatty():
            cache_path, _bytes_written = stage_input_file_for_bridge("-")
            payload["cachePath"] = cache_path
        if keystore_command == "verify" and "signatureCachePath" not in payload and "signature_cache_path" not in payload and payload.get("signature"):
            signature_cache_path, _signature_bytes = stage_input_file_for_bridge(str(payload["signature"]))
            payload["signatureCachePath"] = signature_cache_path
    result = portal_post(f"/termux-api/{command}", args, payload)
    if command == "storage-get" and payload.get("output"):
        if not isinstance(result, dict) or "path" not in result:
            raise CliError("Unexpected storage-get response")
        bytes_written = copy_transfer_cache_to_output(result["path"], str(payload["output"]), args)
        result = {
            "path": str(Path(str(payload["output"]))),
            "bytes": bytes_written,
            "cache_path": result["path"],
            "uri": result.get("uri", ""),
            "displayName": result.get("displayName", ""),
            "mimeType": result.get("mimeType", ""),
        }
    if command == "saf-read" and active_output_format(args) == "raw":
        if not isinstance(result, dict) or "path" not in result:
            raise CliError("Unexpected saf-read response")
        copy_transfer_cache_to_output(result["path"], "-", args)
        return 0
    if command == "keystore" and payload.get("command") == "sign" and active_output_format(args) == "raw":
        if not isinstance(result, dict) or "path" not in result:
            raise CliError("Unexpected keystore sign response")
        copy_transfer_cache_to_output(result["path"], "-", args)
        return 0
    emit_success(args, result, command=f"termux-api.{command}")
    return 0


