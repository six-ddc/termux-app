def command_type(args: argparse.Namespace) -> int:
    text = command_text_arg(args)
    encoded = base64.b64encode(text.encode()).decode()
    result = portal_post("/keyboard/input", args, {"base64_text": encoded, "clear": args.clear})
    emit_success(args, {"chars": len(text), "clear": args.clear, "message": result}, command=getattr(args, "command_path", "input.text"))
    return 0


def command_key(args: argparse.Namespace) -> int:
    key = args.key.lower()
    if re.fullmatch(r"\d+", key):
        key_code = int(key)
    elif key in KEY_CODES:
        key_code = KEY_CODES[key]
    else:
        raise CliError(f"Unknown key '{args.key}'. Known keys: {', '.join(sorted(KEY_CODES))}")
    result = portal_post("/keyboard/key", args, {"key_code": key_code})
    emit_success(args, {"key": args.key, "key_code": key_code, "message": result}, command=getattr(args, "command_path", "input.key"))
    return 0


def command_global(args: argparse.Namespace) -> int:
    action = args.action.lower()
    if re.fullmatch(r"\d+", action):
        action_id = int(action)
    elif action in GLOBAL_ACTIONS:
        action_id = GLOBAL_ACTIONS[action]
    else:
        raise CliError(f"Unknown global action '{args.action}'. Known actions: {', '.join(sorted(GLOBAL_ACTIONS))}")
    result = portal_post("/global", args, {"action": action_id})
    emit_success(args, {"action": action, "action_id": action_id, "message": result}, command=getattr(args, "command_path", "input.global"))
    return 0


def command_launch(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {"package": args.package, "stopBeforeLaunch": args.stop_before_launch}
    if args.activity:
        payload["activity"] = args.activity
    try:
        result = portal_post("/app", args, payload)
    except CliError as exc:
        message = str(exc)
        if "background activity launch" in message or "foreground package" in message:
            raise CliError(f"{message}. Try: tp-android app launch-interactive {args.package}") from exc
        raise
    emit_success(args, {"package": args.package, "activity": args.activity, "message": result}, command=getattr(args, "command_path", "app.launch"))
    return 0


def wait_for_package_foreground(
    args: argparse.Namespace,
    package_name: str,
    *,
    activity: str | None = None,
    timeout: float = 10.0,
    interval: float = 0.25,
) -> dict[str, Any] | None:
    deadline = time.monotonic() + timeout
    while True:
        state = current_phone_state(args)
        if phone_state_field(state, "packageName", "package_name") == package_name:
            if not activity or phone_state_field(state, "activityName", "activity_name") == activity:
                return state
        if time.monotonic() >= deadline:
            return None
        time.sleep(max(0.05, interval))


def launcher_label_for_package(args: argparse.Namespace, package_name: str) -> str | None:
    try:
        info = portal_post("/app/info", args, {"package": package_name})
    except CliError:
        return None
    if isinstance(info, dict):
        label = info.get("label")
        if isinstance(label, str) and label.strip():
            return label.strip()
    return None


def first_launcher_icon_node(args: argparse.Namespace, label: str) -> tuple[dict[str, Any], dict[str, Any]] | None:
    selectors = (
        {"text": label},
        {"desc": label},
        {"textContains": label},
        {"descContains": label},
    )
    for selector in selectors:
        try:
            result = portal_post("/node/find", args, {**selector, "limit": 10})
        except CliError:
            continue
        nodes = result.get("nodes") if isinstance(result, dict) else None
        if isinstance(nodes, list) and nodes:
            node = next((item for item in nodes if isinstance(item, dict)), None)
            if node is not None:
                return node, selector
    return None


def node_center_xy(node: dict[str, Any]) -> tuple[int, int] | None:
    center = node.get("center")
    if isinstance(center, dict) and "x" in center and "y" in center:
        return int(center["x"]), int(center["y"])
    bounds = node.get("bounds")
    if isinstance(bounds, dict):
        try:
            return (
                int((int(bounds["left"]) + int(bounds["right"])) / 2),
                int((int(bounds["top"]) + int(bounds["bottom"])) / 2),
            )
        except (KeyError, TypeError, ValueError):
            return None
    return None


def command_launch_interactive(args: argparse.Namespace) -> int:
    attempts: list[dict[str, Any]] = []
    if not args.skip_direct:
        payload: dict[str, Any] = {"package": args.package, "stopBeforeLaunch": args.stop_before_launch}
        if args.activity:
            payload["activity"] = args.activity
        try:
            direct_result = portal_post("/app", args, payload)
            state = wait_for_package_foreground(
                args,
                args.package,
                activity=args.activity,
                timeout=args.wait_timeout,
                interval=args.interval,
            )
            if state is not None:
                emit_success(
                    args,
                    {
                        "package": args.package,
                        "activity": args.activity,
                        "mode": "direct",
                        "direct": direct_result,
                        "state": state,
                    },
                    command=getattr(args, "command_path", "app.launch-interactive"),
                )
                return 0
            attempts.append({"mode": "direct", "ok": False, "result": direct_result})
        except CliError as exc:
            attempts.append({"mode": "direct", "ok": False, "error": str(exc)})

    label = args.label or launcher_label_for_package(args, args.package)
    if not label:
        raise CliError(f"Could not resolve launcher label for {args.package}; pass --label")

    home_result = portal_post("/global", args, {"action": GLOBAL_ACTIONS["home"]})
    time.sleep(max(0.0, args.home_settle))
    icon = first_launcher_icon_node(args, label)
    if icon is None:
        raise CliError(f"Could not find launcher icon labeled {label!r} after going home")
    node, selector = icon
    center = node_center_xy(node)
    if center is None:
        raise CliError(f"Launcher icon {label!r} has no usable bounds")
    tap_result = portal_post("/tap", args, {"x": center[0], "y": center[1]})
    state = wait_for_package_foreground(
        args,
        args.package,
        activity=args.activity,
        timeout=args.wait_timeout,
        interval=args.interval,
    )
    if state is None:
        attempts.append({
            "mode": "launcher-icon",
            "ok": False,
            "label": label,
            "selector": selector,
            "tap": {"x": center[0], "y": center[1], "result": tap_result},
        })
        raise CliError(f"Timed out waiting for {args.package} after launcher-icon tap: {json.dumps(attempts, ensure_ascii=False, separators=(',', ':'))}")

    emit_success(
        args,
        {
            "package": args.package,
            "activity": args.activity,
            "mode": "launcher-icon",
            "label": label,
            "selector": selector,
            "tap": {"x": center[0], "y": center[1], "result": tap_result},
            "home": home_result,
            "state": state,
            "attempts": attempts,
        },
        command=getattr(args, "command_path", "app.launch-interactive"),
    )
    return 0


def parse_json_object_if_needed(value: Any, label: str) -> dict[str, Any]:
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except json.JSONDecodeError as exc:
            raise CliError(f"Unexpected {label} response: {value[:200]}") from exc
    if not isinstance(value, dict):
        raise CliError(f"Unexpected {label} response")
    return value


def current_phone_state(args: argparse.Namespace) -> dict[str, Any]:
    return parse_json_object_if_needed(portal_get("/phone_state", args), "phone-state")


def phone_state_field(state: dict[str, Any], *keys: str) -> str:
    for key in keys:
        value = state.get(key)
        if value is not None:
            return str(value)
    return ""


def command_app_current(args: argparse.Namespace) -> int:
    state = current_phone_state(args)
    if args.package_only:
        result: Any = phone_state_field(state, "packageName", "package_name")
    elif args.activity_only:
        result = phone_state_field(state, "activityName", "activity_name")
    else:
        result = state
    emit_success(args, result, command=getattr(args, "command_path", "app.current"))
    return 0


def phone_state_matches_app(args: argparse.Namespace, state: dict[str, Any]) -> bool:
    package_name = phone_state_field(state, "packageName", "package_name")
    activity_name = phone_state_field(state, "activityName", "activity_name")
    if package_name != args.package:
        return False
    if args.activity and activity_name != args.activity:
        return False
    if args.activity_contains and args.activity_contains.lower() not in activity_name.lower():
        return False
    return True


def command_app_wait(args: argparse.Namespace) -> int:
    deadline = time.monotonic() + args.timeout_seconds
    last_state: dict[str, Any] = {}
    while True:
        last_state = current_phone_state(args)
        matched = phone_state_matches_app(args, last_state)
        if matched != args.gone:
            emit_success(
                args,
                {
                    "matched": matched,
                    "gone": args.gone,
                    "package": args.package,
                    "activity": args.activity,
                    "activity_contains": args.activity_contains,
                    "state": last_state,
                },
                command=getattr(args, "command_path", "app.wait"),
            )
            return 0
        if time.monotonic() >= deadline:
            package_name = phone_state_field(last_state, "packageName", "package_name") or "unknown"
            activity_name = phone_state_field(last_state, "activityName", "activity_name") or "unknown"
            condition = "leave foreground" if args.gone else "enter foreground"
            raise CliError(
                f"Timed out waiting for {args.package} to {condition} after {args.timeout_seconds:g}s "
                f"(current={package_name}/{activity_name})"
            )
        time.sleep(args.interval)


def command_packages(args: argparse.Namespace) -> int:
    if getattr(args, "output", None) or getattr(args, "cache", False):
        return emit_cached_json_command(
            args,
            "/packages/cache",
            {},
            output=getattr(args, "output", None),
            command=getattr(args, "command_path", "app.list"),
        )
    packages = portal_get("/packages", args)
    result = {"packages": packages, "count": len(packages) if isinstance(packages, list) else None}
    emit_success(args, result, command=getattr(args, "command_path", "app.list"))
    return 0


