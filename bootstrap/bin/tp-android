#!/data/data/com.termux/files/usr/bin/python
"""Termux local Android automation CLI.

This CLI talks to AutoTermux through its signature-protected Android broadcast
bridge by default. The optional loopback HTTP API is only started when the user
explicitly uses the server commands or configures --transport=http.
"""

