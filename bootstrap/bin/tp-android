def command_event_status(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    try:
        result = bridge_broadcast(config, "EVENT_STATUS")
    except CliError:
        result = provider_query(config_authority(config), "event_status")
    event_name = getattr(args, "event", None)
    if event_name and isinstance(result, dict) and isinstance(result.get("events"), list):
        normalized = event_name.upper().replace("-", "_")
        match = next((event for event in result["events"] if isinstance(event, dict) and event.get("name") == normalized), None)
        if match is None:
            raise CliError(f"Unknown event type: {event_name}")
        result = match
    emit_success(args, result, command=getattr(args, "command_path", "event.status"))
    return 0


