def ui_selector_payload(args: argparse.Namespace) -> dict[str, Any]:
    payload: dict[str, Any] = {}
    for arg_name, payload_name in (
        ("index", "index"),
        ("text", "text"),
        ("text_contains", "textContains"),
        ("desc", "desc"),
        ("desc_contains", "descContains"),
        ("resource_id", "resourceId"),
        ("class_name", "className"),
        ("scrollable", "scrollable"),
        ("start", "start"),
        ("end", "end"),
        ("package", "packageName"),
    ):
        value = getattr(args, arg_name, None)
        if value is not None:
            payload[payload_name] = value
    return payload


def command_ui_action(args: argparse.Namespace) -> int:
    # `--idx N` is a fast-path that resolves a digest-cached interactive node
    # to coordinates and issues a tap, bypassing the selector machinery. It is
    # only valid for `ui click` (no value, no long-press) for now.
    idx = getattr(args, "idx", None)
    if idx is not None:
        if args.action != "click":
            raise CliError("--idx is only supported with ui click", code="CLI_ERROR")
        x, y = _ui_resolve_idx_bounds(idx)
        result = portal_post("/tap", args, {"x": x, "y": y})
        result_payload: dict[str, Any] = {"x": x, "y": y, "idx": idx, "tap_result": result}
        verification = verify_after_ui_action(args)
        if verification is not None:
            result_payload["verification"] = verification
        emit_success(args, result_payload, command=getattr(args, "command_path", "ui.action"))
        return 0
    payload = {
        "action": args.action,
        **ui_selector_payload(args),
    }
    if getattr(args, "value_stdin", False):
        payload["value_base64"] = base64.b64encode(sys.stdin.buffer.read()).decode()
    elif getattr(args, "value", None) is not None:
        payload["value"] = args.value
    result = portal_post("/node/action", args, payload)
    verification = verify_after_ui_action(args)
    if verification is not None:
        if isinstance(result, dict):
            result = {**result, "verification": verification}
        else:
            result = {"action_result": result, "verification": verification}
    emit_success(args, result, command=getattr(args, "command_path", "ui.action"))
    return 0


def command_ui_find(args: argparse.Namespace) -> int:
    if not args.all:
        require_ui_selector(args)
    payload = ui_selector_payload(args)
    payload["limit"] = args.limit
    if args.all:
        payload["all"] = True
    if args.output or args.cache:
        return emit_cached_json_command(
            args,
            "/node/find/cache",
            payload,
            output=args.output,
            command=getattr(args, "command_path", "ui.find"),
        )
    result = portal_post("/node/find", args, payload)
    emit_success(args, result, command=getattr(args, "command_path", "ui.find"))
    return 0


def command_ui_focused(args: argparse.Namespace) -> int:
    if args.output or args.cache:
        return emit_cached_json_command(
            args,
            "/node/focused/cache",
            {},
            output=args.output,
            command=getattr(args, "command_path", "ui.focused"),
        )
    result = portal_post("/node/focused", args, {})
    emit_success(args, result, command=getattr(args, "command_path", "ui.focused"))
    return 0


def flatten_ui_nodes(value: Any) -> list[dict[str, Any]]:
    nodes: list[dict[str, Any]] = []
    if isinstance(value, str):
        try:
            decoded = json.loads(value)
        except json.JSONDecodeError:
            return nodes
        return flatten_ui_nodes(decoded)
    if isinstance(value, dict):
        tree = value.get("a11y_tree", value)
        if isinstance(tree, list):
            for item in tree:
                nodes.extend(flatten_ui_nodes(item))
        elif isinstance(tree, dict):
            nodes.append(tree)
            children = tree.get("children")
            if isinstance(children, list):
                for child in children:
                    nodes.extend(flatten_ui_nodes(child))
    elif isinstance(value, list):
        for item in value:
            nodes.extend(flatten_ui_nodes(item))
    return nodes


def ui_node_text(node: dict[str, Any], key: str) -> str:
    value = node.get(key)
    return "" if value is None else str(value)


def ui_node_bool(node: dict[str, Any], *keys: str) -> bool:
    for key in keys:
        value = node.get(key)
        if isinstance(value, bool):
            return value
    return False


def ui_node_matches(args: argparse.Namespace, node: dict[str, Any]) -> bool:
    if getattr(args, "index", None) is not None and int(node.get("index", -1)) != args.index:
        return False
    if getattr(args, "text", None) is not None and ui_node_text(node, "text") != args.text:
        return False
    if getattr(args, "text_contains", None) is not None and args.text_contains.lower() not in ui_node_text(node, "text").lower():
        return False
    if getattr(args, "desc", None) is not None and ui_node_text(node, "contentDescription") != args.desc:
        return False
    if getattr(args, "desc_contains", None) is not None and args.desc_contains.lower() not in ui_node_text(node, "contentDescription").lower():
        return False
    if getattr(args, "resource_id", None) is not None and ui_node_text(node, "resourceId") != args.resource_id:
        return False
    if getattr(args, "class_name", None) is not None and args.class_name.lower() not in ui_node_text(node, "className").lower():
        return False
    if getattr(args, "scrollable", None) is not None and ui_node_bool(node, "isScrollable", "scrollable") != args.scrollable:
        return False
    return True


def require_ui_selector(args: argparse.Namespace) -> None:
    if any(getattr(args, name, None) is not None for name in ("index", "text", "text_contains", "desc", "desc_contains", "resource_id", "class_name", "scrollable")):
        return
    raise CliError("At least one selector is required: --index, --text, --text-contains, --desc, --desc-contains, --resource-id, --class-name, or --scrollable")


def get_scoped_ui_state(args: argparse.Namespace, *, full: bool) -> Any:
    payload = scoped_ui_payload(args, {"filter": getattr(args, "filter", True)})
    if getattr(args, "package", None):
        return portal_post("/state_full" if full else "/state", args, payload)
    path = "/state_full" if full else "/state"
    if full and getattr(args, "filter", True) is False:
        path += "?filter=false"
    return portal_get(path, args)


def ui_node_visible_strings(node: dict[str, Any]) -> list[str]:
    values: list[str] = []
    for key in ("text", "contentDescription", "hint", "stateDescription"):
        value = node.get(key)
        if value is not None:
            text = str(value)
            if text:
                values.append(text)
    return values


def ui_state_has_text(args: argparse.Namespace, *, exact: str | None, contains: str | None) -> tuple[bool, dict[str, Any]]:
    state = get_scoped_ui_state(args, full=False)
    nodes = flatten_ui_nodes(state)
    for node in nodes:
        values = ui_node_visible_strings(node)
        if exact is not None and any(value == exact for value in values):
            return True, {"count": len(nodes), "node": node}
        if contains is not None:
            folded = contains.lower()
            if any(folded in value.lower() for value in values):
                return True, {"count": len(nodes), "node": node}
    return False, {"count": len(nodes)}


def verify_after_ui_action(args: argparse.Namespace) -> dict[str, Any] | None:
    expected_package = getattr(args, "expect_package", None)
    expected_activity = getattr(args, "expect_activity", None)
    expected_text = getattr(args, "expect_text", None)
    expected_text_contains = getattr(args, "expect_text_contains", None)
    if not any((expected_package, expected_activity, expected_text, expected_text_contains)):
        return None

    timeout = max(0.0, getattr(args, "verify_timeout", 5.0))
    interval = max(0.05, getattr(args, "verify_interval", 0.25))
    deadline = time.monotonic() + timeout
    last_state: dict[str, Any] = {}
    last_text_probe: dict[str, Any] = {}

    while True:
        checks: dict[str, bool] = {}
        if expected_package or expected_activity:
            last_state = current_phone_state(args)
            if expected_package:
                checks["package"] = phone_state_field(last_state, "packageName", "package_name") == expected_package
            if expected_activity:
                checks["activity"] = phone_state_field(last_state, "activityName", "activity_name") == expected_activity
        if expected_text or expected_text_contains:
            matched_text, last_text_probe = ui_state_has_text(
                args,
                exact=expected_text,
                contains=expected_text_contains,
            )
            checks["text"] = matched_text

        if checks and all(checks.values()):
            return {
                "matched": True,
                "checks": checks,
                "state": last_state,
                "text_probe": last_text_probe,
            }
        if time.monotonic() >= deadline:
            details = {
                "matched": False,
                "checks": checks,
                "expectedPackage": expected_package,
                "expectedActivity": expected_activity,
                "expectedText": expected_text,
                "expectedTextContains": expected_text_contains,
                "state": last_state,
                "text_probe": last_text_probe,
            }
            raise CliError(
                f"UI action verification failed after {timeout:g}s",
                code="TARGET_NOT_FOUND",
                details=details,
            )
        time.sleep(interval)


def target_selector_namespace(args: argparse.Namespace) -> argparse.Namespace:
    return argparse.Namespace(
        index=getattr(args, "target_index", None),
        text=getattr(args, "target_text", None),
        text_contains=getattr(args, "target_text_contains", None),
        desc=getattr(args, "target_desc", None),
        desc_contains=getattr(args, "target_desc_contains", None),
        resource_id=getattr(args, "target_resource_id", None),
        class_name=getattr(args, "target_class_name", None),
        scrollable=None,
    )


def command_ui_wait(args: argparse.Namespace) -> int:
    # Three new wait conditions short-circuit the selector machinery — they
    # poll a global signal (tree-hash / keyboard-visible / screenshot-hash)
    # instead of looking for a node. Mutually exclusive with selector mode.
    if getattr(args, "keyboard", None) is not None:
        return _ui_wait_keyboard(args)
    if getattr(args, "tree_changed", False):
        return _ui_wait_signal(args, kind="tree")
    if getattr(args, "change", False):
        return _ui_wait_signal(args, kind="screen")

    require_ui_selector(args)
    deadline = time.monotonic() + args.timeout_seconds
    last_count = 0
    while True:
        state = get_scoped_ui_state(args, full=args.full)
        nodes = flatten_ui_nodes(state)
        last_count = len(nodes)
        match = next((node for node in nodes if ui_node_matches(args, node)), None)
        if args.gone and match is None:
            emit_success(
                args,
                {"matched": False, "gone": True, "count": last_count},
                command=getattr(args, "command_path", "ui.wait"),
            )
            return 0
        if not args.gone and match is not None:
            emit_success(
                args,
                {"matched": True, "node": match, "count": last_count},
                command=getattr(args, "command_path", "ui.wait"),
            )
            return 0
        if time.monotonic() >= deadline:
            condition = "disappear" if args.gone else "appear"
            raise CliError(
                f"Timed out waiting for UI selector to {condition} after {args.timeout_seconds:g}s (nodes={last_count})",
                code="INPUT_TIMEOUT",
                details={"condition": condition, "nodes": last_count, "timeout_seconds": args.timeout_seconds},
            )
        time.sleep(args.interval)


def _ui_wait_keyboard(args: argparse.Namespace) -> int:
    want_visible = args.keyboard == "visible"
    deadline = time.monotonic() + args.timeout_seconds
    while True:
        try:
            state = portal_get("/phone_state", args)
        except CliError:
            state = None
        keyboard_visible = False
        if isinstance(state, dict):
            for key in ("keyboardVisible", "keyboard_visible", "isKeyboardVisible"):
                if key in state:
                    keyboard_visible = bool(state[key])
                    break
        if keyboard_visible == want_visible:
            emit_success(
                args,
                {"matched": True, "keyboard_visible": keyboard_visible, "expected": want_visible},
                command=getattr(args, "command_path", "ui.wait"),
            )
            return 0
        if time.monotonic() >= deadline:
            raise CliError(
                f"Keyboard did not become {args.keyboard} after {args.timeout_seconds:g}s",
                code="INPUT_TIMEOUT",
                details={"expected": args.keyboard, "observed_visible": keyboard_visible},
            )
        time.sleep(args.interval)


def _ui_wait_signal(args: argparse.Namespace, *, kind: str) -> int:
    """Poll for either the a11y tree hash or screenshot hash to change."""
    deadline = time.monotonic() + args.timeout_seconds

    def snapshot() -> str | None:
        if kind == "tree":
            try:
                raw = portal_post("/a11y_tree_full", args, scoped_ui_payload(args, {"filter": True}))
            except CliError:
                return None
            payload = json.dumps(raw, sort_keys=True, ensure_ascii=False) if not isinstance(raw, str) else raw
            return hashlib.sha1(payload.encode("utf-8")).hexdigest()
        # screen
        try:
            result = portal_post("/screenshot/cache", args, {"hideOverlay": True})
        except CliError:
            return None
        if not isinstance(result, dict):
            return None
        path = result.get("path")
        if not isinstance(path, str):
            return None
        try:
            with open(path, "rb") as fh:
                # Hash just the first 256KB — visual change usually surfaces
                # within the first chunks for most screens.
                head = fh.read(256 * 1024)
        except OSError:
            return None
        return hashlib.sha1(head).hexdigest()

    initial = snapshot()
    if initial is None:
        raise CliError(
            f"Could not capture initial {kind} snapshot for ui wait --{'tree-changed' if kind == 'tree' else 'change'}",
            code="BRIDGE_PARSE_FAILED",
        )
    while True:
        time.sleep(args.interval)
        current = snapshot()
        if current is not None and current != initial:
            emit_success(
                args,
                {"matched": True, "kind": kind, "initial_hash": initial, "current_hash": current},
                command=getattr(args, "command_path", "ui.wait"),
            )
            return 0
        if time.monotonic() >= deadline:
            raise CliError(
                f"{kind} did not change after {args.timeout_seconds:g}s",
                code="INPUT_TIMEOUT",
                details={"kind": kind, "initial_hash": initial},
            )


def command_ui_scroll_until(args: argparse.Namespace) -> int:
    target = target_selector_namespace(args)
    require_ui_selector(target)
    scroll_action = "scroll-forward" if args.direction == "forward" else "scroll-backward"
    scroll_payload: dict[str, Any] = {"action": scroll_action}
    for arg_name, payload_name in (
        ("index", "index"),
        ("text", "text"),
        ("text_contains", "textContains"),
        ("desc", "desc"),
        ("desc_contains", "descContains"),
        ("resource_id", "resourceId"),
        ("class_name", "className"),
        ("scrollable", "scrollable"),
    ):
        value = getattr(args, arg_name, None)
        if value is not None:
            scroll_payload[payload_name] = value
    if getattr(args, "package", None):
        scroll_payload["packageName"] = args.package
    if not any(key in scroll_payload for key in ("index", "text", "textContains", "desc", "descContains", "resourceId", "className", "scrollable")):
        scroll_payload["scrollable"] = True

    last_count = 0
    last_scroll_result: Any = None
    for scrolls in range(args.max_scrolls + 1):
        state = get_scoped_ui_state(args, full=args.full)
        nodes = flatten_ui_nodes(state)
        last_count = len(nodes)
        match = next((node for node in nodes if ui_node_matches(target, node)), None)
        if match is not None:
            emit_success(
                args,
                {
                    "matched": True,
                    "node": match,
                    "count": last_count,
                    "scrolls": scrolls,
                    "last_scroll": last_scroll_result,
                },
                command=getattr(args, "command_path", "ui.scroll-until"),
            )
            return 0
        if scrolls == args.max_scrolls:
            break
        last_scroll_result = portal_post("/node/action", args, scroll_payload)
        time.sleep(args.settle)
    raise CliError(
        f"Timed out scrolling for UI selector after {args.max_scrolls} scrolls (nodes={last_count})",
        code="TARGET_NOT_FOUND",
        details={"max_scrolls": args.max_scrolls, "nodes": last_count},
    )


def command_screenshot(args: argparse.Namespace) -> int:
    # When --exclude-overlays is requested we ask Termux to hide its floating
    # terminal (signature-protected action handled by TermuxService) just
    # before the capture, then restore it after. Best-effort: failure to hide
    # is logged but never blocks the screenshot.
    hid_floating = False
    if getattr(args, "exclude_overlays", False):
        try:
            bridge_call(load_runtime_config(args), "termux/floating/hide")
            hid_floating = True
            time.sleep(0.15)  # let WindowManager actually detach
        except CliError:
            pass
    result = portal_post("/screenshot/cache", args, {"hideOverlay": args.hide_overlay})
    if not isinstance(result, dict) or not isinstance(result.get("path"), str):
        raise CliError("Unexpected screenshot cache response")
    cache_path = result["path"]
    bytes_written = copy_transfer_cache_to_output(cache_path, args.output, args)
    if args.output == "-":
        return 0
    annotation: dict[str, Any] | None = None
    if getattr(args, "annotate", None) and args.output != "-":
        annotation = _screenshot_annotate(args, Path(args.output), getattr(args, "map_out", None))
    payload: dict[str, Any] = {"path": str(Path(args.output)), "bytes": bytes_written, "cache_path": cache_path}
    if annotation is not None:
        payload["annotation"] = annotation
    if hid_floating:
        try:
            bridge_call(load_runtime_config(args), "termux/floating/show")
        except CliError:
            pass
        payload["restored_floating"] = True
    emit_success(args, payload, command=getattr(args, "command_path", "ui.screenshot"))
    return 0


def _import_pillow():
    """Lazy-import Pillow; raise a user-actionable CliError if missing."""
    try:
        from PIL import Image, ImageDraw, ImageFont  # type: ignore
    except ImportError as exc:
        raise CliError(
            "Pillow not installed. Run: pip install pillow",
            code="CLI_ERROR",
            hint="Inside Termux: pkg install python && pip install pillow",
        ) from exc
    return Image, ImageDraw, ImageFont


def _screenshot_annotate(
    args: argparse.Namespace,
    image_path: Path,
    map_out: str | None,
) -> dict[str, Any]:
    Image, ImageDraw, ImageFont = _import_pillow()
    # Refresh the digest so we annotate the current screen, not a stale one.
    digest_args = argparse.Namespace(
        **{k: v for k, v in vars(args).items() if k not in {"func", "output", "annotate", "map_out"}},
        only_clickable=(args.annotate == "clickable"),
        max_nodes=200,
    )
    digest_args.output = None
    # silence digest's emit_success
    digest_args.output_format = "none"
    command_ui_digest(digest_args)
    digest = _ui_digest_read_cache() or {"elements": []}
    elements = digest.get("elements", [])

    img = Image.open(image_path).convert("RGB")
    draw = ImageDraw.Draw(img)
    try:
        font = ImageFont.truetype("DejaVuSans-Bold.ttf", 22)
    except (OSError, IOError):
        font = ImageFont.load_default()

    palette = [(0, 122, 255), (255, 45, 85), (52, 199, 89), (255, 149, 0), (175, 82, 222), (255, 204, 0), (90, 200, 250), (88, 86, 214)]
    mapping: dict[str, Any] = {}

    annotated_count = 0
    for entry in elements:
        bounds = entry.get("bounds")
        if not isinstance(bounds, str):
            continue
        try:
            left, top, right, bottom = (int(p) for p in bounds.split(","))
        except ValueError:
            continue
        idx = entry.get("idx", annotated_count)
        color = palette[idx % len(palette)]
        draw.rectangle([left, top, right, bottom], outline=color, width=3)
        label = str(idx)
        # background box for label
        try:
            tw, th = draw.textsize(label, font=font)
        except AttributeError:
            bbox = draw.textbbox((0, 0), label, font=font)
            tw, th = bbox[2] - bbox[0], bbox[3] - bbox[1]
        bx, by = left, max(0, top - th - 4)
        draw.rectangle([bx, by, bx + tw + 8, by + th + 4], fill=color)
        draw.text((bx + 4, by + 2), label, fill=(255, 255, 255), font=font)
        mapping[str(idx)] = {
            "bounds": bounds,
            "text": entry.get("text"),
            "desc": entry.get("desc"),
            "actions": entry.get("actions"),
            "resource": entry.get("resource"),
        }
        annotated_count += 1
    img.save(image_path)

    if map_out:
        if map_out == "-":
            sys.stdout.write(json.dumps(mapping, ensure_ascii=False))
            sys.stdout.write("\n")
        else:
            Path(map_out).parent.mkdir(parents=True, exist_ok=True)
            Path(map_out).write_text(json.dumps(mapping, ensure_ascii=False), encoding="utf-8")
    return {"count": annotated_count, "filter": args.annotate, "map_out": map_out, "elements": list(mapping.keys())}


# ============================================================================
# OCR fallback — when a11y can't expose text (heavily-obfuscated apps), fall
# back to running an OCR binary against a fresh screenshot. We pick the binary
# from $TP_OCR_CMD (default: tesseract). The output is parsed back into pseudo
# nodes with bounds derived from tesseract's TSV mode.
# ============================================================================

def _ocr_run(image_path: Path, lang: str = "eng+chi_sim") -> list[dict[str, Any]]:
    cmd_template = os.environ.get("TP_OCR_CMD", "tesseract {image} - -l {lang} tsv")
    cmd = cmd_template.format(image=str(image_path), lang=lang)
    try:
        completed = subprocess.run(
            cmd.split() if "{image}" not in cmd_template.split()[0] else cmd,
            shell=("{image}" in cmd_template.split()[0]),
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except FileNotFoundError as exc:
        raise CliError(
            f"OCR binary not found: {cmd}. Install tesseract or set TP_OCR_CMD.",
            code="CLI_ERROR",
            hint="pkg install tesseract tesseract-data-chi_sim tesseract-data-eng",
        ) from exc
    except subprocess.TimeoutExpired as exc:
        raise CliError("OCR command timed out after 30s", code="INPUT_TIMEOUT") from exc
    if completed.returncode != 0:
        raise CliError(f"OCR exit {completed.returncode}: {completed.stderr.strip()}", code="CLI_ERROR")
    return _ocr_parse_tesseract_tsv(completed.stdout)


def _ocr_parse_tesseract_tsv(tsv: str) -> list[dict[str, Any]]:
    rows = []
    lines = tsv.splitlines()
    if not lines:
        return rows
    header = lines[0].split("\t")
    try:
        cols = {name: header.index(name) for name in ("left", "top", "width", "height", "text", "conf")}
    except ValueError:
        return rows
    for line in lines[1:]:
        parts = line.split("\t")
        if len(parts) <= max(cols.values()):
            continue
        text = parts[cols["text"]].strip()
        if not text:
            continue
        try:
            left = int(parts[cols["left"]])
            top = int(parts[cols["top"]])
            width = int(parts[cols["width"]])
            height = int(parts[cols["height"]])
            conf = float(parts[cols["conf"]])
        except ValueError:
            continue
        rows.append({
            "text": text,
            "bounds": f"{left},{top},{left + width},{top + height}",
            "center": [left + width // 2, top + height // 2],
            "confidence": conf,
        })
    return rows


def command_ui_find_ocr(args: argparse.Namespace) -> int:
    """Capture a fresh screenshot, run OCR, fuzzy-match against --ocr query."""
    tmp_png = Path("/sdcard/Download/.termuxplus/tp-android-cache/ocr-{}.png".format(os.getpid()))
    shot_args = argparse.Namespace(
        **{k: v for k, v in vars(args).items() if k not in {"func"}},
        output=str(tmp_png),
        hide_overlay=True,
        annotate=None,
        map_out=None,
        exclude_overlays=False,
    )
    # Reach into command_screenshot to avoid duplicating cache+copy logic.
    command_screenshot(shot_args)
    try:
        results = _ocr_run(tmp_png, lang=args.lang or "eng+chi_sim")
    finally:
        try:
            tmp_png.unlink()
        except OSError:
            pass

    needle = (args.ocr or "").lower()
    matches = [r for r in results if needle in r["text"].lower()] if needle else results
    if args.limit:
        matches = matches[: args.limit]
    payload = {"query": args.ocr, "count": len(matches), "results": matches}
    if args.click and matches:
        x, y = matches[0]["center"]
        portal_post("/tap", args, {"x": x, "y": y})
        payload["tapped"] = {"x": x, "y": y, "text": matches[0]["text"]}
    emit_success(args, payload, command="ui.find.ocr")
    return 0 if (matches or not needle) else 1


# ============================================================================
# Vision selector — present a numbered annotated screenshot to an external
# decision-maker (interactive user, or another LLM agent) and click the idx
# they return. Pure CLI orchestration on top of the other primitives.
# ============================================================================

def command_ui_click_vision(args: argparse.Namespace) -> int:
    # Step 1: produce annotated screenshot + mapping.
    annotated_path = args.annotated_out or "/sdcard/Download/.termuxplus/tp-android-cache/vision-{}.png".format(os.getpid())
    map_path = args.map_out or annotated_path + ".map.json"
    shot_args = argparse.Namespace(
        **{k: v for k, v in vars(args).items() if k not in {"func"}},
        output=annotated_path,
        hide_overlay=True,
        annotate="clickable",
        map_out=map_path,
        exclude_overlays=args.exclude_overlays,
    )
    command_screenshot(shot_args)

    # Step 2: ask for an idx. If --idx given, skip the prompt.
    chosen_idx: int | None = args.idx
    if chosen_idx is None:
        prompt_payload = {
            "prompt": args.prompt or f"Pick an idx for: {args.query}",
            "kind": "number",
            "tts": None,
        }
        # Use the dialog channel when bridge is up, else terminal fallback.
        # We don't have a run to attach to; create a transient interaction.
        response = _status_dialog_channel(args, "ask_input", prompt_payload, args.wait_timeout)
        if response is None:
            response = _status_terminal_fallback("ask_input", prompt_payload, args.wait_timeout)
        if response is None:
            raise CliError("vision selector timed out and no terminal fallback available", code="INPUT_TIMEOUT")
        raw_value = response.get("value")
        if not raw_value or not str(raw_value).strip():
            raise CliError("No idx provided", code="USER_CANCELLED")
        try:
            chosen_idx = int(str(raw_value).strip())
        except ValueError:
            raise CliError(f"Vision picker did not return an integer idx: {raw_value!r}", code="CLI_ERROR")

    # Step 3: click that idx via the digest cache. The digest was refreshed
    # inside command_screenshot --annotate above.
    x, y = _ui_resolve_idx_bounds(chosen_idx)
    portal_post("/tap", args, {"x": x, "y": y})
    emit_success(
        args,
        {
            "query": args.query,
            "idx": chosen_idx,
            "x": x,
            "y": y,
            "annotated_screenshot": annotated_path,
            "mapping": map_path,
        },
        command="ui.click-vision",
    )
    return 0


def command_ui_element_image(args: argparse.Namespace) -> int:
    Image, _ImageDraw, _ImageFont = _import_pillow()
    # Resolve bounds
    bounds_tuple: tuple[int, int, int, int] | None = None
    if args.bounds:
        try:
            parts = [int(p.strip()) for p in args.bounds.split(",")]
            if len(parts) != 4:
                raise ValueError
        except ValueError:
            raise CliError(f"--bounds must be 'L,T,R,B' integers, got {args.bounds!r}", code="CLI_ERROR")
        bounds_tuple = (parts[0], parts[1], parts[2], parts[3])
    elif args.idx is not None:
        cx, cy = _ui_resolve_idx_bounds(args.idx)
        # Look up the original bounds string from cache too so we crop the box,
        # not just a pixel around the center.
        cache = _ui_digest_read_cache() or {}
        for node in cache.get("elements", []):
            if node.get("idx") == args.idx and isinstance(node.get("bounds"), str):
                left, top, right, bottom = [int(p) for p in node["bounds"].split(",")]
                bounds_tuple = (left, top, right, bottom)
                break
    elif args.resource_id:
        find_payload = {"resourceName": args.resource_id, "limit": 1}
        result = portal_post("/node/find", args, find_payload)
        if not isinstance(result, dict):
            raise CliError("ui find returned unexpected shape", code="BRIDGE_PARSE_FAILED")
        nodes = result.get("nodes") or result.get("results") or []
        if not nodes:
            raise CliError(f"No node matches resource-id={args.resource_id}", code="TARGET_NOT_FOUND")
        bounds = nodes[0].get("bounds") if isinstance(nodes[0], dict) else None
        if isinstance(bounds, dict):
            bounds_tuple = (int(bounds["left"]), int(bounds["top"]), int(bounds["right"]), int(bounds["bottom"]))
        elif isinstance(bounds, str):
            parts = [int(p) for p in bounds.split(",")]
            bounds_tuple = (parts[0], parts[1], parts[2], parts[3])
    if bounds_tuple is None:
        raise CliError("ui element-image needs --bounds, --idx, or --resource-id", code="CLI_ERROR")

    # Capture screen and crop
    shot_result = portal_post("/screenshot/cache", args, {"hideOverlay": True})
    if not isinstance(shot_result, dict) or not isinstance(shot_result.get("path"), str):
        raise CliError("Unexpected screenshot cache response", code="BRIDGE_PARSE_FAILED")
    cache_path = shot_result["path"]
    tmp_full = Path(args.output).with_suffix(".tmp.full.png")
    tmp_full.parent.mkdir(parents=True, exist_ok=True)
    copy_transfer_cache_to_output(cache_path, str(tmp_full), args)
    try:
        img = Image.open(tmp_full).convert("RGB")
        l, t, r, b = bounds_tuple
        l, t = max(0, l), max(0, t)
        r, b = min(img.width, r), min(img.height, b)
        if r <= l or b <= t:
            raise CliError(f"Invalid bounds after clamp: {l},{t},{r},{b}", code="CLI_ERROR")
        cropped = img.crop((l, t, r, b))
        Path(args.output).parent.mkdir(parents=True, exist_ok=True)
        cropped.save(args.output)
    finally:
        try:
            tmp_full.unlink()
        except OSError:
            pass

    emit_success(
        args,
        {"path": args.output, "bounds": list(bounds_tuple), "source_cache_path": cache_path},
        command="ui.element-image",
    )
    return 0


def command_tap(args: argparse.Namespace) -> int:
    result = portal_post("/tap", args, {"x": args.x, "y": args.y})
    emit_success(args, {"x": args.x, "y": args.y, "message": result}, command=getattr(args, "command_path", "input.tap"))
    return 0


def command_swipe(args: argparse.Namespace) -> int:
    result = portal_post(
        "/swipe",
        args,
        {
            "startX": args.x1,
            "startY": args.y1,
            "endX": args.x2,
            "endY": args.y2,
            "duration": args.duration,
        },
    )
    payload: dict[str, Any] = {
        "start": {"x": args.x1, "y": args.y1},
        "end": {"x": args.x2, "y": args.y2},
        "duration_ms": args.duration,
        "message": result,
    }
    verification = verify_after_ui_action(args)
    if verification is not None:
        payload["verification"] = verification
    emit_success(args, payload, command=getattr(args, "command_path", "input.swipe"))
    return 0


def command_double_tap(args: argparse.Namespace) -> int:
    interval_ms = max(0, args.interval_ms)
    first = portal_post("/tap", args, {"x": args.x, "y": args.y})
    if interval_ms:
        time.sleep(interval_ms / 1000)
    second = portal_post("/tap", args, {"x": args.x, "y": args.y})
    emit_success(
        args,
        {
            "x": args.x,
            "y": args.y,
            "interval_ms": interval_ms,
            "messages": [first, second],
        },
        command=getattr(args, "command_path", "input.double-tap"),
    )
    return 0


