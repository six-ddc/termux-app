def command_file_read(args: argparse.Namespace) -> int:
    result = portal_post("/files/stage-download", args, {"path": args.path})
    if not isinstance(result, dict) or not isinstance(result.get("path"), str):
        raise CliError("Unexpected staged file response")
    cache_path = result["path"]
    bytes_written = copy_transfer_cache_to_output(cache_path, args.output, args)
    if args.output == "-":
        return 0
    emit_success(args, {"path": str(Path(args.output)), "bytes": bytes_written, "remote_path": args.path, "cache_path": cache_path})
    return 0


def command_file_write(args: argparse.Namespace) -> int:
    cache_path, bytes_written = stage_input_file_for_bridge(args.input)
    result = portal_post("/files/commit-upload", args, {"path": args.path, "cachePath": cache_path})
    if isinstance(result, dict) and isinstance(result.get("bytes"), int):
        bytes_written = result["bytes"]
    emit_success(args, {"path": args.path, "bytes": bytes_written, "cache_path": cache_path, "message": result})
    return 0


