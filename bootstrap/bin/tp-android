def command_infrared_transmit(args: argparse.Namespace) -> int:
    pattern = []
    for part in args.pattern.split(","):
        item = part.strip()
        if not item:
            continue
        if not re.fullmatch(r"\d+", item):
            raise CliError("infrared transmit pattern must be comma-separated positive integer intervals")
        pattern.append(int(item))
    if not pattern:
        raise CliError("infrared transmit requires a non-empty pattern")
    result = termux_api_call(args, "infrared-transmit", {"frequency": args.frequency, "pattern": pattern})
    emit_success(args, result, command="infrared.transmit")
    return 0


