def ui_selector_payload(args: argparse.Namespace) -> dict[str, Any]:
    payload: dict[str, Any] = {}
    for arg_name, payload_name in (
        ("index", "index"),
        ("text", "text"),
        ("text_contains", "textContains"),
        ("desc", "desc"),
        ("desc_contains", "descContains"),
        ("resource_id", "resourceId"),
        ("class_name", "className"),
        ("scrollable", "scrollable"),
        ("start", "start"),
        ("end", "end"),
        ("package", "packageName"),
    ):
        value = getattr(args, arg_name, None)
        if value is not None:
            payload[payload_name] = value
    return payload


def command_ui_action(args: argparse.Namespace) -> int:
    payload = {
        "action": args.action,
        **ui_selector_payload(args),
    }
    if getattr(args, "value_stdin", False):
        payload["value_base64"] = base64.b64encode(sys.stdin.buffer.read()).decode()
    elif getattr(args, "value", None) is not None:
        payload["value"] = args.value
    result = portal_post("/node/action", args, payload)
    verification = verify_after_ui_action(args)
    if verification is not None:
        if isinstance(result, dict):
            result = {**result, "verification": verification}
        else:
            result = {"action_result": result, "verification": verification}
    emit_success(args, result, command=getattr(args, "command_path", "ui.action"))
    return 0


def command_ui_find(args: argparse.Namespace) -> int:
    if not args.all:
        require_ui_selector(args)
    payload = ui_selector_payload(args)
    payload["limit"] = args.limit
    if args.all:
        payload["all"] = True
    if args.output or args.cache:
        return emit_cached_json_command(
            args,
            "/node/find/cache",
            payload,
            output=args.output,
            command=getattr(args, "command_path", "ui.find"),
        )
    result = portal_post("/node/find", args, payload)
    emit_success(args, result, command=getattr(args, "command_path", "ui.find"))
    return 0


def command_ui_focused(args: argparse.Namespace) -> int:
    if args.output or args.cache:
        return emit_cached_json_command(
            args,
            "/node/focused/cache",
            {},
            output=args.output,
