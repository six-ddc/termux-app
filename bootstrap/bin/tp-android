def command_saf_create(args: argparse.Namespace) -> int:
    payload = {
        "treeuri": args.parent_uri,
        "filename": args.name,
        "mimetype": args.mime,
    }
    result = termux_api_call(args, "saf-create", payload)
    emit_success(args, result, command="saf.create")
    return 0


def command_saf_mkdir(args: argparse.Namespace) -> int:
    result = termux_api_call(args, "saf-mkdir", {"treeuri": args.parent_uri, "filename": args.name})
    emit_success(args, result, command="saf.mkdir")
    return 0


def command_saf_read(args: argparse.Namespace) -> int:
    result = termux_api_call(args, "saf-read", {"uri": args.uri})
    if args.output:
        if not isinstance(result, dict) or "path" not in result:
            raise CliError("Unexpected saf-read response")
        bytes_written = copy_transfer_cache_to_output(result["path"], args.output, args)
        if args.output == "-":
            return 0
        emit_success(
            args,
            {
                "path": str(Path(args.output)),
                "bytes": bytes_written,
                "cache_path": result["path"],
                "uri": result.get("uri", args.uri),
                "content_type": result.get("content_type", "application/octet-stream"),
            },
            command="saf.read",
        )
        return 0
    emit_success(args, result, command="saf.read")
    return 0


def command_saf_write(args: argparse.Namespace) -> int:
    cache_path, bytes_written = stage_input_file_for_bridge(args.input)
    result = termux_api_call(args, "saf-write", {"uri": args.uri, "cachePath": cache_path})
    if isinstance(result, dict) and isinstance(result.get("bytes"), int):
        bytes_written = result["bytes"]
    emit_success(args, {"uri": args.uri, "bytes": bytes_written, "cache_path": cache_path, "result": result}, command="saf.write")
    return 0


def command_saf_rm(args: argparse.Namespace) -> int:
    result = termux_api_call(args, "saf-rm", {"uri": args.uri})
    emit_success(args, result, command="saf.rm")
    return 0


def command_tts_engines(args: argparse.Namespace) -> int:
    emit_success(args, termux_api_call(args, "tts-engines"), command="tts.engines")
    return 0


def command_tts_speak(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {
        "text": command_text_arg(args),
        "queue": args.queue,
    }
    if args.language:
        payload["language"] = args.language
    if args.pitch is not None:
        payload["pitch"] = args.pitch
    if args.rate is not None:
        payload["rate"] = args.rate
    emit_success(args, termux_api_call(args, "tts-speak", payload), command="tts.speak")
    return 0


def command_wallpaper_set(args: argparse.Namespace) -> int:
    if bool(args.file) == bool(args.url):
        raise CliError("wallpaper set requires exactly one of --file or --url")
    payload: dict[str, Any] = {"lockscreen": args.lockscreen}
    if args.file:
        payload["file"] = args.file
    if args.url:
        payload["url"] = args.url
    result = termux_api_call(args, "wallpaper", payload)
    emit_success(args, result, command="wallpaper.set")
    return 0


def command_camera_info(args: argparse.Namespace) -> int:
    emit_success(args, termux_api_call(args, "camera-info"), command="camera.info")
    return 0


def command_camera_photo(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {
        "timeoutMs": int(args.timeout_seconds * 1000),
    }
    if args.camera:
        payload["camera"] = args.camera
    if args.output:
        payload["output"] = args.output
    result = termux_api_call(args, "camera-photo", payload)
    emit_success(args, result, command="camera.photo")
    return 0


def command_media_scan(args: argparse.Namespace) -> int:
    result = termux_api_call(args, "media-scan", {"paths": args.paths})
    emit_success(args, result, command="media.scan")
    return 0


def command_media_player(args: argparse.Namespace) -> int:
    payload = {"action": args.media_action}
    if args.source:
        payload["source"] = args.source
    emit_success(args, termux_api_call(args, "media-player", payload), command=f"media.player.{args.media_action}")
    return 0


def command_mic_record(args: argparse.Namespace) -> int:
    payload = {"action": args.record_action}
    if args.file:
        payload["file"] = args.file
    if args.bit_rate:
        payload["bitRate"] = args.bit_rate
    if args.sample_rate:
        payload["sampleRate"] = args.sample_rate
    emit_success(args, termux_api_call(args, "microphone-record", payload), command=f"microphone.record.{args.record_action}")
    return 0


def command_download(args: argparse.Namespace) -> int:
    payload = {"url": args.url}
    if args.title:
        payload["title"] = args.title
    if args.description:
        payload["description"] = args.description
    if args.path:
        payload["path"] = args.path
    emit_success(args, termux_api_call(args, "download", payload), command="download")
    return 0


def command_share(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {}
    if args.text or args.stdin:
        payload["text"] = command_text_arg(args, "text")
    if args.file:
        payload["file"] = args.file
    if args.mime:
        payload["mime"] = args.mime
    if args.title:
        payload["title"] = args.title
    emit_success(args, termux_api_call(args, "share", payload), command="share")
    return 0


def build_common_parent() -> argparse.ArgumentParser:
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument("--config", default=argparse.SUPPRESS, help="Config file path")
    parent.add_argument("--base-url", default=argparse.SUPPRESS, help="AutoTermux HTTP base URL")
    parent.add_argument("--authority", default=argparse.SUPPRESS, help="AutoTermux ContentProvider authority")
    parent.add_argument("--user", default=argparse.SUPPRESS, help="Android user id for am/content commands")
    parent.add_argument("--token", default=argparse.SUPPRESS, help="AutoTermux bearer token")
    parent.add_argument("--transport", choices=("bridge", "provider"), default=argparse.SUPPRESS, help="IPC transport; bridge is the default. (HTTP transport is intentionally not exposed on the CLI; AutoTermux retains the server internally for other clients.)")
    parent.add_argument("--timeout", type=float, default=argparse.SUPPRESS, help="HTTP timeout in seconds")
    parent.add_argument(
        "--format",
        dest="output_format",
        choices=("json", "pretty", "raw", "none"),
        default=argparse.SUPPRESS,
        help="Output format; json is compact and machine-readable",
    )
    parent.add_argument("--json", dest="output_format", action="store_const", const="json", default=argparse.SUPPRESS)
    parent.add_argument("--pretty", dest="output_format", action="store_const", const="pretty", default=argparse.SUPPRESS)
    parent.add_argument("--raw", dest="output_format", action="store_const", const="raw", default=argparse.SUPPRESS)
    parent.add_argument("--compact", dest="output_format", action="store_const", const="json", default=argparse.SUPPRESS)
    parent.add_argument("-q", "--quiet", dest="output_format", action="store_const", const="none", default=argparse.SUPPRESS)
    return parent


def add_parser(subparsers: argparse._SubParsersAction, name: str, parent: argparse.ArgumentParser, **kwargs: Any) -> argparse.ArgumentParser:
    return subparsers.add_parser(name, parents=[parent], **kwargs)


def set_command(parser: argparse.ArgumentParser, command_path: str, func: Any) -> None:
    parser.set_defaults(command_path=command_path, func=func)


def add_ui_scope_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--package", help="Limit UI inspection/action to accessibility windows from this package")


def add_ui_verification_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--expect-package", help="After the action, require this package to become the active accessibility package")
    parser.add_argument("--expect-activity", help="After the action, require this exact activity name")
    parser.add_argument("--expect-text", help="After the action, require this exact visible text or content description")
    parser.add_argument("--expect-text-contains", help="After the action, require visible text/content description containing this value")
    parser.add_argument("--verify-timeout", type=float, default=5.0, help="Seconds to wait for verification")
    parser.add_argument("--verify-interval", type=float, default=0.25, help="Seconds between verification probes")


def add_json_payload_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--data", help="JSON object, @file, or - for stdin")
    parser.add_argument("-p", "--param", action="append", help="Add JSON field as KEY=VALUE; may be repeated")


def add_event_filter_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--type", dest="types", action="append", help="Only match this event type; may be repeated")
    parser.add_argument("--package", help="Only match events whose payload package/packageName equals this value")
    parser.add_argument("--title-contains", dest="title_contains", help="Only match notification/action titles containing this text")
    parser.add_argument("--text-contains", dest="text_contains", help="Only match text/content/body/message/reply fields containing this text")
    parser.add_argument("--from", dest="from_", help="Only match sender/address/phone_number fields containing this text")
    parser.add_argument("--payload-contains", dest="payload_contains", help="Only match events whose payload contains this text anywhere")
    parser.add_argument("--match", action="append", help="Only match exact KEY=VALUE payload fields; dot paths are supported")
    parser.add_argument("--match-contains", action="append", help="Only match KEY=TEXT payload fields by substring; dot paths are supported")


def add_trigger_rule_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--id", dest="rule_id", help="Explicit rule id; generated by AutoTermux if omitted")
    parser.add_argument("--disabled", action="store_true", help="Save the rule disabled")
    parser.add_argument("--package", help="Package/packageName filter")
    parser.add_argument("--title-contains", dest="title_contains", help="Notification title substring or regex")
    parser.add_argument("--text-contains", dest="text_contains", help="Notification/app text substring or regex")
    parser.add_argument("--from", dest="from_", help="SMS sender/phone number substring or regex")
    parser.add_argument("--message-contains", dest="message_contains", help="SMS message substring or regex")
    parser.add_argument("--regex", action="store_true", help="Treat string filters as case-insensitive regex")
    parser.add_argument("--threshold", type=int, help="Battery threshold value")
    parser.add_argument("--threshold-comparison", choices=("at-or-below", "at-or-above", "AT_OR_BELOW", "AT_OR_ABOVE"))
    parser.add_argument("--network-type", choices=("none", "wifi", "cellular", "ethernet", "other", "NONE", "WIFI", "CELLULAR", "ETHERNET", "OTHER"))
    parser.add_argument("--delay-minutes", type=int, help="TIME_DELAY delay in minutes")
    parser.add_argument("--absolute-time-ms", type=int, help="TIME_ABSOLUTE wall-clock time in epoch milliseconds")
    parser.add_argument("--daily-hour", type=int, help="TIME_DAILY/TIME_WEEKLY hour, 0-23")
    parser.add_argument("--daily-minute", type=int, help="TIME_DAILY/TIME_WEEKLY minute, 0-59")
    parser.add_argument("--weekday", type=int, action="append", help="TIME_WEEKLY Android Calendar day, 1=Sunday..7=Saturday; may repeat")
    parser.add_argument("--cooldown-seconds", type=int, help="Minimum seconds between matches")
    parser.add_argument("--max-launch-count", type=int, help="Disable after this many successful command launches")
    parser.add_argument("--busy-policy", choices=("skip", "queue", "SKIP", "QUEUE"), help="What to do when a matched signal arrives while in cooldown: SKIP (default) or QUEUE")
    parser.add_argument("--notification-debounce-ms", type=int, dest="notification_debounce_ms", help="For NOTIFICATION_POSTED rules: merge bursts within this window into a single launch (ms). 0 disables debounce.")
    parser.add_argument("--command", help="Termux command path launched through RunCommandService when the trigger fires")
    parser.add_argument("--arg", action="append", help="Command argument template; may repeat")
    parser.add_argument("--stdin-template", help="Template sent to command stdin; defaults to prompt")
    parser.add_argument("--workdir", help="Termux working directory")
    parser.add_argument("--runner", default="app-shell", help="RunCommand runner; default app-shell")
    parser.add_argument("--foreground", action="store_true", help="Launch as a foreground terminal-session command")
    parser.add_argument("--command-label", help="RunCommand notification/session label")


def build_parser() -> argparse.ArgumentParser:
    common = build_common_parent()
    parser = argparse.ArgumentParser(
        description="Control Android through AutoTermux.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common],
        epilog="""examples:
  tp-android doctor
  tp-android ui dump --pretty
  tp-android input tap 540 1200
  tp-android app launch com.android.settings
  tp-android call tap -p x=540 -p y=1200
""",
    )
    parser.set_defaults(output_format="json", timeout=10.0)
    parser.add_argument("--version", action="version", version=f"tp-android {TP_ANDROID_VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    config = add_parser(subparsers, "config", common, help="Read or write local CLI configuration")
    config_sub = config.add_subparsers(dest="config_command", required=True)
    config_show = add_parser(config_sub, "show", common, help="Show effective configuration")
    config_show.add_argument("--show-token", action="store_true", help="Print the secret token")
    set_command(config_show, "config.show", command_config_show)
    config_set = add_parser(config_sub, "set", common, help="Save configuration values")
    config_set.add_argument("--token-stdin", action="store_true", help="Read token from stdin")
    set_command(config_set, "config.set", command_config_set)
    config_unset = add_parser(config_sub, "unset", common, help="Remove configuration keys")
    config_unset.add_argument("keys", nargs="+", choices=("base_url", "authority", "user", "token", "transport"))
    set_command(config_unset, "config.unset", command_config_unset)
    config_path = add_parser(config_sub, "path", common, help="Print config file path")
    set_command(config_path, "config.path", command_config_path)
    config_remote = add_parser(config_sub, "remote", common, help="Inspect AutoTermux runtime configuration")
    config_remote_sub = config_remote.add_subparsers(dest="config_remote_command", required=True)
    config_remote_show = add_parser(config_remote_sub, "show", common, help="Show AutoTermux runtime configuration")
    config_remote_show.add_argument("--show-token", action="store_true", help="Include the remote HTTP/WebSocket auth token")
    set_command(config_remote_show, "config.remote.show", command_remote_config_show)

    install_companion = add_parser(subparsers, "install-companion", common, help="Install or update the embedded AutoTermux app")
    install_companion.add_argument("--skip-asset-check", action="store_true")
    set_command(install_companion, "companion.install", command_install_companion)

    ping = add_parser(subparsers, "ping", common, help="Ping AutoTermux through the selected transport")
    set_command(ping, "ping", command_ping)

    doctor = add_parser(subparsers, "doctor", common, help="Check AutoTermux connectivity")
    set_command(doctor, "doctor", command_doctor)

    version_info = add_parser(subparsers, "version", common, help="Print the AutoTermux companion version")
    set_command(version_info, "version", command_version_info)

    # NOTE: HTTP/WebSocket server management is intentionally NOT exposed on the
    # CLI. tp-android always talks over the bridge transport. AutoTermux keeps
    # the HTTP server code internally for other consumers, but starting/stopping
    # it is not a user-facing concern.

    mode = add_parser(subparsers, "mode", common, help="Inspect or control AutoTermux runtime modes")
    mode_sub = mode.add_subparsers(dest="mode_command", required=True)
    mode_status = add_parser(mode_sub, "status", common, help="Show accessibility/no-a11y/server mode status")
    set_command(mode_status, "mode.status", command_mode_status)
    no_a11y = add_parser(mode_sub, "no-a11y", common, help="Control no-accessibility local-server mode")
    no_a11y_sub = no_a11y.add_subparsers(dest="no_a11y_command", required=True)
    no_a11y_set = add_parser(no_a11y_sub, "set", common, help="Enable or disable no-a11y mode")
    no_a11y_set.add_argument("enabled", type=parse_bool)
    set_command(no_a11y_set, "mode.no-a11y.set", command_mode_no_a11y_set)
    no_a11y_enable = add_parser(no_a11y_sub, "enable", common, help="Enable no-a11y mode")
    no_a11y_enable.set_defaults(enabled=True)
    set_command(no_a11y_enable, "mode.no-a11y.set", command_mode_no_a11y_set)
    no_a11y_disable = add_parser(no_a11y_sub, "disable", common, help="Disable no-a11y mode")
    no_a11y_disable.set_defaults(enabled=False)
    set_command(no_a11y_disable, "mode.no-a11y.set", command_mode_no_a11y_set)
    auto_accept = add_parser(mode_sub, "auto-accept", common, help="Control guarded auto-accept for portal-initiated prompts")
    auto_accept_sub = auto_accept.add_subparsers(dest="auto_accept_command", required=True)
    auto_accept_status = add_parser(auto_accept_sub, "status", common, help="Show auto-accept mode status")
    set_command(auto_accept_status, "mode.auto-accept.status", command_mode_auto_accept_status)
    auto_accept_set = add_parser(auto_accept_sub, "set", common, help="Enable or disable an auto-accept target")
    auto_accept_set.add_argument("target", choices=("screenshot", "install", "all"))
    auto_accept_set.add_argument("enabled", type=parse_bool)
    set_command(auto_accept_set, "mode.auto-accept.set", command_mode_auto_accept_set)
    auto_accept_enable = add_parser(auto_accept_sub, "enable", common, help="Enable an auto-accept target")
    auto_accept_enable.add_argument("target", choices=("screenshot", "install", "all"))
    auto_accept_enable.set_defaults(enabled=True)
    set_command(auto_accept_enable, "mode.auto-accept.set", command_mode_auto_accept_set)
    auto_accept_disable = add_parser(auto_accept_sub, "disable", common, help="Disable an auto-accept target")
    auto_accept_disable.add_argument("target", choices=("screenshot", "install", "all"))
    auto_accept_disable.set_defaults(enabled=False)
    set_command(auto_accept_disable, "mode.auto-accept.set", command_mode_auto_accept_set)

    event = add_parser(subparsers, "event", common, help="Inspect or control local WebSocket device-event filters")
    event_sub = event.add_subparsers(dest="event_command", required=True)
    event_list = add_parser(event_sub, "list", common, help="List event types and enabled status")
    set_command(event_list, "event.status", command_event_status)
    event_status = add_parser(event_sub, "status", common, help="Show all events or one event")
    event_status.add_argument("event", nargs="?")
    set_command(event_status, "event.status", command_event_status)
    event_set = add_parser(event_sub, "set", common, help="Enable or disable one event type")
    event_set.add_argument("event")
    event_set.add_argument("enabled", type=parse_bool)
    set_command(event_set, "event.set", command_event_set)
    event_enable = add_parser(event_sub, "enable", common, help="Enable one event type")
    event_enable.add_argument("event")
    event_enable.set_defaults(enabled=True)
    set_command(event_enable, "event.set", command_event_set)
    event_disable = add_parser(event_sub, "disable", common, help="Disable one event type")
    event_disable.add_argument("event")
    event_disable.set_defaults(enabled=False)
    set_command(event_disable, "event.set", command_event_set)
    event_watch = add_parser(event_sub, "watch", common, help="Stream local WebSocket device events")
    event_watch.add_argument("--url", help="Explicit ws:// or wss:// URL")
    event_watch.add_argument("--port", type=int, help="Local WebSocket port; default 8081")
    event_watch.add_argument("--event-format", choices=("default", "rpc", "legacy"), default="default")
    add_event_filter_options(event_watch)
    event_watch.add_argument("--count", type=int, help="Exit after N events")
    event_watch.add_argument("--duration", type=float, help="Exit after this many seconds")
    set_command(event_watch, "event.watch", command_event_watch)
    event_wait = add_parser(event_sub, "wait", common, help="Wait for the next matching local WebSocket device event")
    event_wait.add_argument("--url", help="Explicit ws:// or wss:// URL")
    event_wait.add_argument("--port", type=int, help="Local WebSocket port; default 8081")
    event_wait.add_argument("--event-format", choices=("default", "rpc", "legacy"), default="default")
    add_event_filter_options(event_wait)
    event_wait.add_argument("--wait-timeout", type=float, default=30.0, help="Seconds to wait for a matching event")
    set_command(event_wait, "event.wait", command_event_wait)

    trigger = add_parser(subparsers, "trigger", common, help="Manage persistent AutoTermux trigger rules")
    trigger_sub = trigger.add_subparsers(dest="trigger_command", required=True)
    trigger_catalog = add_parser(trigger_sub, "catalog", common, help="List supported trigger sources and metadata")
    set_command(trigger_catalog, "trigger.catalog", command_trigger_catalog)
    trigger_status = add_parser(trigger_sub, "status", common, help="Show trigger runtime and permission status")
    set_command(trigger_status, "trigger.status", command_trigger_status)

    trigger_rule = add_parser(trigger_sub, "rule", common, help="Manage trigger rules")
    trigger_rule_sub = trigger_rule.add_subparsers(dest="trigger_rule_command", required=True)
    trigger_rule_list = add_parser(trigger_rule_sub, "list", common, help="List trigger rules")
    set_command(trigger_rule_list, "trigger.rule.list", command_trigger_rule_list)
    trigger_rule_get = add_parser(trigger_rule_sub, "get", common, help="Get a trigger rule")
    trigger_rule_get.add_argument("rule_id")
    set_command(trigger_rule_get, "trigger.rule.get", command_trigger_rule_get)
    trigger_rule_add = add_parser(trigger_rule_sub, "add", common, help="Create a trigger rule from CLI options")
    trigger_rule_add.add_argument("name")
    trigger_rule_add.add_argument("source")
    trigger_rule_add.add_argument("--prompt", required=True, help="Prompt/template rendered when the rule fires")
    add_trigger_rule_options(trigger_rule_add)
    set_command(trigger_rule_add, "trigger.rule.add", command_trigger_rule_add)
    trigger_rule_save = add_parser(trigger_rule_sub, "save", common, help="Save a raw trigger rule JSON object")
    trigger_rule_save.add_argument("rule", nargs="?", help="JSON object, @file, or - for stdin")
    trigger_rule_save.add_argument("--data", help="JSON object, @file, or - for stdin")
    set_command(trigger_rule_save, "trigger.rule.save", command_trigger_rule_save)
    trigger_rule_delete = add_parser(trigger_rule_sub, "delete", common, help="Delete a trigger rule")
    trigger_rule_delete.add_argument("rule_id")
    set_command(trigger_rule_delete, "trigger.rule.delete", command_trigger_rule_delete)
    trigger_rule_enable = add_parser(trigger_rule_sub, "enable", common, help="Enable a trigger rule")
    trigger_rule_enable.add_argument("rule_id")
    trigger_rule_enable.set_defaults(enabled=True)
    set_command(trigger_rule_enable, "trigger.rule.set-enabled", command_trigger_rule_set_enabled)
    trigger_rule_disable = add_parser(trigger_rule_sub, "disable", common, help="Disable a trigger rule")
    trigger_rule_disable.add_argument("rule_id")
    trigger_rule_disable.set_defaults(enabled=False)
    set_command(trigger_rule_disable, "trigger.rule.set-enabled", command_trigger_rule_set_enabled)
    trigger_rule_test = add_parser(trigger_rule_sub, "test", common, help="Launch a test run for a trigger rule")
    trigger_rule_test.add_argument("rule_id")
    set_command(trigger_rule_test, "trigger.rule.test", command_trigger_rule_test)

    trigger_run = add_parser(trigger_sub, "run", common, help="Inspect trigger run history")
    trigger_run_sub = trigger_run.add_subparsers(dest="trigger_run_command", required=True)
    trigger_run_list = add_parser(trigger_run_sub, "list", common, help="List trigger run records")
    trigger_run_list.add_argument("--limit", type=int, default=50)
    set_command(trigger_run_list, "trigger.run.list", command_trigger_run_list)
    trigger_run_delete = add_parser(trigger_run_sub, "delete", common, help="Delete a trigger run record")
    trigger_run_delete.add_argument("run_id")
    set_command(trigger_run_delete, "trigger.run.delete", command_trigger_run_delete)
    trigger_run_clear = add_parser(trigger_run_sub, "clear", common, help="Clear trigger run history")
    set_command(trigger_run_clear, "trigger.run.clear", command_trigger_run_clear)

    provider = add_parser(subparsers, "provider", common, help="Raw ContentProvider passthrough")
    provider_sub = provider.add_subparsers(dest="provider_command", required=True)
    provider_query_cmd = add_parser(provider_sub, "query", common, help="Run a raw content query path")
    provider_query_cmd.add_argument("path")
    set_command(provider_query_cmd, "provider.query", command_provider_query)
    provider_insert_cmd = add_parser(provider_sub, "insert", common, help="Run a raw content insert path")
    provider_insert_cmd.add_argument("path")
