            args,
            "/phone_state/cache",
            {},
            output=args.output,
            command=getattr(args, "command_path", "ui.phone-state"),
        )
    emit_success(args, portal_get("/phone_state", args), command=getattr(args, "command_path", "ui.phone-state"))
    return 0


def scoped_ui_payload(args: argparse.Namespace, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    out: dict[str, Any] = dict(payload or {})
    package_name = getattr(args, "package", None) or getattr(args, "package_name", None)
    if package_name:
        out["packageName"] = package_name
    return out


def emit_json_result_or_output(
    args: argparse.Namespace,
    result: Any,
    *,
    output: str | None,
    command: str,
) -> int:
    if output:
        encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode()
        if output == "-":
            sys.stdout.buffer.write(encoded)
            sys.stdout.buffer.write(b"\n")
            return 0
        path = Path(output)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(encoded)
        emit_success(args, {"path": str(path), "bytes": len(encoded)}, command=command)
        return 0
    emit_success(args, result, command=command)
    return 0


def command_ui_windows(args: argparse.Namespace) -> int:
    result = portal_post("/ui/windows", args, {})
    return emit_json_result_or_output(
        args,
        result,
        output=getattr(args, "output", None),
        command=getattr(args, "command_path", "ui.windows"),
    )


