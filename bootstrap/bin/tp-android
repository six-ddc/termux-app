    return 0


def command_keepalive_watch(args: argparse.Namespace) -> int:
    interval = max(5.0, float(args.interval))
    while True:
        components = [_keepalive_probe_termux(), _keepalive_probe_bridge(args)]
        if components[-1]["ok"]:
            components.append(_keepalive_probe_a11y(args))
            components.append(_keepalive_probe_notification_listener(args))
        critical_ok = all(
            c["ok"] is True
            for c in components
            if c["name"] in {"termux", "autotermux_bridge", "accessibility_service"}
        )
        print_json({"ok": critical_ok, "at": _status_now_ms(), "components": components}, compact=True)
        if not critical_ok and args.notify_run:
            try:
                run = _status_load_run(args.notify_run)
                _status_append_event(
                    run,
                    "keepalive_degraded",
                    components=[c for c in components if c["ok"] is not True],
                )
                _status_save_run(run)
            except CliError:
                pass
        time.sleep(interval)


def command_version_info(args: argparse.Namespace) -> int:
    emit_success(args, portal_get("/version", args), command=getattr(args, "command_path", "version"))
    return 0


def portal_get(path: str, args: argparse.Namespace) -> Any:
    config = load_runtime_config(args)
    transport = config_transport(config)
    if transport == "bridge":
        clean_path = path.lstrip("/")
        parsed = urllib.parse.urlparse("/" + clean_path)
        query = urllib.parse.parse_qs(parsed.query)
        method = parsed.path.lstrip("/")
        if method == "state_full":
            return bridge_call(config, "state_full", {"filter": query.get("filter", ["true"])[0].lower() != "false"})
        if method == "state":
            return bridge_call(config, "state", {"filter": query.get("filter", ["true"])[0].lower() != "false"})
        if method == "a11y_tree_full":
            return bridge_call(config, "a11y_tree_full", {"filter": query.get("filter", ["true"])[0].lower() != "false"})
        if method == "a11y_tree":
            return bridge_call(config, "a11y_tree")
        if method == "phone_state":
            return bridge_call(config, "phone_state")
        if method == "screenshot":
            return bridge_call(config, "screenshot", {"hideOverlay": query.get("hideOverlay", ["true"])[0].lower() != "false"})
        return bridge_call(config, method)

    # transport == "provider"
    clean_path = path.lstrip("/")
    if clean_path.startswith("screenshot"):
        parsed = urllib.parse.urlparse("/" + clean_path)
        query = urllib.parse.parse_qs(parsed.query)
        hide_overlay = query.get("hideOverlay", ["true"])[0].lower() != "false"
        return provider_action(config, "screenshot", {"hideOverlay": hide_overlay})
    return provider_query(config_authority(config), clean_path)


def portal_post(path: str, args: argparse.Namespace, payload: dict[str, Any]) -> Any:
    config = load_runtime_config(args)
    transport = config_transport(config)
    if transport == "bridge":
        return bridge_call(config, path, payload)
    # transport == "provider"
    return provider_action(config, path, payload)


def command_observe(args: argparse.Namespace) -> int:
    method = "state_full" if args.full else "state"
    filter_enabled = getattr(args, "filter", not getattr(args, "no_filter", False))
    output = getattr(args, "output", None)
    payload = scoped_ui_payload(args, {"filter": filter_enabled})
    if output or getattr(args, "cache", False):
        return emit_cached_json_command(
            args,
            f"/{method}/cache",
            payload,
            output=output,
            command=getattr(args, "command_path", "ui.dump"),
            result_extra={"full": args.full, "filter": filter_enabled},
        )

    if getattr(args, "package", None):
        emit_success(args, portal_post(f"/{method}", args, payload), command=getattr(args, "command_path", "ui.dump"))
        return 0
    path = f"/{method}"
    if not filter_enabled:
        path += "?filter=false"
    emit_success(args, portal_get(path, args), command=getattr(args, "command_path", "ui.dump"))
    return 0


def emit_cached_json_command(
    args: argparse.Namespace,
    method: str,
    payload: dict[str, Any],
    *,
    output: str | None,
    command: str,
    result_extra: dict[str, Any] | None = None,
) -> int:
    result = portal_post(method, args, payload)
    if not isinstance(result, dict) or not isinstance(result.get("path"), str):
        raise CliError("Unexpected cached JSON response")
    cache_path = result["path"]
    if output:
        bytes_written = copy_transfer_cache_to_output(cache_path, output, args)
        if output == "-":
            return 0
        emitted = {
            "path": str(Path(output)),
            "bytes": bytes_written,
            "cache_path": cache_path,
            **(result_extra or {}),
        }
    else:
        emitted = {**result, **(result_extra or {})}
    emit_success(args, emitted, command=command)
    return 0


def command_ui_tree(args: argparse.Namespace) -> int:
    method = "a11y_tree_full" if args.full else "a11y_tree"
    payload = scoped_ui_payload(args, {"filter": args.filter})
    if args.output or args.cache:
        return emit_cached_json_command(
            args,
            f"/{method}/cache",
            payload,
            output=args.output,
            command=getattr(args, "command_path", "ui.tree"),
            result_extra={"full": args.full, "filter": args.filter},
        )
    if getattr(args, "package", None):
        emit_success(args, portal_post(f"/{method}", args, payload), command=getattr(args, "command_path", "ui.tree"))
        return 0
    path = f"/{method}"
    if args.full and not args.filter:
        path += "?filter=false"
    emit_success(args, portal_get(path, args), command=getattr(args, "command_path", "ui.tree"))
    return 0


UI_DIGEST_CACHE_PATH = Path(
    os.environ.get("TP_UI_DIGEST_CACHE")
    or (Path(os.environ.get("HOME", "/data/data/com.termux/files/home")) / ".termuxplus" / "ui-digest.json")
)


def _ui_digest_collect(node: Any, depth: int = 0, out: list[dict[str, Any]] | None = None) -> list[dict[str, Any]]:
    """Walk an a11y tree and collect interactive nodes in traversal order.

    Each emitted entry: {idx, text, hint, bounds, actions, class, package, depth, resource}.
    Only keeps nodes where the user can do something (click/long-click/scroll/edit).
    """
    if out is None:
        out = []
    if not isinstance(node, dict):
        return out

    clickable = bool(node.get("clickable") or node.get("isClickable"))
    long_clickable = bool(node.get("longClickable") or node.get("isLongClickable"))
    scrollable = bool(node.get("scrollable") or node.get("isScrollable"))
    editable = bool(node.get("editable") or node.get("isEditable"))
    focusable = bool(node.get("focusable") or node.get("isFocusable"))
    focused = bool(node.get("focused") or node.get("isFocused"))

    is_interactive = clickable or long_clickable or scrollable or editable or (focusable and focused)
    text = (node.get("text") or "").strip() if isinstance(node.get("text"), str) else ""
    desc = (node.get("contentDescription") or node.get("contentDesc") or "").strip() if isinstance(node.get("contentDescription") or node.get("contentDesc"), str) else ""
    hint = (node.get("hintText") or node.get("hint") or "").strip() if isinstance(node.get("hintText") or node.get("hint"), str) else ""

    # We also keep nodes with non-empty text/desc even if not interactive — they
    # provide reading-anchor for the agent. Cap below to avoid bloat.
    has_label = bool(text or desc or hint)

    if is_interactive or (has_label and depth <= 6):
        actions: list[str] = []
        if clickable:
            actions.append("click")
        if long_clickable:
            actions.append("long-click")
        if scrollable:
            actions.append("scroll")
        if editable:
            actions.append("set-text")
        bounds = node.get("bounds")
        bounds_str: str | None = None
        if isinstance(bounds, dict):
            try:
                bounds_str = f"{int(bounds['left'])},{int(bounds['top'])},{int(bounds['right'])},{int(bounds['bottom'])}"
            except (KeyError, TypeError, ValueError):
                bounds_str = None
        elif isinstance(bounds, str):
            bounds_str = bounds

        entry: dict[str, Any] = {
            "idx": len(out),
            "text": text or None,
            "desc": desc or None,
            "hint": hint or None,
            "bounds": bounds_str,
            "actions": actions,
            "class": node.get("className") or node.get("class"),
            "package": node.get("packageName") or node.get("package"),
            "depth": depth,
            "resource": node.get("resourceName") or node.get("viewIdResourceName") or node.get("resource"),
            "focused": focused or None,
        }
        # Drop None fields for compactness
        out.append({k: v for k, v in entry.items() if v not in (None, "", [], {})})

    children = node.get("children") or node.get("childNodes") or []
    if isinstance(children, list):
        for child in children:
            _ui_digest_collect(child, depth + 1, out)
    return out


def _ui_digest_write_cache(digest: dict[str, Any]) -> None:
    UI_DIGEST_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = UI_DIGEST_CACHE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(digest, ensure_ascii=False), encoding="utf-8")
    os.replace(tmp, UI_DIGEST_CACHE_PATH)


def _ui_digest_read_cache() -> dict[str, Any] | None:
    try:
        return json.loads(UI_DIGEST_CACHE_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def command_ui_digest(args: argparse.Namespace) -> int:
    payload = scoped_ui_payload(args, {"filter": True})
    raw = portal_post("/a11y_tree_full", args, payload)
    # Server may return tree as either dict (root node) or string (JSON-encoded).
    if isinstance(raw, str):
        try:
            raw = json.loads(raw)
        except json.JSONDecodeError:
            raise CliError("Unexpected ui digest tree shape (string not JSON)", code="BRIDGE_PARSE_FAILED")
    if isinstance(raw, list):
        # Some endpoints return an array of root nodes (windows)
        nodes: list[dict[str, Any]] = []
        for root in raw:
            _ui_digest_collect(root, 0, nodes)
    elif isinstance(raw, dict):
        nodes = _ui_digest_collect(raw, 0, [])
    else:
        raise CliError("Unexpected ui digest tree shape", code="BRIDGE_PARSE_FAILED")

    # Re-index after filtering to keep idx contiguous and stable.
    if args.only_clickable:
        nodes = [n for n in nodes if any(a in {"click", "long-click"} for a in n.get("actions", []))]
    if args.max_nodes and len(nodes) > args.max_nodes:
        nodes = nodes[: args.max_nodes]
    for i, n in enumerate(nodes):
        n["idx"] = i

    # Pull a tiny header from phone-state so the agent doesn't need a second call.
    try:
        phone_state = portal_get("/phone_state", args)
    except CliError:
        phone_state = None

    digest: dict[str, Any] = {
        "captured_at": _status_now_ms(),
        "package": args.package,
        "app": phone_state if isinstance(phone_state, dict) else None,
        "count": len(nodes),
        "elements": nodes,
    }
    _ui_digest_write_cache(digest)
    if args.output:
        return emit_json_result_or_output(args, digest, output=args.output, command="ui.digest")
    emit_success(args, digest, command="ui.digest")
    return 0


def _ui_resolve_idx_bounds(idx: int) -> tuple[int, int]:
    """Look up the cached digest, return the center (x, y) for `idx`."""
    cache = _ui_digest_read_cache()
    if not isinstance(cache, dict):
        raise CliError(
            "No cached ui digest; run `tp-android ui digest` first",
            code="TARGET_NOT_FOUND",
        )
    for node in cache.get("elements", []):
        if node.get("idx") == idx:
            bounds = node.get("bounds")
            if not isinstance(bounds, str):
                raise CliError(f"idx={idx} has no bounds", code="TARGET_NOT_CLICKABLE")
            parts = [int(p) for p in bounds.split(",")]
            if len(parts) != 4:
                raise CliError(f"Bad bounds for idx={idx}: {bounds}", code="TARGET_NOT_CLICKABLE")
            left, top, right, bottom = parts
            return ((left + right) // 2, (top + bottom) // 2)
    raise CliError(f"idx={idx} not in cached digest", code="TARGET_NOT_FOUND")


def command_ui_phone_state(args: argparse.Namespace) -> int:
    if args.output or args.cache:
        return emit_cached_json_command(
            args,
            "/phone_state/cache",
            {},
            output=args.output,
            command=getattr(args, "command_path", "ui.phone-state"),
        )
    emit_success(args, portal_get("/phone_state", args), command=getattr(args, "command_path", "ui.phone-state"))
    return 0


def scoped_ui_payload(args: argparse.Namespace, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    out: dict[str, Any] = dict(payload or {})
    package_name = getattr(args, "package", None) or getattr(args, "package_name", None)
    if package_name:
        out["packageName"] = package_name
    return out


def emit_json_result_or_output(
    args: argparse.Namespace,
    result: Any,
    *,
    output: str | None,
    command: str,
) -> int:
    if output:
        encoded = json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode()
        if output == "-":
            sys.stdout.buffer.write(encoded)
            sys.stdout.buffer.write(b"\n")
            return 0
        path = Path(output)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(encoded)
        emit_success(args, {"path": str(path), "bytes": len(encoded)}, command=command)
        return 0
    emit_success(args, result, command=command)
    return 0


def command_ui_windows(args: argparse.Namespace) -> int:
    result = portal_post("/ui/windows", args, {})
    return emit_json_result_or_output(
        args,
        result,
        output=getattr(args, "output", None),
        command=getattr(args, "command_path", "ui.windows"),
    )


