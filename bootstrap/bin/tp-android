def event_message_type(value: Any) -> str | None:
    if not isinstance(value, dict):
        return None
    event_type = value.get("type")
    if isinstance(event_type, str) and event_type:
        return event_type.upper()
    params = value.get("params")
    if isinstance(params, dict):
        event_type = params.get("type")
        if isinstance(event_type, str) and event_type:
            return event_type.upper()
    return None


def event_payload_root(value: Any) -> Any:
    if not isinstance(value, dict):
        return {}
    params = value.get("params")
    if isinstance(params, dict) and params.get("method") != "events/device":
        return params.get("payload", params)
    if isinstance(params, dict):
        return params.get("payload", params)
    return value.get("payload", value)


def iter_json_scalars(value: Any) -> list[str]:
    values: list[str] = []
    if isinstance(value, dict):
        for item in value.values():
            values.extend(iter_json_scalars(item))
    elif isinstance(value, list):
        for item in value:
            values.extend(iter_json_scalars(item))
    elif value is not None:
        values.append(str(value))
    return values


def json_key_values(value: Any, keys: set[str]) -> list[str]:
    values: list[str] = []
    if isinstance(value, dict):
        for key, item in value.items():
            if key.lower() in keys:
                values.extend(iter_json_scalars(item))
            values.extend(json_key_values(item, keys))
    elif isinstance(value, list):
        for item in value:
            values.extend(json_key_values(item, keys))
    return values


def json_path_values(value: Any, path: str) -> list[str]:
    parts = [part for part in path.split(".") if part]
    if not parts:
        return []

    def walk(current: Any, index: int) -> list[Any]:
        if index >= len(parts):
            return [current]
        part = parts[index]
        if isinstance(current, dict):
            if part in current:
                return walk(current[part], index + 1)
            return []
        if isinstance(current, list):
            out: list[Any] = []
            for item in current:
                out.extend(walk(item, index))
            return out
        return []

    out: list[str] = []
    for item in walk(value, 0):
        out.extend(iter_json_scalars(item))
    return out


def split_event_match_spec(raw_value: str) -> tuple[str, str]:
    key, separator, value = raw_value.partition("=")
    if not separator or not key.strip():
        raise CliError(f"Invalid event match spec: {raw_value!r}; expected KEY=VALUE")
    return key.strip(), value


def event_values_for_selector(event: dict[str, Any], selector: str) -> list[str]:
    payload = event_payload_root(event)
    if "." in selector:
        values = json_path_values(event, selector)
        if not selector.startswith("payload."):
            values.extend(json_path_values(payload, selector))
        return values
    return json_key_values(event, {selector.lower()})


def any_exact(values: list[str], expected: str) -> bool:
    return any(value == expected for value in values)


def any_contains(values: list[str], needle: str) -> bool:
    folded = needle.lower()
    return any(folded in value.lower() for value in values)


def event_message_matches(value: dict[str, Any], args: argparse.Namespace, allowed_types: set[str]) -> bool:
    if allowed_types and event_message_type(value) not in allowed_types:
        return False
    package = getattr(args, "package", None)
    if package and not any_exact(json_key_values(event_payload_root(value), {"package", "packagename"}), package):
        return False
    title_contains = getattr(args, "title_contains", None)
    if title_contains and not any_contains(json_key_values(event_payload_root(value), {"title", "actiontitle"}), title_contains):
        return False
    text_contains = getattr(args, "text_contains", None)
    if text_contains and not any_contains(
        json_key_values(event_payload_root(value), {"text", "content", "body", "message", "reply", "lines"}),
        text_contains,
    ):
        return False
    sender = getattr(args, "from_", None)
    if sender and not any_contains(
        json_key_values(event_payload_root(value), {"from", "address", "phone_number", "phonenumber"}),
        sender,
    ):
        return False
    payload_contains = getattr(args, "payload_contains", None)
    if payload_contains and not any_contains(iter_json_scalars(event_payload_root(value)), payload_contains):
        return False
    for spec in getattr(args, "match", None) or []:
        selector, expected = split_event_match_spec(spec)
        if not any_exact(event_values_for_selector(value, selector), expected):
            return False
    for spec in getattr(args, "match_contains", None) or []:
        selector, expected = split_event_match_spec(spec)
        if not any_contains(event_values_for_selector(value, selector), expected):
            return False
    return True


def command_event_stream(args: argparse.Namespace, *, wait: bool) -> int:
    config = load_runtime_config(args)
    token, _ = resolve_token(config)
    if not token:
        raise CliError("No AutoTermux token found")
    if args.url:
        url = args.url
    else:
        parsed = urllib.parse.urlparse(config_base_url(config))
        host = parsed.hostname or "127.0.0.1"
        port = args.port or 8081
        url = f"ws://{host}:{port}/"
    sock = websocket_connect(url, token, args.event_format, timeout=args.timeout)
    deadline = time.monotonic() + args.duration if args.duration else None
    allowed_types = {
        value.upper().replace("-", "_")
        for value in (getattr(args, "types", None) or [])
        if value
    }
    count = 0
    try:
        while True:
            if args.count is not None and count >= args.count:
                break
            if deadline is not None and time.monotonic() >= deadline:
                break
            timeout = args.timeout
            if deadline is not None:
                timeout = max(0.1, min(timeout, deadline - time.monotonic()))
            sock.settimeout(timeout)
            try:
                opcode, payload = websocket_read_frame(sock)
            except socket.timeout:
                if deadline is not None and time.monotonic() >= deadline:
                    break
                continue
            if opcode == 0x8:
                return 0
            if opcode == 0x9:
                websocket_send_frame(sock, 0xA, payload)
                continue
            if opcode != 0x1:
                continue
            text = payload.decode("utf-8", errors="replace")
            parsed_json: Any | None = None
            try:
                parsed_json = json.loads(text)
            except json.JSONDecodeError:
                if allowed_types or wait:
                    continue
            if isinstance(parsed_json, dict) and not event_message_matches(parsed_json, args, allowed_types):
                continue
            if args.output_format == "none":
                pass
            elif wait:
                emit_success(
                    args,
                    {"matched": True, "event": parsed_json if parsed_json is not None else text},
                    command=getattr(args, "command_path", "event.wait"),
                )
            elif args.output_format == "pretty":
                try:
                    print_json(parsed_json if parsed_json is not None else json.loads(text))
                except json.JSONDecodeError:
                    print(text)
            else:
                try:
                    print_json(parsed_json if parsed_json is not None else json.loads(text), compact=True)
                except json.JSONDecodeError:
                    print(text)
            sys.stdout.flush()
            count += 1
            if wait:
                return 0
    finally:
        try:
            websocket_send_frame(sock, 0x8)
        except Exception:
            pass
        sock.close()
    if wait:
        raise CliError("Timed out waiting for matching event", code="INPUT_TIMEOUT")
    return 0


def command_event_watch(args: argparse.Namespace) -> int:
    return command_event_stream(args, wait=False)


def command_event_wait(args: argparse.Namespace) -> int:
    args.count = 1
    args.duration = args.wait_timeout
    return command_event_stream(args, wait=True)


def trigger_call(args: argparse.Namespace, method: str, payload: dict[str, Any] | None = None) -> Any:
    return portal_post("/" + method.lstrip("/"), args, payload or {})


def normalize_trigger_source(value: str) -> str:
    return value.strip().upper().replace("-", "_")


