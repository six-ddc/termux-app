    )
    return 0


def clamp_int(value: int, minimum: int, maximum: int) -> int:
    return min(max(value, minimum), maximum)


def command_edge_swipe(args: argparse.Namespace) -> int:
    status = portal_post("/screen/status", args, {})
    if not isinstance(status, dict) or "width" not in status or "height" not in status:
        raise CliError("Unexpected screen status response")
    try:
        width = int(status["width"])
        height = int(status["height"])
    except (TypeError, ValueError) as exc:
        raise CliError(f"Invalid screen dimensions: {status!r}") from exc
    if width <= 1 or height <= 1:
        raise CliError(f"Invalid screen dimensions: {width}x{height}")

    direction = args.direction.lower()
    horizontal = direction in ("left", "right")
    axis_extent = width if horizontal else height
    cross_extent = height if horizontal else width
    edge_margin = clamp_int(args.edge_margin, 0, max(0, axis_extent - 1))
    default_distance = max(1, int(axis_extent * 0.35))
    distance = clamp_int(args.distance if args.distance is not None else default_distance, 1, max(1, axis_extent - 1))
    anchor = clamp_int(args.anchor if args.anchor is not None else cross_extent // 2, 0, max(0, cross_extent - 1))

    if direction == "left":
        x1, y1 = edge_margin, anchor
        x2, y2 = min(width - 1, x1 + distance), anchor
    elif direction == "right":
        x1, y1 = width - 1 - edge_margin, anchor
        x2, y2 = max(0, x1 - distance), anchor
    elif direction == "top":
        x1, y1 = anchor, edge_margin
        x2, y2 = anchor, min(height - 1, y1 + distance)
    elif direction == "bottom":
        x1, y1 = anchor, height - 1 - edge_margin
        x2, y2 = anchor, max(0, y1 - distance)
    else:
        raise CliError(f"Unknown edge-swipe direction: {args.direction}")

    result = portal_post(
        "/swipe",
        args,
        {
            "startX": x1,
            "startY": y1,
            "endX": x2,
            "endY": y2,
            "duration": args.duration,
        },
    )
    emit_success(
        args,
        {
            "direction": direction,
            "start": {"x": x1, "y": y1},
            "end": {"x": x2, "y": y2},
            "duration_ms": args.duration,
            "distance": distance,
            "edge_margin": edge_margin,
            "anchor": anchor,
            "screen": {"width": width, "height": height},
            "message": result,
        },
        command=getattr(args, "command_path", "input.edge-swipe"),
    )
    return 0


