    "A11Y_TIMEOUT":               {"hint": "Accessibility service is alive but unresponsive; toggle it off/on in Settings.",              "recoverable": True},
    "NOTIF_LISTENER_DISABLED":    {"hint": "Enable AutoTermux notification listener in Settings. Helper: tp-android setup",               "recoverable": True},
    "PERMISSION_MISSING":         {"hint": "Runtime permission missing. Run: tp-android permissions status --pretty",                     "recoverable": True},
    "OVERLAY_BLOCKED":            {"hint": "SYSTEM_ALERT_WINDOW (Display over other apps) denied for AutoTermux.",                        "recoverable": True},
    "SCREENSHOT_CONSENT_DENIED":  {"hint": "MediaProjection consent cancelled. The next attempt will re-prompt.",                         "recoverable": True},
    "TARGET_NOT_FOUND":           {"hint": "Selector matched nothing. Run: tp-android ui digest (or ui dump) to inspect current screen.", "recoverable": True},
    "TARGET_NOT_CLICKABLE":       {"hint": "Element found but not clickable. Inspect its `actions` field.",                               "recoverable": True},
    "SELECTOR_AMBIGUOUS":         {"hint": "Multiple matches when one was expected. Tighten with --resource-id, --package, or --bounds.", "recoverable": True},
    "USER_CANCELLED":             {"hint": "User pressed Cancel on the HUD.",                                                              "recoverable": False},
    "USER_INTERRUPTED":           {"hint": "User touched the screen mid-flow. Check tp-android status intervene response.",               "recoverable": True},
    "INPUT_TIMEOUT":              {"hint": "Wait expired. Increase --wait-timeout or verify pre-conditions.",                              "recoverable": True},
