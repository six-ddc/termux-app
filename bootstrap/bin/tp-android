def command_keystore_sign(args: argparse.Namespace) -> int:
    cache_path, input_bytes = stage_input_file_for_bridge(args.input)
    result = termux_api_call(
        args,
        "keystore",
        {"command": "sign", "alias": args.alias, "algorithm": args.algorithm, "cachePath": cache_path},
    )
    if args.output:
        if not isinstance(result, dict) or "path" not in result:
            raise CliError("Unexpected keystore sign response")
        copied = copy_transfer_cache_to_output(result["path"], args.output, args)
        if args.output == "-":
            return 0
        emit_success(
            args,
            {
                "path": str(Path(args.output)),
                "bytes": copied,
                "input_bytes": input_bytes,
                "cache_path": result["path"],
                "alias": args.alias,
                "algorithm": args.algorithm,
            },
            command="keystore.sign",
        )
        return 0
    emit_success(args, result, command="keystore.sign")
    return 0


def command_keystore_verify(args: argparse.Namespace) -> int:
    cache_path, _ = stage_input_file_for_bridge(args.input)
    signature_cache_path, _ = stage_input_file_for_bridge(args.signature)
    result = termux_api_call(
        args,
        "keystore",
        {
            "command": "verify",
            "alias": args.alias,
            "algorithm": args.algorithm,
            "cachePath": cache_path,
            "signatureCachePath": signature_cache_path,
        },
    )
    emit_success(args, result, command="keystore.verify")
    return 0


