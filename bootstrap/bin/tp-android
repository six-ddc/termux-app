def build_common_parent() -> argparse.ArgumentParser:
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument("--config", default=argparse.SUPPRESS, help="Config file path")
    parent.add_argument("--base-url", default=argparse.SUPPRESS, help="AutoTermux HTTP base URL")
    parent.add_argument("--authority", default=argparse.SUPPRESS, help="AutoTermux ContentProvider authority")
    parent.add_argument("--user", default=argparse.SUPPRESS, help="Android user id for am/content commands")
    parent.add_argument("--token", default=argparse.SUPPRESS, help="AutoTermux bearer token")
    parent.add_argument("--transport", choices=("bridge", "provider"), default=argparse.SUPPRESS, help="IPC transport; bridge is the default. (HTTP transport is intentionally not exposed on the CLI; AutoTermux retains the server internally for other clients.)")
    parent.add_argument("--timeout", type=float, default=argparse.SUPPRESS, help="HTTP timeout in seconds")
    parent.add_argument(
        "--format",
        dest="output_format",
        choices=("json", "pretty", "raw", "none"),
        default=argparse.SUPPRESS,
        help="Output format; json is compact and machine-readable",
    )
    parent.add_argument("--json", dest="output_format", action="store_const", const="json", default=argparse.SUPPRESS)
    parent.add_argument("--pretty", dest="output_format", action="store_const", const="pretty", default=argparse.SUPPRESS)
    parent.add_argument("--raw", dest="output_format", action="store_const", const="raw", default=argparse.SUPPRESS)
    parent.add_argument("--compact", dest="output_format", action="store_const", const="json", default=argparse.SUPPRESS)
    parent.add_argument("-q", "--quiet", dest="output_format", action="store_const", const="none", default=argparse.SUPPRESS)
    return parent


def add_parser(subparsers: argparse._SubParsersAction, name: str, parent: argparse.ArgumentParser, **kwargs: Any) -> argparse.ArgumentParser:
    return subparsers.add_parser(name, parents=[parent], **kwargs)


def set_command(parser: argparse.ArgumentParser, command_path: str, func: Any) -> None:
    parser.set_defaults(command_path=command_path, func=func)


def add_ui_scope_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--package", help="Limit UI inspection/action to accessibility windows from this package")


def add_ui_verification_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--expect-package", help="After the action, require this package to become the active accessibility package")
    parser.add_argument("--expect-activity", help="After the action, require this exact activity name")
    parser.add_argument("--expect-text", help="After the action, require this exact visible text or content description")
    parser.add_argument("--expect-text-contains", help="After the action, require visible text/content description containing this value")
    parser.add_argument("--verify-timeout", type=float, default=5.0, help="Seconds to wait for verification")
    parser.add_argument("--verify-interval", type=float, default=0.25, help="Seconds between verification probes")


def add_json_payload_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--data", help="JSON object, @file, or - for stdin")
    parser.add_argument("-p", "--param", action="append", help="Add JSON field as KEY=VALUE; may be repeated")


def add_event_filter_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--type", dest="types", action="append", help="Only match this event type; may be repeated")
    parser.add_argument("--package", help="Only match events whose payload package/packageName equals this value")
    parser.add_argument("--title-contains", dest="title_contains", help="Only match notification/action titles containing this text")
    parser.add_argument("--text-contains", dest="text_contains", help="Only match text/content/body/message/reply fields containing this text")
    parser.add_argument("--from", dest="from_", help="Only match sender/address/phone_number fields containing this text")
    parser.add_argument("--payload-contains", dest="payload_contains", help="Only match events whose payload contains this text anywhere")
    parser.add_argument("--match", action="append", help="Only match exact KEY=VALUE payload fields; dot paths are supported")
    parser.add_argument("--match-contains", action="append", help="Only match KEY=TEXT payload fields by substring; dot paths are supported")


def add_trigger_rule_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--id", dest="rule_id", help="Explicit rule id; generated by AutoTermux if omitted")
    parser.add_argument("--disabled", action="store_true", help="Save the rule disabled")
    parser.add_argument("--package", help="Package/packageName filter")
    parser.add_argument("--title-contains", dest="title_contains", help="Notification title substring or regex")
    parser.add_argument("--text-contains", dest="text_contains", help="Notification/app text substring or regex")
    parser.add_argument("--from", dest="from_", help="SMS sender/phone number substring or regex")
    parser.add_argument("--message-contains", dest="message_contains", help="SMS message substring or regex")
    parser.add_argument("--regex", action="store_true", help="Treat string filters as case-insensitive regex")
    parser.add_argument("--threshold", type=int, help="Battery threshold value")
    parser.add_argument("--threshold-comparison", choices=("at-or-below", "at-or-above", "AT_OR_BELOW", "AT_OR_ABOVE"))
    parser.add_argument("--network-type", choices=("none", "wifi", "cellular", "ethernet", "other", "NONE", "WIFI", "CELLULAR", "ETHERNET", "OTHER"))
    parser.add_argument("--delay-minutes", type=int, help="TIME_DELAY delay in minutes")
    parser.add_argument("--absolute-time-ms", type=int, help="TIME_ABSOLUTE wall-clock time in epoch milliseconds")
    parser.add_argument("--daily-hour", type=int, help="TIME_DAILY/TIME_WEEKLY hour, 0-23")
    parser.add_argument("--daily-minute", type=int, help="TIME_DAILY/TIME_WEEKLY minute, 0-59")
    parser.add_argument("--weekday", type=int, action="append", help="TIME_WEEKLY Android Calendar day, 1=Sunday..7=Saturday; may repeat")
    parser.add_argument("--cooldown-seconds", type=int, help="Minimum seconds between matches")
    parser.add_argument("--max-launch-count", type=int, help="Disable after this many successful command launches")
    parser.add_argument("--busy-policy", choices=("skip", "queue", "SKIP", "QUEUE"), help="What to do when a matched signal arrives while in cooldown: SKIP (default) or QUEUE")
    parser.add_argument("--notification-debounce-ms", type=int, dest="notification_debounce_ms", help="For NOTIFICATION_POSTED rules: merge bursts within this window into a single launch (ms). 0 disables debounce.")
    parser.add_argument("--command", help="Termux command path launched through RunCommandService when the trigger fires")
    parser.add_argument("--arg", action="append", help="Command argument template; may repeat")
    parser.add_argument("--stdin-template", help="Template sent to command stdin; defaults to prompt")
    parser.add_argument("--workdir", help="Termux working directory")
    parser.add_argument("--runner", default="app-shell", help="RunCommand runner; default app-shell")
    parser.add_argument("--foreground", action="store_true", help="Launch as a foreground terminal-session command")
    parser.add_argument("--command-label", help="RunCommand notification/session label")


def build_parser() -> argparse.ArgumentParser:
    common = build_common_parent()
    parser = argparse.ArgumentParser(
        description="Control Android through AutoTermux.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common],
        epilog="""examples:
  tp-android doctor
  tp-android ui dump --pretty
  tp-android input tap 540 1200
  tp-android app launch com.android.settings
  tp-android call tap -p x=540 -p y=1200
""",
    )
    parser.set_defaults(output_format="json", timeout=10.0)
    parser.add_argument("--version", action="version", version=f"tp-android {TP_ANDROID_VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    config = add_parser(subparsers, "config", common, help="Read or write local CLI configuration")
    config_sub = config.add_subparsers(dest="config_command", required=True)
    config_show = add_parser(config_sub, "show", common, help="Show effective configuration")
    config_show.add_argument("--show-token", action="store_true", help="Print the secret token")
    set_command(config_show, "config.show", command_config_show)
    config_set = add_parser(config_sub, "set", common, help="Save configuration values")
    config_set.add_argument("--token-stdin", action="store_true", help="Read token from stdin")
    set_command(config_set, "config.set", command_config_set)
    config_unset = add_parser(config_sub, "unset", common, help="Remove configuration keys")
    config_unset.add_argument("keys", nargs="+", choices=("base_url", "authority", "user", "token", "transport"))
    set_command(config_unset, "config.unset", command_config_unset)
    config_path = add_parser(config_sub, "path", common, help="Print config file path")
    set_command(config_path, "config.path", command_config_path)
    config_remote = add_parser(config_sub, "remote", common, help="Inspect AutoTermux runtime configuration")
    config_remote_sub = config_remote.add_subparsers(dest="config_remote_command", required=True)
    config_remote_show = add_parser(config_remote_sub, "show", common, help="Show AutoTermux runtime configuration")
    config_remote_show.add_argument("--show-token", action="store_true", help="Include the remote HTTP/WebSocket auth token")
    set_command(config_remote_show, "config.remote.show", command_remote_config_show)

    install_companion = add_parser(subparsers, "install-companion", common, help="Install or update the embedded AutoTermux app")
    install_companion.add_argument("--skip-asset-check", action="store_true")
    set_command(install_companion, "companion.install", command_install_companion)

    ping = add_parser(subparsers, "ping", common, help="Ping AutoTermux through the selected transport")
    set_command(ping, "ping", command_ping)

    doctor = add_parser(subparsers, "doctor", common, help="Check AutoTermux connectivity")
    set_command(doctor, "doctor", command_doctor)

    # keepalive — the four-process health check (termux / autotermux bridge /
    # a11y service / notification listener). Run at the start of every long
    # run; use --watch for a background watchdog. See L0 in UX plan.
    keepalive = add_parser(subparsers, "keepalive", common, help="Check (and optionally restart) the processes the agent depends on")
    keepalive_sub = keepalive.add_subparsers(dest="keepalive_command", required=True)

    keepalive_ensure = add_parser(keepalive_sub, "ensure", common, help="One-shot health check; exits non-zero if anything critical is down")
    keepalive_ensure.add_argument("--restart", action="store_true", help="When AutoTermux bridge is down, try to relaunch it")
    keepalive_ensure.add_argument("--restart-wait", type=float, default=4.0, help="Seconds to wait for the bridge to come back after a restart nudge")
    set_command(keepalive_ensure, "keepalive.ensure", command_keepalive_ensure)

    keepalive_watch = add_parser(keepalive_sub, "watch", common, help="Stream JSONL health snapshots forever; one line per probe cycle")
    keepalive_watch.add_argument("--interval", type=float, default=30.0, help="Seconds between probes (min 5)")
    keepalive_watch.add_argument("--notify-run", default=None, help="If set, append a keepalive_degraded event to this run id when something fails")
    set_command(keepalive_watch, "keepalive.watch", command_keepalive_watch)

    # agent-mode — declare a global policy for user-interference handling.
    # When active, the status protocol consults the policy whenever a
    # user-touch marker arrives (written by AutoTermux's AgentGestureTagger).
    agent_mode = add_parser(subparsers, "agent-mode", common, help="Declare a global policy for handling user interruptions")
    agent_mode_sub = agent_mode.add_subparsers(dest="agent_mode_command", required=True)
    am_start = add_parser(agent_mode_sub, "start", common, help="Activate agent mode")
    am_start.add_argument("--on-user-touch", choices=("log", "pause", "abort"), default="pause")
    am_start.add_argument("--on-app-switch", choices=("log", "pause", "abort"), default="log")
    set_command(am_start, "agent-mode.start", command_agent_mode_start)
    am_stop = add_parser(agent_mode_sub, "stop", common, help="Deactivate agent mode")
    set_command(am_stop, "agent-mode.stop", command_agent_mode_stop)
    am_status = add_parser(agent_mode_sub, "status", common, help="Show current agent-mode policy")
    set_command(am_status, "agent-mode.status", command_agent_mode_status)

    # daemon — long-running Python process serving over a Unix socket so
    # subsequent calls amortize Python startup. See L1 in the UX plan.
    daemon = add_parser(subparsers, "daemon", common, help="Resident worker over a Unix socket; eliminates per-call Python startup")
    daemon_sub = daemon.add_subparsers(dest="daemon_command", required=True)
    daemon_start = add_parser(daemon_sub, "start", common, help="Fork and listen on the socket")
    daemon_start.add_argument("--socket", default=None, help=f"Override socket path (default: {DEFAULT_DAEMON_SOCKET})")
    daemon_start.add_argument("--foreground", action="store_true", help="Don't fork — useful when launched from a service supervisor")
    set_command(daemon_start, "daemon.start", command_daemon_start)
    daemon_stop = add_parser(daemon_sub, "stop", common, help="Send shutdown to a running daemon")
    daemon_stop.add_argument("--socket", default=None)
    set_command(daemon_stop, "daemon.stop", command_daemon_stop)
    daemon_status = add_parser(daemon_sub, "status", common, help="Ping the daemon to check liveness")
    daemon_status.add_argument("--socket", default=None)
    set_command(daemon_status, "daemon.status", command_daemon_status)

    # batch — run a stream of subcommands in one Python process to amortize
    # the ~300ms startup cost across 20+ ops.
    batch = add_parser(subparsers, "batch", common, help="Run a JSONL script of subcommands in one Python process")
    batch.add_argument("script", nargs="?", default="-", help="Path to JSONL script ('-' or omitted = stdin)")
    batch.add_argument("--on-error", choices=("continue", "stop", "abort"), default="stop", help="Continue: log and proceed; Stop: log and exit; Abort: same as stop (alias)")
    batch.add_argument("--vars", action="append", help="KEY=VALUE expanded as {{KEY}} in args; may repeat")
    set_command(batch, "batch", command_batch)

    # exec-script — higher-level scripting on top of batch. Steps name semantic
    # actions (find_click, wait, intervene, …) instead of raw subcommands.
    exec_script = add_parser(subparsers, "exec-script", common, help="Run a YAML/JSON list of high-level steps (find_click, wait, intervene, …)")
    exec_script.add_argument("script", help="Path to YAML or JSON file ('-' for stdin)")
    exec_script.add_argument("--task", default=None, help="If set, auto-wrap the script with status start/finish using this task description")
    exec_script.add_argument("--notify", action="store_true", help="Pass --notify to the auto-status-start")
    exec_script.add_argument("--hud", action="store_true", help="Pass --hud to the auto-status-start")
    exec_script.add_argument("--on-error", choices=("stop", "continue"), default="stop")
    exec_script.add_argument("--vars", action="append", help="KEY=VALUE template substitution; may repeat")
    set_command(exec_script, "exec-script", command_exec_script)

    # hud — manual control of the status overlay (status start --hud will use
    # it automatically). Useful for diagnostics and the rare case where you
    # want HUD without the run-lifecycle commands.
    hud = add_parser(subparsers, "hud", common, help="Show, hide, or update the on-device status HUD overlay")
    hud_sub = hud.add_subparsers(dest="hud_command", required=True)
    hud_show = add_parser(hud_sub, "show", common, help="Attach the HUD overlay (idle until updated)")
    set_command(hud_show, "hud.show", command_hud_show)
    hud_hide = add_parser(hud_sub, "hide", common, help="Detach the HUD overlay")
    set_command(hud_hide, "hud.hide", command_hud_hide)
    hud_update = add_parser(hud_sub, "update", common, help="Push a state update; auto-shows the HUD")
    hud_update.add_argument("--run-id", default=None)
    hud_update.add_argument("--task", default=None)
    hud_update.add_argument("--step", type=int, default=None)
    hud_update.add_argument("--total-steps", type=int, default=None)
    hud_update.add_argument("--step-label", default=None)
    hud_update.add_argument("--percent", type=float, default=None)
    hud_update.add_argument("--state", choices=("running", "waiting", "done", "cancelled", "error", "idle"), default=None)
    hud_update.add_argument("--pending-prompt", default=None)
    set_command(hud_update, "hud.update", command_hud_update)
    hud_state = add_parser(hud_sub, "state", common, help="Read back the HUD's current state")
    set_command(hud_state, "hud.state", command_hud_state)

    # setup — first-time guided onboarding. Walks the 7 prerequisites a fresh
    # install needs and opens the right Settings page for each. See L0 in plan.
    setup = add_parser(subparsers, "setup", common, help="Guided first-time onboarding: walk the 7 prerequisites and open the right Settings pages")
    setup.add_argument("--check", action="store_true", help="Only probe; never open Settings or modify files")
    setup.add_argument("--headless", action="store_true", help="No interactive prompts (returns immediately on each step's first probe / nudge)")
    setup.add_argument("--resume", default=None, choices=SETUP_STEPS, help="Start from a specific step instead of the beginning")
    setup.add_argument("--poll-timeout", type=float, default=90.0, help="Seconds to wait for each step to flip to OK")
    setup.add_argument("--continue-on-error", action="store_true", help="Run every step even if one fails (default: stop on first failure)")
    set_command(setup, "setup", command_setup)

    version_info = add_parser(subparsers, "version", common, help="Print the AutoTermux companion version")
    set_command(version_info, "version", command_version_info)

    # Agent UX status protocol — see docs/automation-agent-ux-plan.md §6.
    # Every long-running automation should wrap with status start/step/finish
    # and route ambiguous decisions through status intervene/ask-input/confirm.
    status = add_parser(subparsers, "status", common, help="Agent run lifecycle and user-intervention protocol")
    status_sub = status.add_subparsers(dest="status_command", required=True)

    status_start = add_parser(status_sub, "start", common, help="Create a new run; emits run_id and stores it as current")
    status_start.add_argument("--task", required=True, help="Human-readable task description shown in HUD")
    status_start.add_argument("--total-steps", type=int, default=0, help="Estimated total number of steps (0 = unknown)")
    status_start.add_argument("--id", default=None, help="Optional explicit run id; defaults to a generated r_<hex>")
    status_start.add_argument("--notify", action="store_true", help="Publish (and live-update) a sticky Android notification for this run")
    status_start.add_argument("--hud", action="store_true", help="Show (and live-update) the on-device status HUD overlay for this run")
    set_command(status_start, "status.start", command_status_start)

    status_finish = add_parser(status_sub, "finish", common, help="Mark the current run as finished")
    status_finish.add_argument("--state", choices=("success", "cancelled", "error"), required=True)
    status_finish.add_argument("--summary", default=None, help="Final one-line summary surfaced in HUD")
    status_finish.add_argument("--id", default=None, help="Target run id (defaults to current/$TP_RUN_ID)")
    status_finish.add_argument("--keep-notification", action="store_true", help="On success, leave the final notification visible instead of removing it")
    set_command(status_finish, "status.finish", command_status_finish)

    status_step = add_parser(status_sub, "step", common, help="Record progress to a specific step")
    status_step.add_argument("--step", type=int, required=True)
    status_step.add_argument("--label", required=True)
    status_step.add_argument("--state", choices=("running", "done", "skipped", "failed"), default="running")
    status_step.add_argument("--detail", default=None)
    status_step.add_argument("--id", default=None)
    set_command(status_step, "status.step", command_status_step)

    status_progress = add_parser(status_sub, "progress", common, help="Fine-grained progress inside the current step")
    status_progress.add_argument("--percent", type=float, required=True)
    status_progress.add_argument("--detail", default=None)
    status_progress.add_argument("--id", default=None)
    set_command(status_progress, "status.progress", command_status_progress)

    status_intervene = add_parser(status_sub, "intervene", common, help="Block until the user picks one of the supplied choices")
    status_intervene.add_argument("--reason", required=True, help="Why the agent needs human input")
    status_intervene.add_argument("--choices", default=None, help="Comma-separated choice labels")
    status_intervene.add_argument("--wait-timeout", type=float, default=120.0, help="Seconds before returning {timeout:true}")
    status_intervene.add_argument("--tts", default=None, help="Optional text-to-speech prompt for hands-free use")
    status_intervene.add_argument("--id", default=None)
    status_intervene.add_argument("--no-dialog", action="store_true", help="Skip the on-device modal dialog channel and read response from stdin")
    set_command(status_intervene, "status.intervene", command_status_intervene)

    status_ask = add_parser(status_sub, "ask-input", common, help="Block until the user provides a free-form input")
    status_ask.add_argument("--prompt", required=True)
    status_ask.add_argument("--kind", choices=("text", "password", "number"), default="text")
    status_ask.add_argument("--wait-timeout", type=float, default=120.0)
    status_ask.add_argument("--tts", default=None)
    status_ask.add_argument("--id", default=None)
    status_ask.add_argument("--no-dialog", action="store_true")
    set_command(status_ask, "status.ask-input", command_status_ask_input)

    status_confirm = add_parser(status_sub, "confirm", common, help="Block until the user answers a yes/no question")
    status_confirm.add_argument("--prompt", required=True)
    status_confirm.add_argument("--wait-timeout", type=float, default=60.0)
    status_confirm.add_argument("--tts", default=None)
    status_confirm.add_argument("--id", default=None)
    status_confirm.add_argument("--no-dialog", action="store_true")
    set_command(status_confirm, "status.confirm", command_status_confirm)

    status_error = add_parser(status_sub, "error", common, help="Record an error against the current run")
    status_error.add_argument("--code", required=True, help="An ERROR_CODES key (see tp-android docs)")
    status_error.add_argument("--message", required=True)
    status_error.add_argument("--hint", default=None, help="Override hint (defaults to ERROR_CODES[code].hint)")
    status_error.add_argument("--recoverable", type=parse_bool, default=None, help="Override recoverability (defaults to code spec)")
    status_error.add_argument("--id", default=None)
    set_command(status_error, "status.error", command_status_error)

    status_cancel = add_parser(status_sub, "cancel", common, help="Cancel the current run (called by HUD or user)")
    status_cancel.add_argument("--id", default=None)
    status_cancel.add_argument("--source", default="cli", help="Source of cancel (cli/hud/notification)")
    set_command(status_cancel, "status.cancel", command_status_cancel)

    status_current = add_parser(status_sub, "current", common, help="Print the full run state of the current (or --id) run")
    status_current.add_argument("--id", default=None)
    set_command(status_current, "status.current", command_status_current)

    status_history = add_parser(status_sub, "history", common, help="List recent runs (newest first)")
    status_history.add_argument("--limit", type=int, default=20)
    set_command(status_history, "status.history", command_status_history)

    status_tail = add_parser(status_sub, "tail", common, help="Stream a run's event log (JSONL)")
    status_tail.add_argument("--id", default=None)
    status_tail.add_argument("--follow", action="store_true", help="Keep streaming until the run ends")
    status_tail.add_argument("--interval", type=float, default=0.5)
    set_command(status_tail, "status.tail", command_status_tail)

    # NOTE: HTTP/WebSocket server management is intentionally NOT exposed on the
    # CLI. tp-android always talks over the bridge transport. AutoTermux keeps
    # the HTTP server code internally for other consumers, but starting/stopping
    # it is not a user-facing concern.

