# Structured error codes — every CliError SHOULD attach one. The map below also
# defines the default `hint` field surfaced to callers/agents, so an agent that
# just reads {code, hint} can take a deterministic next step without parsing the
# human-language `message`. See docs/automation-agent-ux-plan.md §6.4.
ERROR_CODES: dict[str, dict[str, Any]] = {
    "CLI_ERROR":                  {"hint": "See message field; this is a generic fallback.",                                              "recoverable": False},
    "INTERRUPTED":                {"hint": "User pressed Ctrl-C.",                                                                        "recoverable": False},
