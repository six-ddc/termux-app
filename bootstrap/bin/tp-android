        payload["mime"] = args.mime
    if args.package:
        payload["package"] = args.package
    if args.component:
        payload["component"] = args.component
    if args.category:
        payload["categories"] = args.category
    extras = parse_key_values(args.extra)
    if extras:
        payload["extras"] = extras
    result = portal_post("/app/intent", args, payload)
    emit_success(args, result, command="app.intent")
    return 0


