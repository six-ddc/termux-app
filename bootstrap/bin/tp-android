def parse_notification_button_specs(values: list[str] | None, reply: bool) -> list[dict[str, Any]]:
    actions: list[dict[str, Any]] = []
    for raw_value in values or []:
        value = raw_value.strip()
        if not value:
            continue
        title, separator, action_id = value.partition(":")
        title = title.strip()
        action_id = action_id.strip() if separator else ""
        if not title:
            raise CliError(f"Invalid notification action spec: {raw_value!r}")
        if not action_id:
            action_id = re.sub(r"[^A-Za-z0-9_.:-]+", "_", title.lower()).strip("_") or title
        actions.append({"title": title, "id": action_id, "reply": reply})
    return actions


def parse_vibrate_pattern(value: str | None) -> list[int] | None:
    if not value:
        return None
    pattern: list[int] = []
    for part in value.split(","):
        item = part.strip()
        if not item:
            continue
        if not re.fullmatch(r"\d+", item):
            raise CliError("Notification --vibrate expects a comma-separated millisecond pattern, e.g. 500,1000,200")
        pattern.append(int(item))
    return pattern


def command_notification_post(args: argparse.Namespace) -> int:
    content = command_text_arg(args, "content")
    payload = {
        "id": args.id,
        "title": args.title,
        "content": content,
        "channel": args.channel,
        "tag": args.tag or "",
        "ongoing": args.ongoing,
        "autoCancel": not args.no_auto_cancel,
    }
    if args.action:
        payload["action"] = args.action
    if args.group:
        payload["group"] = args.group
    if args.priority:
        payload["priority"] = args.priority
    if args.sound:
        payload["sound"] = True
    if args.alert_once:
        payload["alertOnce"] = True
    vibrate_pattern = parse_vibrate_pattern(args.vibrate)
    if vibrate_pattern:
        payload["vibrate"] = vibrate_pattern
    actions = parse_notification_button_specs(args.button, reply=False)
    actions.extend(parse_notification_button_specs(args.reply, reply=True))
    if actions:
        payload["actions"] = actions
    result = termux_api_call(args, "notification", payload)
    emit_success(args, result, command="notification.post")
    return 0


def command_notification_remove(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {}
    if args.key:
