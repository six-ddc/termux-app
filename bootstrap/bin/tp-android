def restricted_event_types(args: argparse.Namespace, allowed: list[str]) -> list[str]:
    requested = getattr(args, "types", None) or []
    if not requested:
        return allowed
    allowed_set = {value.upper().replace("-", "_") for value in allowed}
    return [value for value in requested if value.upper().replace("-", "_") in allowed_set] or allowed


def command_notification_watch(args: argparse.Namespace) -> int:
    args.types = restricted_event_types(args, ["NOTIFICATION_POSTED", "NOTIFICATION_REMOVED", "NOTIFICATION_ACTION", "NOTIFICATION_REPLY"])
    return command_event_watch(args)


def command_notification_wait(args: argparse.Namespace) -> int:
    args.types = restricted_event_types(args, ["NOTIFICATION_POSTED", "NOTIFICATION_REMOVED", "NOTIFICATION_ACTION", "NOTIFICATION_REPLY"])
    return command_event_wait(args)


