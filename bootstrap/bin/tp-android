class CliError(Exception):
    pass


def load_config() -> dict[str, Any]:
    if not CONFIG_PATH.exists():
        return {}
    try:
        config = json.loads(CONFIG_PATH.read_text())
    except Exception as exc:
        raise CliError(f"Invalid config file {CONFIG_PATH}: {exc}") from exc
    if config.get("authority") == "com.termux.automation":
        config["authority"] = DEFAULT_AUTHORITY
    return config


def save_config(config: dict[str, Any]) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    try:
        CONFIG_PATH.chmod(0o600)
    except OSError:
        pass


def config_base_url(config: dict[str, Any]) -> str:
    return (
        config.get("_base_url_override")
        or os.environ.get("AUTOTERMUX_BASE_URL")
        or os.environ.get("TP_ANDROID_BASE_URL")
        or os.environ.get("TERMUXPLUS_ANDROID_BASE_URL")
        or config.get("base_url")
        or DEFAULT_BASE_URL
    ).rstrip("/")


def config_authority(config: dict[str, Any]) -> str:
    return (
        config.get("_authority_override")
        or os.environ.get("AUTOTERMUX_AUTHORITY")
        or os.environ.get("TP_ANDROID_AUTHORITY")
        or os.environ.get("TERMUXPLUS_ANDROID_AUTHORITY")
        or config.get("authority")
        or DEFAULT_AUTHORITY
    )


def config_android_user(config: dict[str, Any]) -> str:
    return str(
        config.get("_user_override")
        or os.environ.get("AUTOTERMUX_USER")
        or os.environ.get("TP_ANDROID_USER")
        or os.environ.get("TERMUXPLUS_ANDROID_USER")
        or config.get("user")
        or "0"
    )


def config_transport(config: dict[str, Any]) -> str:
    transport = (
        config.get("_transport_override")
        or os.environ.get("AUTOTERMUX_TRANSPORT")
        or os.environ.get("TP_ANDROID_TRANSPORT")
        or os.environ.get("TERMUXPLUS_ANDROID_TRANSPORT")
        or config.get("transport")
        or "bridge"
    )
    transport = str(transport).strip().lower()
    if transport == "http":
        # HTTP is no longer a supported CLI transport; the AutoTermux app keeps
        # the server internally but tp-android always uses bridge to keep things
        # consistent. Silently fall back instead of breaking stale configs.
        transport = "bridge"
    if transport not in {"bridge", "provider"}:
        raise CliError("transport must be 'bridge' or 'provider'")
    return transport


def configured_token(config: dict[str, Any]) -> str | None:
    return (
        config.get("_token_override")
        or os.environ.get("AUTOTERMUX_TOKEN")
        or os.environ.get("TP_ANDROID_TOKEN")
        or os.environ.get("TERMUXPLUS_ANDROID_TOKEN")
        or config.get("token")
    )


def run_system_content(args: list[str]) -> str:
    content_bin = "/system/bin/content"
    if not os.path.exists(content_bin):
        raise CliError("/system/bin/content not found; install and start AutoTermux manually")
    try:
        completed = subprocess.run(
            [content_bin, *args],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as exc:
        raise CliError(f"Could not execute {content_bin}: {exc}") from exc
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        raise CliError(detail or f"content command failed with exit {completed.returncode}")
    return completed.stdout.strip()


def run_system_am(args: list[str]) -> str:
    am_bin = "/system/bin/am"
    if not os.path.exists(am_bin):
        raise CliError("/system/bin/am not found; install and start AutoTermux manually")
    try:
        completed = subprocess.run(
            [am_bin, *args],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as exc:
        raise CliError(f"Could not execute {am_bin}: {exc}") from exc
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        raise CliError(detail or f"am command failed with exit {completed.returncode}")
    return completed.stdout.strip()


def termux_apk_path() -> str | None:
    configured = os.environ.get("TERMUX_APP__APK_PATH")
    if configured and os.path.exists(configured):
        return configured

    pm_bin = "/system/bin/pm"
    if not os.path.exists(pm_bin):
        return None
    completed = subprocess.run(
        [pm_bin, "path", "com.termux"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if completed.returncode != 0:
        return None
    for line in completed.stdout.splitlines():
        line = line.strip()
        if line.startswith("package:"):
            path = line.removeprefix("package:")
            if os.path.exists(path):
                return path
    return None


def embedded_autotermux_asset_available() -> bool:
    apk_path = termux_apk_path()
    if not apk_path:
        return False
    try:
        with zipfile.ZipFile(apk_path) as apk_zip:
            return AUTOTERMUX_ASSET_PATH in apk_zip.namelist()
    except (OSError, zipfile.BadZipFile):
        return False


def bridge_component(config: dict[str, Any]) -> str:
    return f"{config_authority(config)}/{BRIDGE_RECEIVER_CLASS}"


def parse_bridge_broadcast(output: str) -> Any:
    match = re.search(r'data="([^"]+)"', output) or re.search(r"data=([^\s,]+)", output)
    if not match:
        raise CliError(f"Could not parse bridge broadcast output: {output}")
    encoded = match.group(1)
    padded = encoded + "=" * ((4 - len(encoded) % 4) % 4)
    try:
        raw = base64.urlsafe_b64decode(padded.encode()).decode()
        parsed = json.loads(raw)
    except Exception as exc:
        raise CliError(f"Invalid bridge response: {exc}") from exc
    if isinstance(parsed, dict) and parsed.get("status") == "error":
        raise CliError(parsed.get("error") or parsed.get("message") or "Bridge command failed")
    if isinstance(parsed, dict) and "result" in parsed:
        return parsed["result"]
    return parsed


def bridge_broadcast(config: dict[str, Any], action: str, extras: list[str] | None = None) -> Any:
    output = run_system_am(
        [
            "broadcast",
            "--user",
            config_android_user(config),
            "--receiver-foreground",
            "-a",
            f"{BRIDGE_ACTION_PREFIX}.{action}",
            "-n",
            bridge_component(config),
            *(extras or []),
        ]
    )
    return parse_bridge_broadcast(output)


def parse_provider_json(output: str) -> Any:
    for line in output.splitlines():
        line = line.strip()
        if "result=" in line:
            candidate = line.split("result=", 1)[1]
        else:
            candidate = line
        if not candidate:
            continue
        try:
            parsed = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(parsed, dict) and parsed.get("status") == "success":
            result = parsed.get("result")
            if isinstance(result, str):
                try:
                    return json.loads(result)
                except json.JSONDecodeError:
                    return result
            return result
        if isinstance(parsed, dict) and parsed.get("status") == "error":
            raise CliError(parsed.get("error") or parsed.get("message") or "ContentProvider returned error")
        return parsed
    raise CliError(f"Could not parse ContentProvider output: {output}")


def active_output_format(args: argparse.Namespace | None) -> str:
    if args is None:
        return "json"
    return getattr(args, "output_format", "json")


def configure_runtime(args: argparse.Namespace) -> None:
    global CONFIG_PATH
    config_path = getattr(args, "config", None)
    if config_path:
        CONFIG_PATH = Path(config_path).expanduser()


def load_runtime_config(args: argparse.Namespace) -> dict[str, Any]:
    config = load_config()
    overrides = {
        "_base_url_override": getattr(args, "base_url", None),
        "_authority_override": getattr(args, "authority", None),
        "_user_override": getattr(args, "user", None),
        "_token_override": getattr(args, "token", None),
        "_transport_override": getattr(args, "transport", None),
    }
    for key, value in overrides.items():
        if value not in (None, ""):
            config[key] = value.rstrip("/") if key == "_base_url_override" else value
    return config


def provider_query(authority: str, path: str) -> Any:
    output = run_system_content(["query", "--uri", f"content://{authority}/{path}"])
    return parse_provider_json(output)


def parse_provider_result_uri(output: str) -> dict[str, Any]:
    match = re.search(r"content://\S+", output)
    if not match:
        return {"status": "unknown", "raw": output}
    raw_uri = match.group(0).rstrip(".,;")
    parsed_uri = urllib.parse.urlparse(raw_uri)
    query = urllib.parse.parse_qs(parsed_uri.query)
    status = query.get("status", ["unknown"])[0]
    message = query.get("message", [""])[0]
    result = {"status": status}
    if message:
        result["message"] = message
        try:
            parsed_message = json.loads(message)
        except json.JSONDecodeError:
            parsed_message = None
        if isinstance(parsed_message, dict):
            if parsed_message.get("status") == "error":
                raise CliError(parsed_message.get("error") or parsed_message.get("message") or message)
            result["response"] = parsed_message
            if "result" in parsed_message:
                result["result"] = parsed_message["result"]
    if status == "error":
        raise CliError(message or output)
    return result


def provider_insert(authority: str, path: str, binds: list[str]) -> dict[str, Any]:
    output = run_system_content(["insert", "--uri", f"content://{authority}/{path}", *binds])
    return parse_provider_result_uri(output)


def content_bind_args(payload: dict[str, Any]) -> list[str]:
    binds: list[str] = []
    for key, value in payload.items():
        if value is None:
            continue
        if isinstance(value, bool):
            value_type = "b"
            encoded = "true" if value else "false"
        elif isinstance(value, int) and not isinstance(value, bool):
            value_type = "i"
            encoded = str(value)
        elif isinstance(value, float):
            value_type = "f"
            encoded = str(value)
        elif isinstance(value, (dict, list)):
            value_type = "s"
            encoded = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        else:
            value_type = "s"
            encoded = str(value)
        binds.extend(["--bind", f"{key}:{value_type}:{encoded}"])
    return binds


def provider_action(config: dict[str, Any], action: str, payload: dict[str, Any] | None = None) -> Any:
    response = provider_insert(
        config_authority(config),
        "action/" + action.lstrip("/"),
        content_bind_args(payload or {}),
    )
    return response.get("result", response)


def bridge_call(config: dict[str, Any], method: str, payload: dict[str, Any] | None = None) -> Any:
    return bridge_broadcast(
        config,
        "CALL",
        [
            "--es",
            "method",
            method.lstrip("/"),
            "--es",
            "params_json",
            json.dumps(payload or {}, ensure_ascii=False, separators=(",", ":")),
        ],
    )


def copy_stream(input_stream: Any, output_stream: Any) -> int:
    total = 0
    while True:
        chunk = input_stream.read(1024 * 1024)
        if not chunk:
            return total
        output_stream.write(chunk)
        total += len(chunk)


def copy_transfer_cache_to_output(cache_path: str, output_path: str, args: argparse.Namespace | None = None) -> int:
    """
    Copy AutoTermux's transfer-cache file out to the user's chosen output path.

    Termux's real app context (`untrusted_app`) has MANAGE_EXTERNAL_STORAGE and
    can read `/sdcard/Download/.termuxplus/tp-android-cache/*` directly. The
    only contexts where this fails are `adb shell run-as` (which on some OEMs
    like vivo gets a stricter `runas_app` SELinux context) — but tp-android is
    intended to be run from inside Termux, not via run-as for production use.

    The `args` parameter is accepted for forward-compat with future fallbacks
    but the direct read covers all real Termux invocations.
    """
    del args  # currently unused; reserved for chunked/bridge fallbacks
    source = Path(cache_path)
    try:
        if output_path == "-":
            with source.open("rb") as input_stream:
                return copy_stream(input_stream, sys.stdout.buffer)
        output = Path(output_path)
        output.parent.mkdir(parents=True, exist_ok=True)
        with source.open("rb") as input_stream, output.open("wb") as output_stream:
            return copy_stream(input_stream, output_stream)
    except PermissionError as exc:
        raise CliError(
            f"Transfer cache file not readable: {cache_path}.\n"
            "  This usually means you are running tp-android via `adb shell run-as`,\n"
            "  which has a stricter SELinux context (runas_app) than a real Termux\n"
            "  session (untrusted_app). Run tp-android from inside the Termux app\n"
            f"  (terminal session). Original error: {exc}"
        ) from exc


def create_transfer_cache_path(input_path: str | None = None) -> Path:
    suffix = ".bin"
    if input_path and input_path != "-":
        candidate = Path(input_path).suffix
        if candidate and re.fullmatch(r"\.[A-Za-z0-9_-]{1,16}", candidate):
            suffix = candidate
    try:
        TRANSFER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise CliError(
            f"Cannot create transfer cache directory {TRANSFER_CACHE_DIR}: {exc}. "
            "Run termux-setup-storage and ensure shared storage is writable."
        ) from exc
    return TRANSFER_CACHE_DIR / f"tp-{int(time.time() * 1000)}-{uuid.uuid4()}{suffix}"


def stage_input_file_for_bridge(input_path: str) -> tuple[str, int]:
    cache_path = create_transfer_cache_path(input_path)
    try:
        if input_path == "-":
            with cache_path.open("wb") as output_stream:
                bytes_written = copy_stream(sys.stdin.buffer, output_stream)
        else:
            with Path(input_path).open("rb") as input_stream, cache_path.open("wb") as output_stream:
                bytes_written = copy_stream(input_stream, output_stream)
    except OSError as exc:
        raise CliError(f"Failed to stage input file in transfer cache: {exc}") from exc
    return str(cache_path), bytes_written


def resolve_token(config: dict[str, Any], *, allow_provider: bool = True) -> tuple[str | None, str]:
    token = configured_token(config)
    if token:
        return token, "config"
    if not allow_provider:
        return None, "missing"
    authority = config_authority(config)
    token_source = "bridge"
    try:
        token = bridge_broadcast(config, "AUTH_TOKEN")
    except CliError:
        try:
            token = provider_query(authority, "auth_token")
            token_source = "provider"
        except CliError:
            return None, "missing"
    if isinstance(token, str) and token:
        return token, token_source
    return None, "missing"


def http_request(
    config: dict[str, Any],
    method: str,
    path: str,
    *,
    token: str | None = None,
    payload: dict[str, Any] | None = None,
    timeout: float = 10.0,
) -> Any:
    base_url = config_base_url(config)
    url = base_url + path
    headers = {}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = None
    if payload is not None:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError:
            parsed = {"status": "error", "error": raw or str(exc)}
        raise CliError(parsed.get("error") or parsed.get("message") or str(exc)) from exc
    except urllib.error.URLError as exc:
        raise CliError(str(exc.reason)) from exc

    if not raw:
        return None
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        return raw
    if isinstance(parsed, dict) and parsed.get("status") == "error":
        raise CliError(parsed.get("error", "AutoTermux API returned error"))
    if isinstance(parsed, dict) and "result" in parsed:
        return parsed["result"]
    return parsed


def websocket_resource_with_token(url: str, token: str, event_format: str | None = None) -> tuple[urllib.parse.ParseResult, str]:
    parsed = urllib.parse.urlparse(url)
    query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
    if token and not any(key == "token" for key, _ in query):
        query.append(("token", token))
    if event_format and event_format != "default" and not any(key == "eventFormat" for key, _ in query):
        query.append(("eventFormat", event_format))
    encoded_query = urllib.parse.urlencode(query)
    resource = parsed.path or "/"
    if encoded_query:
        resource += f"?{encoded_query}"
    return parsed, resource


def websocket_connect(url: str, token: str, event_format: str | None, timeout: float) -> socket.socket:
    parsed, resource = websocket_resource_with_token(url, token, event_format)
    if parsed.scheme not in ("ws", "wss"):
        raise CliError("WebSocket URL must start with ws:// or wss://")
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "wss" else 80)
    raw_sock = socket.create_connection((host, port), timeout=timeout)
    sock = ssl.create_default_context().wrap_socket(raw_sock, server_hostname=host) if parsed.scheme == "wss" else raw_sock
    sock.settimeout(timeout)
    key = base64.b64encode(os.urandom(16)).decode()
    host_header = f"{host}:{port}"
    request = (
        f"GET {resource} HTTP/1.1\r\n"
        f"Host: {host_header}\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\n"
        f"Authorization: Bearer {token}\r\n"
        "\r\n"
    )
    sock.sendall(request.encode("ascii"))
    response = b""
    while b"\r\n\r\n" not in response:
        chunk = sock.recv(4096)
        if not chunk:
            break
        response += chunk
        if len(response) > 65536:
            raise CliError("WebSocket handshake response too large")
    header = response.decode("iso-8859-1", errors="replace")
    if not header.startswith("HTTP/1.1 101") and not header.startswith("HTTP/1.0 101"):
        raise CliError(f"WebSocket handshake failed: {header.splitlines()[0] if header else 'empty response'}")
    accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    if f"Sec-WebSocket-Accept: {accept}".lower() not in header.lower():
        raise CliError("WebSocket handshake failed: invalid Sec-WebSocket-Accept")
    return sock


def websocket_read_exact(sock: socket.socket, size: int) -> bytes:
    data = bytearray()
    while len(data) < size:
        chunk = sock.recv(size - len(data))
        if not chunk:
            raise CliError("WebSocket connection closed")
        data.extend(chunk)
    return bytes(data)


def websocket_read_frame(sock: socket.socket) -> tuple[int, bytes]:
    first = websocket_read_exact(sock, 2)
    opcode = first[0] & 0x0F
    masked = bool(first[1] & 0x80)
    length = first[1] & 0x7F
    if length == 126:
        length = struct.unpack("!H", websocket_read_exact(sock, 2))[0]
    elif length == 127:
        length = struct.unpack("!Q", websocket_read_exact(sock, 8))[0]
    mask = websocket_read_exact(sock, 4) if masked else b""
    payload = websocket_read_exact(sock, length) if length else b""
    if masked:
        payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
    return opcode, payload


def websocket_send_frame(sock: socket.socket, opcode: int, payload: bytes = b"") -> None:
    mask = os.urandom(4)
    first = 0x80 | (opcode & 0x0F)
    length = len(payload)
    if length < 126:
        header = struct.pack("!BB", first, 0x80 | length)
    elif length <= 0xFFFF:
        header = struct.pack("!BBH", first, 0x80 | 126, length)
    else:
        header = struct.pack("!BBQ", first, 0x80 | 127, length)
    masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
    sock.sendall(header + mask + masked)


def print_json(value: Any, *, compact: bool = False, file: Any = None) -> None:
    file = file or sys.stdout
    if compact:
        print(json.dumps(value, ensure_ascii=False, separators=(",", ":")), file=file)
    else:
        print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True), file=file)


def print_raw(value: Any) -> None:
    if value is None:
        return
    if isinstance(value, bytes):
        sys.stdout.buffer.write(value)
        return
    if isinstance(value, (dict, list)):
        print_json(value, compact=True)
        return
    print(str(value))


def emit_success(
    args: argparse.Namespace,
    result: Any = None,
    *,
    command: str | None = None,
    meta: dict[str, Any] | None = None,
) -> None:
    output_format = active_output_format(args)
    if output_format == "none":
        return
    if output_format == "raw":
        print_raw(result)
        return
    payload: dict[str, Any] = {
        "ok": True,
        "schema_version": "tp-android.v1",
        "command": command or getattr(args, "command_path", getattr(args, "command", "")),
        "result": result,
    }
    if meta:
        payload["meta"] = meta
    print_json(payload, compact=(output_format == "json"))


def emit_error(message: str, args: argparse.Namespace | None = None, *, code: str = "CLI_ERROR") -> None:
    payload = {
        "ok": False,
        "schema_version": "tp-android.v1",
        "error": {
            "code": code,
            "message": message,
        },
    }
    print_json(payload, compact=(active_output_format(args) != "pretty"), file=sys.stderr)


def redact_config(config: dict[str, Any], *, show_token: bool = False) -> dict[str, Any]:
    token = configured_token(config)
    return {
        "config": str(CONFIG_PATH),
        "transport": config_transport(config),
        "base_url": config_base_url(config),
        "authority": config_authority(config),
        "user": config_android_user(config),
        "token": token if show_token else ("present" if token else "missing"),
    }


def parse_json_value(value: str) -> Any:
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        lowered = value.lower()
        if lowered == "true":
            return True
        if lowered == "false":
            return False
        if lowered == "null":
            return None
        if re.fullmatch(r"-?\d+", value):
            return int(value)
        if re.fullmatch(r"-?\d+\.\d+", value):
            return float(value)
        return value


def parse_bool(value: str) -> bool:
    parsed = parse_json_value(value)
    if isinstance(parsed, bool):
        return parsed
    lowered = str(value).strip().lower()
    if lowered in {"1", "yes", "on", "enable", "enabled"}:
        return True
    if lowered in {"0", "no", "off", "disable", "disabled"}:
        return False
    raise argparse.ArgumentTypeError("expected boolean: true/false, 1/0, on/off, enable/disable")


def parse_json_input(value: str | None) -> dict[str, Any]:
    if not value:
        return {}
    if value == "-":
        raw = sys.stdin.read()
    elif value.startswith("@"):
        raw = Path(value[1:]).read_text()
    else:
        raw = value
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise CliError(f"Invalid JSON: {exc}") from exc
    if not isinstance(parsed, dict):
        raise CliError("JSON input must be an object")
    return parsed


def parse_key_values(values: list[str] | None) -> dict[str, Any]:
    payload: dict[str, Any] = {}
    for item in values or []:
        if "=" not in item:
            raise CliError(f"Expected KEY=VALUE, got '{item}'")
        key, value = item.split("=", 1)
        if not key:
            raise CliError(f"Expected non-empty key in '{item}'")
        payload[key] = parse_json_value(value)
    return payload


def command_text_arg(args: argparse.Namespace, attr: str = "text") -> str:
    if getattr(args, "stdin", False):
        return sys.stdin.read()
    value = getattr(args, attr, None)
    if value is None:
        raise CliError("Text is required; pass TEXT or --stdin")
    if isinstance(value, list):
        if not value:
            raise CliError("Text is required; pass TEXT or --stdin")
        return " ".join(value)
    return value


def command_configure(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    if args.base_url:
        config["base_url"] = args.base_url.rstrip("/")
    if args.authority:
        config["authority"] = args.authority
    if args.user:
        config["user"] = args.user
    if getattr(args, "transport", None):
        config["transport"] = args.transport
    if args.token:
        config["token"] = args.token
    save_config(config)
    emit_success(args, redact_config(config), command=getattr(args, "command_path", "config.set"))
    return 0


def command_config_show(args: argparse.Namespace) -> int:
    emit_success(args, redact_config(load_runtime_config(args), show_token=args.show_token))
    return 0


def command_config_set(args: argparse.Namespace) -> int:
    config = load_config()
    changed: list[str] = []
    for key in ("base_url", "authority", "user", "token", "transport"):
        value = getattr(args, key, None)
        if value not in (None, ""):
            config[key] = value.rstrip("/") if key == "base_url" else value
            changed.append(key)
    if args.token_stdin:
        config["token"] = sys.stdin.read().strip()
        changed.append("token")
    save_config(config)
    result = redact_config(config)
    result["changed"] = sorted(set(changed))
    emit_success(args, result)
    return 0


def command_config_unset(args: argparse.Namespace) -> int:
    config = load_config()
    removed: list[str] = []
    for key in args.keys:
        if key in config:
            config.pop(key, None)
            removed.append(key)
    save_config(config)
    result = redact_config(config)
    result["removed"] = removed
    emit_success(args, result)
    return 0


def command_config_path(args: argparse.Namespace) -> int:
    emit_success(args, {"path": str(CONFIG_PATH)})
    return 0


def command_install_companion(args: argparse.Namespace) -> int:
    if not args.skip_asset_check and not embedded_autotermux_asset_available():
        raise CliError(
            "This Termux build does not contain the embedded AutoTermux APK. "
            "Install a newer Termux build or pass --skip-asset-check to open the installer anyway."
        )

    config = load_config()
    output = run_system_am([
        "broadcast",
        "--user",
        config_android_user(config),
        "--receiver-foreground",
        "-a",
        AUTOTERMUX_INSTALL_ACTION,
        "-n",
        AUTOTERMUX_INSTALL_RECEIVER,
    ])
    emit_success(args, {
        "status": "started",
        "package": AUTOTERMUX_PACKAGE,
        "installer": AUTOTERMUX_INSTALL_RECEIVER,
        "output": output,
    })
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    config = load_runtime_config(args)
    transport = config_transport(config)
    result: dict[str, Any] = {
        "transport": transport,
        "authority": config_authority(config),
        "user": config_android_user(config),
        "config": str(CONFIG_PATH),
    }
    checks: list[dict[str, Any]] = []

    if transport == "provider":
        try:
            result["ping"] = provider_query(config_authority(config), "ping")
            checks.append({"name": "provider_ping", "ok": bool(result["ping"])})
        except CliError as exc:
            result["ping_error"] = str(exc)
            checks.append({"name": "provider_ping", "ok": False, "error": str(exc)})
    else:
        try:
            result["ping"] = bridge_call(config, "ping")
            checks.append({"name": "bridge_ping", "ok": bool(result["ping"])})
        except CliError as exc:
            result["ping_error"] = str(exc)
            checks.append({"name": "bridge_ping", "ok": False, "error": str(exc)})

    try:
        state = portal_get("/state_full", args)
        result["accessibility"] = "ready" if isinstance(state, dict) and "a11y_tree" in state else "unknown"
        checks.append({"name": "accessibility", "ok": result["accessibility"] == "ready"})
    except CliError as exc:
        result["accessibility"] = "not_ready"
        result["accessibility_error"] = str(exc)
        checks.append({"name": "accessibility", "ok": False, "error": str(exc)})

    result["checks"] = checks
    ok = any(check.get("name", "").endswith("_ping") and check.get("ok") for check in checks)
    emit_success(args, result, meta={"ok": ok})
    return 0 if ok else 1


def command_ping(args: argparse.Namespace) -> int:
    started = time.monotonic()
    result = portal_get("/ping", args)
    elapsed_ms = (time.monotonic() - started) * 1000.0
    emit_success(
        args,
        {
            "result": result,
            "latency_ms": round(elapsed_ms, 2),
            "transport": config_transport(load_runtime_config(args)),
        },
        command=getattr(args, "command_path", "ping"),
    )
    return 0


def command_version_info(args: argparse.Namespace) -> int:
    emit_success(args, portal_get("/version", args), command=getattr(args, "command_path", "version"))
    return 0


def portal_get(path: str, args: argparse.Namespace) -> Any:
    config = load_runtime_config(args)
    transport = config_transport(config)
    if transport == "bridge":
        clean_path = path.lstrip("/")
        parsed = urllib.parse.urlparse("/" + clean_path)
        query = urllib.parse.parse_qs(parsed.query)
        method = parsed.path.lstrip("/")
        if method == "state_full":
            return bridge_call(config, "state_full", {"filter": query.get("filter", ["true"])[0].lower() != "false"})
        if method == "state":
            return bridge_call(config, "state", {"filter": query.get("filter", ["true"])[0].lower() != "false"})
        if method == "a11y_tree_full":
            return bridge_call(config, "a11y_tree_full", {"filter": query.get("filter", ["true"])[0].lower() != "false"})
        if method == "a11y_tree":
            return bridge_call(config, "a11y_tree")
        if method == "phone_state":
            return bridge_call(config, "phone_state")
        if method == "screenshot":
            return bridge_call(config, "screenshot", {"hideOverlay": query.get("hideOverlay", ["true"])[0].lower() != "false"})
        return bridge_call(config, method)

    # transport == "provider"
    clean_path = path.lstrip("/")
    if clean_path.startswith("screenshot"):
        parsed = urllib.parse.urlparse("/" + clean_path)
        query = urllib.parse.parse_qs(parsed.query)
        hide_overlay = query.get("hideOverlay", ["true"])[0].lower() != "false"
        return provider_action(config, "screenshot", {"hideOverlay": hide_overlay})
    return provider_query(config_authority(config), clean_path)


def portal_post(path: str, args: argparse.Namespace, payload: dict[str, Any]) -> Any:
    config = load_runtime_config(args)
    transport = config_transport(config)
    if transport == "bridge":
        return bridge_call(config, path, payload)
    # transport == "provider"
    return provider_action(config, path, payload)


def command_observe(args: argparse.Namespace) -> int:
    method = "state_full" if args.full else "state"
    filter_enabled = getattr(args, "filter", not getattr(args, "no_filter", False))
    output = getattr(args, "output", None)
    payload = scoped_ui_payload(args, {"filter": filter_enabled})
    if output or getattr(args, "cache", False):
        return emit_cached_json_command(
            args,
            f"/{method}/cache",
            payload,
            output=output,
            command=getattr(args, "command_path", "ui.dump"),
            result_extra={"full": args.full, "filter": filter_enabled},
        )

    if getattr(args, "package", None):
        emit_success(args, portal_post(f"/{method}", args, payload), command=getattr(args, "command_path", "ui.dump"))
        return 0
    path = f"/{method}"
    if not filter_enabled:
        path += "?filter=false"
    emit_success(args, portal_get(path, args), command=getattr(args, "command_path", "ui.dump"))
    return 0


def emit_cached_json_command(
    args: argparse.Namespace,
    method: str,
    payload: dict[str, Any],
    *,
    output: str | None,
    command: str,
    result_extra: dict[str, Any] | None = None,
) -> int:
    result = portal_post(method, args, payload)
    if not isinstance(result, dict) or not isinstance(result.get("path"), str):
        raise CliError("Unexpected cached JSON response")
    cache_path = result["path"]
    if output:
        bytes_written = copy_transfer_cache_to_output(cache_path, output, args)
        if output == "-":
            return 0
        emitted = {
            "path": str(Path(output)),
            "bytes": bytes_written,
            "cache_path": cache_path,
            **(result_extra or {}),
        }
    else:
        emitted = {**result, **(result_extra or {})}
    emit_success(args, emitted, command=command)
    return 0


def command_ui_tree(args: argparse.Namespace) -> int:
