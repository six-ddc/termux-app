def trigger_rule_from_args(args: argparse.Namespace) -> dict[str, Any]:
    rule: dict[str, Any] = {
        "name": args.name,
        "source": normalize_trigger_source(args.source),
        "promptTemplate": args.prompt,
        "enabled": not args.disabled,
    }
    optional_values = {
        "id": getattr(args, "rule_id", None),
        "packageName": args.package,
        "titleFilter": args.title_contains,
        "textFilter": args.text_contains,
        "phoneNumberFilter": args.from_,
        "messageFilter": args.message_contains,
        "thresholdValue": args.threshold,
        "networkType": normalize_trigger_source(args.network_type) if args.network_type else None,
        "absoluteTimeMillis": args.absolute_time_ms,
        "delayMinutes": args.delay_minutes,
        "dailyHour": args.daily_hour,
        "dailyMinute": args.daily_minute,
        "maxLaunchCount": args.max_launch_count,
        "cooldownSeconds": args.cooldown_seconds,
        "notificationDebounceMs": getattr(args, "notification_debounce_ms", None),
        "commandPath": args.command,
        "stdinTemplate": args.stdin_template,
        "workingDirectory": args.workdir,
        "runner": args.runner,
        "commandLabel": args.command_label,
    }
    if args.regex:
        optional_values["stringMatchMode"] = "REGEX"
    if getattr(args, "busy_policy", None):
        optional_values["busyPolicy"] = args.busy_policy.upper()
    if args.threshold_comparison:
        optional_values["thresholdComparison"] = normalize_trigger_source(args.threshold_comparison)
    if args.arg:
        optional_values["arguments"] = args.arg
    if args.weekday:
        optional_values["weeklyDaysOfWeek"] = args.weekday
    if args.foreground:
        optional_values["background"] = False
    for key, value in optional_values.items():
        if value not in (None, "", []):
            rule[key] = value
    return rule


def command_trigger_rule_add(args: argparse.Namespace) -> int:
    rule = trigger_rule_from_args(args)
    result = trigger_call(args, "triggers/rules/save", {"rule": rule})
    emit_success(args, result, command=getattr(args, "command_path", "trigger.rule.add"))
    return 0


