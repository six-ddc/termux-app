def command_hud_update(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {}
    if args.run_id:
        payload["run_id"] = args.run_id
    if args.task:
        payload["task"] = args.task
    if args.step is not None:
        payload["step"] = args.step
    if args.total_steps is not None:
        payload["total_steps"] = args.total_steps
    if args.step_label:
        payload["step_label"] = args.step_label
    if args.percent is not None:
        payload["percent"] = args.percent
    if args.state:
        payload["state"] = args.state
    if args.pending_prompt:
        payload["pending_prompt"] = args.pending_prompt
    result = bridge_call(load_runtime_config(args), "hud/update", payload)
    emit_success(args, result, command="hud.update")
    return 0


