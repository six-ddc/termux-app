    "BRIDGE_RETURNED_ERROR":      {"hint": "AutoTermux returned a structured error; see message/details.",                                "recoverable": True},
    "COMPANION_NOT_INSTALLED":    {"hint": "AutoTermux companion APK is not installed. Run: tp-android install-companion",                "recoverable": True},
}

